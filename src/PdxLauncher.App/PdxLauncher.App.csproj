<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PdxLauncher.App</RootNamespace>
    <AssemblyName>PdxLauncher.App</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <!--
      自己写 Program.Main（见 Program.cs）：WinUI 生成的主入口无法在 Application.Start 之前
      拦命令行，而「Steam 宿主子进程」模式必须在初始化 WinUI 之前就分流退出。
    -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!--
      官方设置项控件（SettingsCard / SettingsExpander）。离线构建要求本机缓存里已有
      这 5 个包：SettingsControls → Triggers → Helpers → Extensions → Common。
      见 docs/SETTINGS-OFFICIAL-MIGRATION.md 与 docs/DEVELOPMENT.md 的「离线依赖」。
    -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PdxLauncher.Core\PdxLauncher.Core.csproj" />
    <ProjectReference Include="..\PdxLauncher.Imaging\PdxLauncher.Imaging.csproj" />
    <!--
      AI 用的独立 MCP 程序只负责构建顺序与把 exe 复制到输出目录；App 不引用它的任何类型，
      所以 ReferenceOutputAssembly=false，避免把 MCP 的依赖再复制一遍。
    -->
    <ProjectReference Include="..\PdxLauncher.Mcp\PdxLauncher.Mcp.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      Condition="'$(ManualBuild)' != 'true'" />
    <!-- 文案源 .resw → Localizer 属性/Keys 的编译期生成器（不落盘）。 -->
    <ProjectReference Include="..\PdxLauncher.Localization.Generator\PdxLauncher.Localization.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- 生成器在编译期读取这些文件；makepri 也会把 .resw 编进 .pri。 -->
  <ItemGroup>
    <AdditionalFiles Include="Strings\**\Resources.resw" />
  </ItemGroup>
  <!--
    Steam 工坊直连订阅需要 steam_api64.dll。它属于 Valve 的可再发行组件：
    本启动器不随包分发，只在构建时把工作区里已存在的那份（用户自己下载的 sdk/）
    复制到输出目录，方便本机调试。文件不存在就跳过，应用会退回「在 Steam 客户端里打开」。
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\sdk\redistributable_bin\win64\steam_api64.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\sdk\redistributable_bin\win64\steam_api64.dll"
          Link="steam_api64.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
  <!-- 手工构建路径（tools/manual-build.py）：Core 已由 csc 预编译，这里改成直接引用 dll，
       避免 MSBuild 去构建 Core 项目（其 Csc 任务在本机会被沙箱拒绝）。 -->
  <ItemGroup Condition="'$(ManualBuild)' == 'true'">
    <ProjectReference Remove="..\PdxLauncher.Core\PdxLauncher.Core.csproj" />
    <Reference Include="PdxLauncher.Core">
      <HintPath>$(ManualCoreDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    把独立 MCP 程序复制到 App 输出目录：MCP 是自包含 exe，但运行时文件（hostfxr/coreclr）
    App 目录里已经有一份，所以只带 4 个自己的文件即可；AI 客户端直接启动
    <exe 目录>\PdxLauncher.Mcp.exe。
  -->
  <Target Name="CopyMcpHost" AfterTargets="Build" Condition="'$(ManualBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\PdxLauncher.Mcp\PdxLauncher.Mcp.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_McpTargetPath" />
    </MSBuild>

    <PropertyGroup>
      <_McpTargetDir>@(_McpTargetPath->'%(RootDir)%(Directory)')</_McpTargetDir>
    </PropertyGroup>

    <ItemGroup>
      <_McpHostFile Include="@(_McpTargetPath)" Condition="Exists('@(_McpTargetPath)')" />
      <_McpHostFile Include="$(_McpTargetDir)PdxLauncher.Mcp.exe"
                    Condition="Exists('$(_McpTargetDir)PdxLauncher.Mcp.exe')" />
      <_McpHostFile Include="$(_McpTargetDir)PdxLauncher.Mcp.deps.json"
                    Condition="Exists('$(_McpTargetDir)PdxLauncher.Mcp.deps.json')" />
      <_McpHostFile Include="$(_McpTargetDir)PdxLauncher.Mcp.runtimeconfig.json"
                    Condition="Exists('$(_McpTargetDir)PdxLauncher.Mcp.runtimeconfig.json')" />
    </ItemGroup>

    <Copy SourceFiles="@(_McpHostFile)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    ============================ publish 修复 ============================
    问题：dotnet publish 的产物缺 App.xbf / MainWindow.xbf / Views\*.xbf /
    <AssemblyName>.pri / Assets\，双击 exe 立即退出（退出码 127，无窗口、无日志）。

    原因：WinUI 的 XAML 编译产物只由 Microsoft.WinUI.NET.Markup.Compiler.targets 里
    AddProcessedXamlFilesToCopyLocal 目标（BeforeTargets="GetCopyToOutputDirectoryItems"）
    复制进 $(OutDir)，而 publish 走的是 GetCopyToPublishDirectoryItems 这条完全独立的链路，
    看不到那些项；.pri 与 Assets 同理只在 build 时复制。

    修法：ComputeFilesToPublish 之后把 $(OutDir) 里这五类产物补进 ResolvedFileToPublish，
    并显式给出 RelativePath（publish 目标路径由该元数据决定）。
    注意：这里按「目录 + 通配」分成三个组，不用 %(RelativeDir) 推导——
    因为通配项没有天然的相对根，推导结果会带上 $(OutDir) 绝对路径前缀。
  -->
  <Target Name="AddWinUIXamlArtifactsToPublish"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(WindowsPackageType)' == 'None' and '$(EnableMsixTooling)' != 'true'">
    <ItemGroup>
      <!-- 根目录下的 XAML 编译产物 -->
      <_WinUIPublishRootXaml Include="$(OutDir)*.xbf" />
      <!-- Views\ 下的页面 XAML 编译产物 -->
      <_WinUIPublishViewXaml Include="$(OutDir)Views\*.xbf" />
      <_WinUIPublishControlXaml Include="$(OutDir)Controls\*.xbf" />
      <!-- 资源索引（makepri 在 build 阶段合并生成，只在 $(OutDir) 里） -->
      <_WinUIPublishPri Include="$(OutDir)$(AssemblyName).pri" />
      <!-- Assets\（含多级子目录） -->
      <_WinUIPublishAsset Include="$(OutDir)Assets\**\*.*" />
      <!-- 独立 MCP 程序（由 CopyMcpHost 在 Build 阶段放进 $(OutDir)） -->
      <_WinUIPublishMcp Include="$(OutDir)PdxLauncher.Mcp.exe"
                        Condition="Exists('$(OutDir)PdxLauncher.Mcp.exe')" />
      <_WinUIPublishMcp Include="$(OutDir)PdxLauncher.Mcp.dll"
                        Condition="Exists('$(OutDir)PdxLauncher.Mcp.dll')" />
      <_WinUIPublishMcp Include="$(OutDir)PdxLauncher.Mcp.deps.json"
                        Condition="Exists('$(OutDir)PdxLauncher.Mcp.deps.json')" />
      <_WinUIPublishMcp Include="$(OutDir)PdxLauncher.Mcp.runtimeconfig.json"
                        Condition="Exists('$(OutDir)PdxLauncher.Mcp.runtimeconfig.json')" />
    </ItemGroup>

    <ItemGroup>
      <_WinUIPublishXamlArtifact Include="@(_WinUIPublishRootXaml)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
      </_WinUIPublishXamlArtifact>
      <_WinUIPublishXamlArtifact Include="@(_WinUIPublishViewXaml)">
        <RelativePath>Views\%(Filename)%(Extension)</RelativePath>
      </_WinUIPublishXamlArtifact>
      <_WinUIPublishXamlArtifact Include="@(_WinUIPublishControlXaml)">
        <RelativePath>Controls\%(Filename)%(Extension)</RelativePath>
      </_WinUIPublishXamlArtifact>
      <_WinUIPublishXamlArtifact Include="@(_WinUIPublishPri)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
      </_WinUIPublishXamlArtifact>
      <_WinUIPublishXamlArtifact Include="@(_WinUIPublishAsset)">
        <RelativePath>Assets\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
      </_WinUIPublishXamlArtifact>
      <_WinUIPublishXamlArtifact Include="@(_WinUIPublishMcp)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
      </_WinUIPublishXamlArtifact>
    </ItemGroup>

    <ItemGroup>
      <ResolvedFileToPublish Include="@(_WinUIPublishXamlArtifact)">
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>

    <Message Importance="normal"
             Text="publish 补入 WinUI 产物: @(_WinUIPublishXamlArtifact->'%(RelativePath)', ', ')" />
  </Target>
</Project>
