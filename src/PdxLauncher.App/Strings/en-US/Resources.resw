  </data>
  <data name="SettingsTranslateEngineBuiltinTitle" xml:space="preserve">
    <value>Google free translation (no key)</value>
  </data>
  <data name="SettingsTranslateEngineCustomDesc" xml:space="preserve">
    <value>Only call the API configured below; a missing key or a failed call is a failure, with no fallback.</value>
  </data>
  <data name="SettingsTranslateEngineCustomTitle" xml:space="preserve">
    <value>Configured API only</value>
  </data>
  <data name="SettingsTranslateEngineGoogleCloudDesc" xml:space="preserve">
    <value>Calls the official Google Cloud Translation API; requires an API key. The free tier allows 500 thousand characters per month.</value>
  </data>
  <data name="SettingsTranslateEngineGoogleCloudTitle" xml:space="preserve">
    <value>Google Cloud Translation</value>
  </data>
  <data name="SettingsTranslateEngineIndexTranslateDesc" xml:space="preserve">
    <value>A small translation model that runs fully offline with the best quality and forced terminology alignment. The model is about 1.3 GB and takes roughly one second per sentence on CPU; there is no fallback to other engines.</value>
  </data>
  <data name="SettingsTranslateEngineIndexTranslateTitle" xml:space="preserve">
    <value>Index-Translate-2B only (offline, best quality)</value>
  </data>
  <data name="SettingsTranslateEngineLocalDesc" xml:space="preserve">
    <value>Prefer the on-device offline models (download them below first); when no model is installed or translation fails, fall back to the configured API, Microsoft Translator, Google Cloud Translation, MyMemory and the built-in free service.</value>
  </data>
  <data name="SettingsTranslateEngineLocalTitle" xml:space="preserve">
    <value>Local offline translation</value>
  </data>
  <data name="SettingsTranslateEngineMicrosoftDesc" xml:space="preserve">
