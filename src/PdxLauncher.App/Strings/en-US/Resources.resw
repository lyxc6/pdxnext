    <value>Microsoft Translator</value>
  </data>
  <data name="SettingsTranslateEngineMymemoryDesc" xml:space="preserve">
    <value>Calls the public MyMemory API and needs no API key. One request is limited to 500 characters, so long text is split automatically. Usually still reachable on networks where the Google endpoint fails.</value>
