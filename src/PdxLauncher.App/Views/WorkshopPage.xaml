<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdxLauncher.App.Views.WorkshopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:PdxLauncher.App.Services"
    xmlns:vm="using:PdxLauncher.App.ViewModels"
    NavigationCacheMode="Required"
    Background="{ThemeResource PdxPageVeilBrush}">

    <!--
        创意工坊页：一个游戏只对应一个来源 ——
        有 Steam 创意工坊的游戏显示 Steam 工坊，没有的（CS2 / 独立版）显示 Paradox Mods。
        页面不提供来源切换页签：来源由 WorkshopViewModel 按当前游戏判定。
    -->
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 行0：标题 / 游戏名 / 计数 / 来源徽标 / 打开网页 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind L.WorkshopTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.GameTitle, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.GameTitle), Mode=OneWay}" />
                    <TextBlock x:Name="txtWorkshopCount"
                               Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.CountText), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Padding="8,3"
                        CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <TextBlock x:Name="txtWorkshopSource"
                               Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="txtWorkshopSource" />
                </Border>
                <Button x:Name="btnWorkshopOpenWeb"
                        Click="OnOpenWebClick"
                        AutomationProperties.AutomationId="btnWorkshopOpenWeb"
                        AutomationProperties.Name="{x:Bind L.WorkshopOpenBrowserName, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind L.WorkshopOpenBrowserName, Mode=OneWay}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 行1：搜索 / 排序 / 时间范围 / 忙碌 / 刷新 -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="SearchBox"
                     MinWidth="160"
                     MaxWidth="360"
                     HorizontalAlignment="Left"
                     PlaceholderText="{x:Bind L.WorkshopSearchPlaceholder, Mode=OneWay}"
                     Text="{x:Bind ViewModel.SearchText, Mode=OneWay}"
                     TextChanged="OnSearchTextChanged"
                     AutomationProperties.AutomationId="txtWorkshopSearch"
                     AutomationProperties.Name="{x:Bind L.WorkshopSearchName, Mode=OneWay}" />

            <ComboBox Grid.Column="1"
                      x:Name="SortBox"
                      MinWidth="150"
                      VerticalAlignment="Center"
                      ItemsSource="{x:Bind ViewModel.SortModes, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedSortMode, Mode=OneWay}"
                      SelectionChanged="OnSortSelectionChanged"
                      AutomationProperties.AutomationId="cmbWorkshopSort"
                      AutomationProperties.Name="{x:Bind L.WorkshopSortName, Mode=OneWay}" />

            <ComboBox Grid.Column="2"
                      x:Name="TimeRangeBox"
                      MinWidth="130"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowTimeRange), Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.TimeRangeModes, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedTimeRange, Mode=OneWay}"
                      SelectionChanged="OnTimeRangeSelectionChanged"
                      AutomationProperties.AutomationId="cmbWorkshopTimeRange"
                      AutomationProperties.Name="{x:Bind L.WorkshopTimeRangeName, Mode=OneWay}" />

            <ProgressRing Grid.Column="3"
                          Width="20"
                          Height="20"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          AutomationProperties.AutomationId="ringWorkshopBusy" />

            <Button Grid.Column="4"
                    Click="OnRefreshClick"
                    AutomationProperties.AutomationId="btnWorkshopRefresh"
                    AutomationProperties.Name="{x:Bind L.WorkshopRefreshName, Mode=OneWay}">
                <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>
        </Grid>

        <!-- 行2：PDX 来源未登录时的提示条 -->
        <Border Grid.Row="2"
                Padding="10,6"
                CornerRadius="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowSignInHint), Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Bind L.WorkshopSignInHint, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="txtWorkshopSignInHint" />
                <Button Grid.Column="1"
                        Content="{x:Bind L.WorkshopSignInAction, Mode=OneWay}"
                        Click="OnSignInClick"
                        AutomationProperties.AutomationId="btnWorkshopSignIn" />
            </Grid>
        </Border>

        <!-- 行3：列表 / 空状态 -->
        <Grid Grid.Row="3">
            <Border Background="{ThemeResource PdxCardGlassBrush}" CornerRadius="8" />

            <!-- 翻页/查询中的细进度条：不遮挡列表，只在忙碌时出现 -->
            <ProgressBar x:Name="barWorkshopLoading"
                         Height="3"
                         VerticalAlignment="Top"
                         IsIndeterminate="True"
                         Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsBusy), Mode=OneWay}"
                         AutomationProperties.AutomationId="barWorkshopLoading" />

            <ListView x:Name="WorkshopList"
                      ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick"
                      AutomationProperties.AutomationId="lstWorkshop"
                      AutomationProperties.Name="{x:Bind L.WorkshopListName, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkshopRowViewModel">
                        <Grid ColumnSpacing="10"
                              Padding="4,6"
                              AutomationProperties.AutomationId="{x:Bind RowAutomationId, Mode=OneTime}"
                              AutomationProperties.Name="{x:Bind Name, Mode=OneTime}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="{x:Bind ThumbnailSize, Mode=OneTime}"
                                    Height="{x:Bind ThumbnailSize, Mode=OneTime}"
                                    CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Image Source="{x:Bind svc:XamlImage.FromPath(CoverPath), Mode=OneWay}"
                                           Stretch="Uniform"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(HasCover), Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE8B9;"
                                              FontSize="20"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(HasCover), Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SubtitleText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind svc:XamlVisibility.FromString(SubtitleText), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind SizeText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind svc:XamlVisibility.FromString(SizeText), Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Width="32"
                                        Height="32"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnOpenSteamClick"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(CanOpenSteam), Mode=OneWay}"
                                        AutomationProperties.AutomationId="{x:Bind OpenSteamAutomationId, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind L.WorkshopOpenSteamName, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind L.WorkshopOpenSteamName, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="16" />
                                </Button>
                                <Button Width="32"
                                        Height="32"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnOpenBrowserClick"
                                        AutomationProperties.AutomationId="{x:Bind OpenBrowserAutomationId, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind L.WorkshopOpenBrowserName, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind L.WorkshopOpenBrowserName, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowNoGameHint), Mode=OneWay}">
                <TextBlock Text="{x:Bind L.WorkshopNoGameHint, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="txtWorkshopNoGame" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowEmptyState), Mode=OneWay}">
                <TextBlock Text="{x:Bind L.WorkshopEmptyHint, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="txtWorkshopEmpty" />
            </StackPanel>
        </Grid>

        <!-- 行4：分页 / 状态栏 -->
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="OnPrevClick"
                    IsEnabled="{x:Bind ViewModel.HasPrevPage, Mode=OneWay}"
                    AutomationProperties.AutomationId="btnWorkshopPrevPage"
                    AutomationProperties.Name="{x:Bind L.WorkshopPrev, Mode=OneWay}">
                <FontIcon Glyph="&#xE76B;" FontSize="16" />
            </Button>

            <TextBlock Grid.Column="1"
                       x:Name="txtWorkshopPage"
                       Text="{x:Bind ViewModel.PageText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.PageText), Mode=OneWay}"
                       AutomationProperties.AutomationId="txtWorkshopPage" />

            <Button Grid.Column="2"
                    Click="OnNextClick"
                    IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                    AutomationProperties.AutomationId="btnWorkshopNextPage"
                    AutomationProperties.Name="{x:Bind L.WorkshopNext, Mode=OneWay}">
                <FontIcon Glyph="&#xE76C;" FontSize="16" />
            </Button>

            <Border Grid.Column="3"
                    Padding="10,6"
                    CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="txtWorkshopStatus" />

                    <TextBlock Grid.Column="1"
                               x:Name="txtWorkshopCoverProgress"
                               Text="{x:Bind ViewModel.CoverProgressText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowCoverProgress), Mode=OneWay}"
                               AutomationProperties.AutomationId="txtWorkshopCoverProgress" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
