<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdxLauncher.App.Views.WorkshopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:PdxLauncher.App.Services"
    xmlns:vm="using:PdxLauncher.App.ViewModels"
    xmlns:controls="using:PdxLauncher.App.Controls"
    NavigationCacheMode="Required"
    Background="{ThemeResource PdxPageVeilBrush}"
    AutomationProperties.Name="{x:Bind L.WorkshopTitle, Mode=OneWay}">

    <!--
        创意工坊页：一个游戏只对应一个来源 ——
        有 Steam 创意工坊的游戏显示 Steam 工坊，没有的（CS2 / 独立版）显示 Paradox Mods。
        页面不提供来源切换页签：来源由 WorkshopViewModel 按当前游戏判定。
        页头只有一行工具条：页面标题交给左侧导航栏，游戏名与结果数放在下方状态栏。
    -->
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 行0：唯一一行工具条 —— 搜索 / 排序 / 时间范围 / 忙碌 / 刷新 | 来源徽标 / 打开网页 -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 搜索框只在回车（或放大镜/右侧刷新按钮）时提交：打字过程中不发请求。
                 下拉里给的是最近提交过的词，选一条等于把它再提交一次，统一走 QuerySubmitted。 -->
            <AutoSuggestBox Grid.Column="0"
                            x:Name="SearchBox"
                            MinWidth="160"
                            HorizontalAlignment="Stretch"
                            QueryIcon="Find"
                            PlaceholderText="{x:Bind L.WorkshopSearchPlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.SearchText, Mode=OneWay}"
                            TextChanged="OnSearchTextChanged"
                            QuerySubmitted="OnSearchQuerySubmitted"
                            AutomationProperties.AutomationId="txtWorkshopSearch"
                            AutomationProperties.Name="{x:Bind L.WorkshopSearchName, Mode=OneWay}" />

            <controls:PdxDropDown Grid.Column="1"
                                 x:Name="SortBox"
                                 MinWidth="150"
                                 MaxWidth="220"
                                 VerticalAlignment="Center"
                                 ItemsSource="{x:Bind ViewModel.SortModes, Mode=OneWay}"
                                 SelectedItem="{x:Bind ViewModel.SelectedSortMode, Mode=OneWay}"
                                 SelectionChanged="OnSortSelectionChanged"
                                 AutomationProperties.AutomationId="cmbWorkshopSort"
                                 AutomationProperties.Name="{x:Bind L.WorkshopSortName, Mode=OneWay}" />

            <controls:PdxDropDown Grid.Column="2"
                                 x:Name="TimeRangeBox"
                                 MinWidth="130"
                                 MaxWidth="170"
                                 VerticalAlignment="Center"
                                 Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowTimeRange), Mode=OneWay}"
                                 ItemsSource="{x:Bind ViewModel.TimeRangeModes, Mode=OneWay}"
                                 SelectedItem="{x:Bind ViewModel.SelectedTimeRange, Mode=OneWay}"
                                 SelectionChanged="OnTimeRangeSelectionChanged"
                                 AutomationProperties.AutomationId="cmbWorkshopTimeRange"
                                 AutomationProperties.Name="{x:Bind L.WorkshopTimeRangeName, Mode=OneWay}" />

            <ProgressRing Grid.Column="3"
                          Width="20"
                          Height="20"
                          VerticalAlignment="Center"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          AutomationProperties.AutomationId="ringWorkshopBusy" />

            <Button Grid.Column="4"
                    VerticalAlignment="Center"
                    Click="OnRefreshClick"
                    AutomationProperties.AutomationId="btnWorkshopRefresh"
                    AutomationProperties.Name="{x:Bind L.WorkshopRefreshName, Mode=OneWay}">
                <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>

            <Border Grid.Column="5"
                    Width="1"
                    Height="20"
                    Margin="0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Border Grid.Column="6"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <TextBlock x:Name="txtWorkshopSource"
                           Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           AutomationProperties.AutomationId="txtWorkshopSource" />
            </Border>

            <Button Grid.Column="7"
                    VerticalAlignment="Center"
                    Click="OnOpenWebClick"
                    AutomationProperties.AutomationId="btnWorkshopOpenWeb"
                    AutomationProperties.Name="{x:Bind L.WorkshopOpenBrowserName, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind L.WorkshopOpenBrowserName, Mode=OneWay}">
                <FontIcon Glyph="&#xE8A7;" FontSize="16" />
            </Button>

            <!-- 筛选栏开关：只有 Steam 来源有筛选维度。 -->
            <ToggleButton Grid.Column="8"
                          VerticalAlignment="Center"
                          IsChecked="{x:Bind ViewModel.ShowFilterPanel, Mode=TwoWay}"
                          Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.CanShowFilters), Mode=OneWay}"
                          AutomationProperties.AutomationId="btnWorkshopFilter"
                          AutomationProperties.Name="{x:Bind L.WorkshopFilterToggle, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind L.WorkshopFilterToggle, Mode=OneWay}">
                <FontIcon Glyph="&#xE71C;" FontSize="16" />
            </ToggleButton>
        </Grid>

        <!-- 行1：PDX 来源未登录时的提示条 -->
        <Border Grid.Row="1"
                Padding="12,8"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowSignInHint), Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Bind L.WorkshopSignInHint, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="txtWorkshopSignInHint" />
                <Button Grid.Column="1"
                        Content="{x:Bind L.WorkshopSignInAction, Mode=OneWay}"
                        Click="OnSignInClick"
                        AutomationProperties.AutomationId="btnWorkshopSignIn" />
            </Grid>
        </Border>

        <!-- 行2：筛选栏 + 列表 / 空状态 -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Steam 风格的左侧筛选栏：分组来自列表页 SSR，解析不到时用内置目录兜底。
                 每个标签是一个三态胶囊（未选 → 包含 → 排除 → 未选），点击后由视图模型去抖再查。 -->
            <Border Grid.Column="0"
                    Width="264"
                    CornerRadius="8"
                    Background="{ThemeResource PdxCardGlassBrush}"
                    Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowFilterSidebar), Mode=OneWay}"
                    AutomationProperties.AutomationId="pnlWorkshopFilters">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled">
                    <StackPanel Padding="12" Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind L.WorkshopFilterTitle, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="{x:Bind L.WorkshopFilterClear, Mode=OneWay}"
                                    Click="OnClearFiltersClick"
                                    AutomationProperties.AutomationId="btnWorkshopFilterClear" />
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind L.WorkshopFilterSpecialTitle, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <controls:PdxDropDown x:Name="SpecialFilterBox"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.Filters.SpecialFilterModes, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.Filters.CurrentSpecialFilterLabel, Mode=OneWay}"
                                                  SelectionChanged="OnSpecialFilterSelectionChanged"
                                                  AutomationProperties.AutomationId="cmbWorkshopSpecialFilter" />
                        </StackPanel>

                        <!-- 分组可折叠：类别默认展开，其余默认收起，避免几十项一次铺满整栏。
                             标题用普通 Button（和胶囊同一类控件），点击由页面切换 IsExpanded；
                             每一项是一个三态胶囊（未选 / 包含 / 排除），点击按顺序轮换。 -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Filters.Groups, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkshopFilterGroupViewModel">
                                    <StackPanel Margin="0,4,0,0">
                                        <Button HorizontalAlignment="Stretch"
                                                Padding="8,4"
                                                CornerRadius="8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="OnFilterGroupHeaderClick"
                                                AutomationProperties.Name="{x:Bind HeaderText, Mode=OneWay}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <!-- 折叠时也能看出这组选了几项。 -->
                                                <Border Grid.Column="1"
                                                        MinWidth="20"
                                                        Padding="8,0"
                                                        CornerRadius="8"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(HasActive), Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind ActiveCountText, Mode=OneWay}"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <FontIcon Grid.Column="2"
                                                          Glyph="{x:Bind HeaderGlyph, Mode=OneWay}"
                                                          FontSize="12"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <StackPanel Spacing="8"
                                                    Padding="0,4,0,0"
                                                    Visibility="{x:Bind svc:XamlVisibility.FromBool(IsExpanded), Mode=OneWay}">
                                            <!-- 只有 DLC 组显示名称过滤：它通常有 20 项以上。 -->
                                            <TextBox Text="{x:Bind NameFilterText, Mode=TwoWay}"
                                                     PlaceholderText="{x:Bind L.WorkshopFilterDlcSearch, Mode=OneWay}"
                                                     Visibility="{x:Bind svc:XamlVisibility.FromBool(ShowNameFilter), Mode=OneWay}"
                                                     AutomationProperties.AutomationId="txtWorkshopDlcFilter" />
                                            <TextBlock Text="{x:Bind L.WorkshopFilterDlcEmpty, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind svc:XamlVisibility.FromBool(ShowDlcEmptyHint), Mode=OneWay}" />

                                            <ItemsControl ItemsSource="{x:Bind VisibleOptions, Mode=OneWay}"
                                                          AutomationProperties.AutomationId="lstWorkshopFilterOptions">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <!-- WinUI 没有 WrapPanel；PdxWrapPanel 按宽度自动换行。 -->
                                                        <controls:PdxWrapPanel Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:WorkshopTagOption">
                                                        <controls:PdxTagChip Text="{x:Bind DisplayName, Mode=OneWay}"
                                                                             IsRequired="{x:Bind IsRequired, Mode=OneWay}"
                                                                             IsExcluded="{x:Bind IsExcluded, Mode=OneWay}"
                                                                             Margin="0,0,0,4"
                                                                             AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                                                             AutomationProperties.HelpText="{x:Bind L.WorkshopFilterCycleHint, Mode=OneWay}"
                                                                             ToolTipService.ToolTip="{x:Bind L.WorkshopFilterCycleHint, Mode=OneWay}"
                                                                             Click="OnTagChipClick"
                                                                             ToggleRequested="OnTagChipClick" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox Content="{x:Bind L.WorkshopFilterShowIncompatible, Mode=OneWay}"
                                  IsChecked="{x:Bind ViewModel.Filters.ShowIncompatible, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="chkWorkshopShowIncompatible" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Border Background="{ThemeResource PdxCardGlassBrush}" CornerRadius="8" />

            <!-- 翻页/查询中的细进度条：不遮挡列表，只在忙碌时出现 -->
            <ProgressBar x:Name="barWorkshopLoading"
                         Height="3"
                         VerticalAlignment="Top"
                         IsIndeterminate="True"
                         Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsBusy), Mode=OneWay}"
                         AutomationProperties.AutomationId="barWorkshopLoading" />

            <ListView x:Name="WorkshopList"
                      ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick"
                      AutomationProperties.AutomationId="lstWorkshop"
                      AutomationProperties.Name="{x:Bind L.WorkshopListName, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkshopRowViewModel">
                        <Grid ColumnSpacing="8"
                              Padding="4,8"
                              AutomationProperties.AutomationId="{x:Bind RowAutomationId, Mode=OneTime}"
                              AutomationProperties.Name="{x:Bind Name, Mode=OneTime}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="{x:Bind ThumbnailSize, Mode=OneTime}"
                                    Height="{x:Bind ThumbnailSize, Mode=OneTime}"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Image Source="{x:Bind svc:XamlImage.FromPath(CoverPath, 72), Mode=OneWay}"
                                           Stretch="Uniform"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(HasCover), Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE8B9;"
                                              FontSize="20"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(HasCover), Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- 译文：与原文并存，只显示译文正文（不加「译文」标题），翻译没开或失败时整块隐藏。 -->
                                <Border Margin="0,8,0,0"
                                        Padding="8,4"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Visibility="{x:Bind svc:XamlVisibility.FromString(TranslatedName), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind TranslatedName, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <TextBlock Text="{x:Bind SubtitleText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind svc:XamlVisibility.FromString(SubtitleText), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind SizeText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind svc:XamlVisibility.FromString(SizeText), Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Width="32"
                                        Height="32"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnOpenSteamClick"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(CanOpenSteam), Mode=OneWay}"
                                        AutomationProperties.AutomationId="{x:Bind OpenSteamAutomationId, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind L.WorkshopOpenSteamName, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind L.WorkshopOpenSteamName, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="16" />
                                </Button>
                                <Button Width="32"
                                        Height="32"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnOpenBrowserClick"
                                        AutomationProperties.AutomationId="{x:Bind OpenBrowserAutomationId, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind L.WorkshopOpenBrowserName, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind L.WorkshopOpenBrowserName, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowNoGameHint), Mode=OneWay}">
                <TextBlock Text="{x:Bind L.WorkshopNoGameHint, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="txtWorkshopNoGame" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowEmptyState), Mode=OneWay}">
                <TextBlock Text="{x:Bind L.WorkshopEmptyHint, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="txtWorkshopEmpty" />
            </StackPanel>
            </Grid>
        </Grid>

        <!-- 行3：分页 / 状态栏 -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock Text="{x:Bind L.WorkshopPageSize, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <controls:PdxDropDown x:Name="PageSizeBox"
                                      MinWidth="72"
                                      ItemsSource="{x:Bind ViewModel.PageSizeOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPageSize, Mode=OneWay}"
                                      SelectionChanged="OnPageSizeSelectionChanged"
                                      AutomationProperties.AutomationId="cmbWorkshopPageSize"
                                      AutomationProperties.Name="{x:Bind L.WorkshopPageSize, Mode=OneWay}" />

                <Button Click="OnPrevClick"
                        IsEnabled="{x:Bind ViewModel.HasPrevPage, Mode=OneWay}"
                        AutomationProperties.AutomationId="btnWorkshopPrevPage"
                        AutomationProperties.Name="{x:Bind L.WorkshopPrev, Mode=OneWay}">
                    <FontIcon Glyph="&#xE76B;" FontSize="16" />
                </Button>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.PageButtons, Mode=OneWay}"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="lstWorkshopPageNumbers">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkshopPageButton">
                            <Grid>
                                <Button MinWidth="32"
                                        Height="32"
                                        Padding="0"
                                        Content="{x:Bind Label}"
                                        Tag="{x:Bind PageIndex}"
                                        Click="OnPageNumberClick"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ShowAsButton), Mode=OneTime}"
                                        AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind Label, Mode=OneTime}" />
                                <Button MinWidth="32"
                                        Height="32"
                                        Padding="0"
                                        Content="{x:Bind Label}"
                                        Tag="{x:Bind PageIndex}"
                                        Click="OnPageNumberClick"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ShowAsCurrentButton), Mode=OneTime}"
                                        AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind Label, Mode=OneTime}" />
                                <TextBlock Text="{x:Bind Label}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           Margin="4,0"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ShowAsEllipsis), Mode=OneTime}"
                                           AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Button Click="OnNextClick"
                        IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                        AutomationProperties.AutomationId="btnWorkshopNextPage"
                        AutomationProperties.Name="{x:Bind L.WorkshopNext, Mode=OneWay}">
                    <FontIcon Glyph="&#xE76C;" FontSize="16" />
                </Button>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="12,8"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 页头原来的「游戏名 + 结果数」搬到这里：页面标题已经在导航栏上，页内不再重复一行。 -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="txtWorkshopGame"
                                   Text="{x:Bind ViewModel.GameTitle, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.GameTitle), Mode=OneWay}"
                                   AutomationProperties.AutomationId="txtWorkshopGame" />
                        <TextBlock x:Name="txtWorkshopCount"
                                   Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.CountText), Mode=OneWay}"
                                   AutomationProperties.AutomationId="txtWorkshopCount" />
                        <TextBlock x:Name="txtWorkshopPage"
                                   Text="{x:Bind ViewModel.PageText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.PageText), Mode=OneWay}"
                                   AutomationProperties.AutomationId="txtWorkshopPage" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="txtWorkshopStatus" />

                    <TextBlock Grid.Column="2"
                               x:Name="txtWorkshopCoverProgress"
                               Text="{x:Bind ViewModel.CoverProgressText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
