<Page
    x:Class="PdxLauncher.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:PdxLauncher.Core.Contracts"
    xmlns:controls="using:PdxLauncher.App.Controls"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:svc="using:PdxLauncher.App.Services"
    xmlns:vm="using:PdxLauncher.App.ViewModels"
    NavigationCacheMode="Required"
    Background="{ThemeResource PdxPageVeilBrush}">

    <Page.Resources>
        <!-- 小标题下方/卡片下方的说明文字，统一走这一个样式（原来是 4 行内联属性 × 8 处）。 -->
        <Style x:Key="SettingsHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4,0,4,8" />
        </Style>
        <!-- 节标题：与 Learn「Guidelines for app settings」一致，正文加粗一级（BodyStrong）。 -->
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- 节内小标题：同为 BodyStrong，但用次级前景色压一级，不与节标题同级。 -->
        <Style x:Key="SettingsSubsectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </Page.Resources>

    <Grid Padding="20" RowSpacing="12" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            左侧分节导航用官方 NavigationView（与主窗口左栏同一控件、同 216 宽）：
            选中指示条左侧按规范留的是「图标位」，条目带 SymbolIcon 后条与文字之间
            自然隔开；改用纯文字 ListView 时文字会顶到指示条旁。
        -->
        <NavigationView Grid.Row="0"
                        Grid.Column="0"
                        x:Name="navSettingsSections"
                        AutomationProperties.AutomationId="lstSettingsSections"
                        AutomationProperties.Name="{x:Bind L.SettingsSectionName, Mode=OneWay}"
                        Background="Transparent"
                        PaneDisplayMode="Left"
                        OpenPaneLength="216"
                        IsPaneOpen="True"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="OnSectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel Spacing="4" Margin="0,4,0,0">
                    <TextBlock Text="{x:Bind L.SettingsTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.GameTitle, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsAppearance"
                                    Tag="0"
                                    Content="{x:Bind L.SettingsNavAppearance, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Font" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsLaunch"
                                    Tag="1"
                                    Content="{x:Bind L.SettingsNavLaunch, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsPaths"
                                    Tag="2"
                                    Content="{x:Bind L.SettingsNavPaths, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsOnline"
                                    Tag="3"
                                    Content="{x:Bind L.SettingsNavOnline, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Globe" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsCache"
                                    Tag="4"
                                    Content="{x:Bind L.SettingsNavCache, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Save" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsAdvanced"
                                    Tag="5"
                                    Content="{x:Bind L.SettingsNavAdvanced, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsTranslation"
                                    Tag="6"
                                    Content="{x:Bind L.SettingsNavTranslation, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="World" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsAbout"
                                    Tag="7"
                                    Content="{x:Bind L.SettingsNavAbout, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>

        <ScrollViewer Grid.Row="0"
                      Grid.Column="1"
                      x:Name="settingsScroller"
                      SizeChanged="OnSettingsScrollerSizeChanged"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          HorizontalContentAlignment="Stretch">
                <!--
                    右侧 16 DIP 是滚动条通道：WinUI 3 的 Fluent 滚动条是浮层，
                    贴在 ScrollViewer 右边缘绘制、不占内容宽度。内容若一路撑到边缘，
                    轨道和滑块就会压在卡片的 1 px 描边与 8 px 圆角上（详见 docs/SETTINGS-REWORK.md）。
                -->
                <!--
                    内容列在窗口足够宽时固定 1040 并居中；窄窗口按可用宽度收缩，避免被裁掉。
                    宽度必须由代码按 ScrollViewer.ViewportWidth 算：SettingsCard 的 DesiredSize
                    按内容算，只写 MaxWidth + Center 会让整列缩成最宽一张卡（实测 704.7 DIP），
                    只写 Stretch 则 MaxWidth 变成实际宽度但仍右贴（实测 958 DIP）。
                    左右各留 16 DIP：右侧是滚动条通道，左侧对称保证卡片真正居中。
                -->
                <Grid x:Name="settingsContentGrid"
                      MaxWidth="1040"
                      HorizontalAlignment="Center"
                      Margin="16,0,16,0">
                    <StackPanel x:Name="settingsContentColumn"
                                AutomationProperties.AutomationId="settingsContentColumn"
                                Spacing="24">

                    <StackPanel x:Name="secAppearance" Spacing="8"
                                x:Load="{x:Bind IsAppearanceSection, Mode=OneWay}"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(IsAppearanceSection), Mode=OneWay}">
                        <TextBlock Text="{x:Bind L.SettingsSectionTheme, Mode=OneWay}" Style="{StaticResource SettingsSectionTitleStyle}" />

                        <ct:SettingsCard Header="{x:Bind L.SettingsThemeSource, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         AutomationProperties.AutomationId="cardThemeSource"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <TextBlock Text="{x:Bind ViewModel.ThemeSourceText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="txtThemeSource"
                                       AutomationProperties.Name="{x:Bind L.SettingsThemeSource, Mode=OneWay}"
                                       MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsThemeLastCheck, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <TextBlock Text="{x:Bind ViewModel.LastCheckText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="txtThemeLastCheck"
                                       AutomationProperties.Name="{x:Bind L.SettingsThemeLastCheck, Mode=OneWay}"
                                       MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsThemeNextCheck, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <TextBlock Text="{x:Bind ViewModel.NextCheckText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="txtThemeNextCheck"
                                       AutomationProperties.Name="{x:Bind L.SettingsThemeNextCheck, Mode=OneWay}"
                                       MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsThemeBackgroundFile, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <TextBlock Text="{x:Bind ViewModel.BackgroundFileText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="txtThemeBackgroundFile"
                                       AutomationProperties.Name="{x:Bind L.SettingsThemeBackgroundFile, Mode=OneWay}"
                                       MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </ct:SettingsCard>

                        <TextBlock Text="{x:Bind L.SettingsSectionThemeCheck, Mode=OneWay}" Style="{StaticResource SettingsSubsectionTitleStyle}" />

                        <ct:SettingsCard Header="{x:Bind L.SettingsThemeLastFailure, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <TextBlock Text="{x:Bind ViewModel.LastFailureText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="txtThemeLastFailure"
                                       AutomationProperties.Name="{x:Bind L.SettingsThemeLastFailure, Mode=OneWay}"
                                       MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsThemeOnlineOn, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressRing AutomationProperties.AutomationId="ringSettingsBusy"
                                              Width="20" Height="20"
                                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsBusy), Mode=OneWay}" />
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglOnlineThemeRefresh"
                                              AutomationProperties.Name="{x:Bind L.SettingsThemeOnlineOn, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.OnlineRefreshEnabled, Mode=TwoWay}" />
                                <Button AutomationProperties.AutomationId="btnCheckThemeNow"
                                        AutomationProperties.Name="{x:Bind L.SettingsThemeCheckNow, Mode=OneWay}"
                                        Content="{x:Bind L.SettingsThemeCheckNow, Mode=OneWay}"
                                        Click="OnCheckThemeClick"
                                        IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}" />
                            </StackPanel>
                        </ct:SettingsCard>

                        <TextBlock Text="{x:Bind L.SettingsThemeHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />

                        <TextBlock Text="{x:Bind L.SettingsSectionInterface, Mode=OneWay}" Style="{StaticResource SettingsSubsectionTitleStyle}" />

                        <ct:SettingsCard Header="{x:Bind L.SettingsInterfaceLanguage, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <controls:PdxDropDown AutomationProperties.AutomationId="cmbUiLanguage"
                                      AutomationProperties.Name="{x:Bind L.SettingsInterfaceLanguageName, Mode=OneWay}"
                                      Width="320" MinHeight="32"
                                      ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}"
                                      DisplayMemberPath="Title"
                                      SelectedItem="{x:Bind ViewModel.SelectedUiLanguage, Mode=TwoWay}"
                                      ToolTipService.ToolTip="{x:Bind ViewModel.SelectedUiLanguage.Description, Mode=OneWay}" />
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsInterfacePlaySetMode, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <controls:PdxDropDown AutomationProperties.AutomationId="cmbPlaySetPageDisplayMode"
                                      AutomationProperties.Name="{x:Bind L.SettingsInterfacePlaySetModeName, Mode=OneWay}"
                                      Width="320" MinHeight="32"
                                      ItemsSource="{x:Bind ViewModel.PlaySetDisplayModes, Mode=OneWay}"
                                      DisplayMemberPath="Title"
                                      SelectedItem="{x:Bind ViewModel.SelectedPlaySetDisplayMode, Mode=TwoWay}"
                                      ToolTipService.ToolTip="{x:Bind ViewModel.SelectedPlaySetDisplayMode.Description, Mode=OneWay}" />
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsInterfaceBackgroundMode, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <controls:PdxDropDown AutomationProperties.AutomationId="cmbBackgroundDisplayMode"
                                      AutomationProperties.Name="{x:Bind L.SettingsInterfaceBackgroundModeName, Mode=OneWay}"
                                      Width="320" MinHeight="32"
                                      ItemsSource="{x:Bind ViewModel.BackgroundDisplayModeOptions, Mode=OneWay}"
                                      DisplayMemberPath="Title"
                                      SelectedItem="{x:Bind ViewModel.SelectedBackgroundDisplayMode, Mode=TwoWay}"
                                      ToolTipService.ToolTip="{x:Bind ViewModel.SelectedBackgroundDisplayMode.Description, Mode=OneWay}" />
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsInterfaceModThumbnailSize, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <controls:PdxDropDown AutomationProperties.AutomationId="cmbModThumbnailSize"
                                      AutomationProperties.Name="{x:Bind L.SettingsInterfaceModThumbnailSizeName, Mode=OneWay}"
                                      Width="320" MinHeight="32"
                                      ItemsSource="{x:Bind ViewModel.ModThumbnailSizeOptions, Mode=OneWay}"
                                      DisplayMemberPath="Title"
                                      SelectedItem="{x:Bind ViewModel.SelectedModThumbnailSize, Mode=TwoWay}"
                                      ToolTipService.ToolTip="{x:Bind ViewModel.SelectedModThumbnailSize.Description, Mode=OneWay}" />
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsInterfaceAlwaysOnTop, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglAlwaysOnTop"
                                          AutomationProperties.Name="{x:Bind L.SettingsInterfaceAlwaysOnTopName, Mode=OneWay}"
                                          IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}" />
                        </ct:SettingsCard>

                        <TextBlock Text="{x:Bind L.SettingsInterfaceHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="secLaunch" Spacing="8"
                                x:Load="{x:Bind IsLaunchSection, Mode=OneWay}"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(IsLaunchSection), Mode=OneWay}">
                        <TextBlock Text="{x:Bind L.SettingsSectionLaunch, Mode=OneWay}" Style="{StaticResource SettingsSectionTitleStyle}" />

                        <ct:SettingsCard Header="{x:Bind L.SettingsLaunchExe, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <TextBlock Text="{x:Bind ViewModel.ExePath, Mode=OneWay}"
                                       AutomationProperties.AutomationId="txtExePath"
                                       AutomationProperties.Name="{x:Bind L.SettingsLaunchExeName, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.ExePath, Mode=OneWay}"
                                       MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsLaunchArgs, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <TextBlock Text="{x:Bind ViewModel.ExeArgsText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="txtExeArgs"
                                       AutomationProperties.Name="{x:Bind L.SettingsLaunchArgsName, Mode=OneWay}"
                                       MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsLaunchAlternatives, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                                <controls:PdxDropDown AutomationProperties.AutomationId="cmbAlternativeExecutable"
                                          AutomationProperties.Name="{x:Bind L.SettingsLaunchAlternativesName, Mode=OneWay}"
                                          Width="320" MinHeight="32"
                                          ItemsSource="{x:Bind ViewModel.Alternatives, Mode=OneWay}"
                                          DisplayMemberPath="DisplayLabel"
                                          SelectedItem="{x:Bind ViewModel.SelectedAlternative, Mode=TwoWay}" />
                        </ct:SettingsCard>
                    </StackPanel>

                    <StackPanel x:Name="secPaths" Spacing="8"
                                x:Load="{x:Bind IsPathsSection, Mode=OneWay}"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(IsPathsSection), Mode=OneWay}">
                        <TextBlock Text="{x:Bind L.SettingsSectionData, Mode=OneWay}" Style="{StaticResource SettingsSectionTitleStyle}" />

                        <ct:SettingsCard Header="{x:Bind L.SettingsDataGameData, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock AutomationProperties.AutomationId="txtGameDataPath"
                                               AutomationProperties.Name="{x:Bind L.SettingsDataGameDataName, Mode=OneWay}"
                                               Text="{x:Bind ViewModel.GameDataPath, Mode=OneWay}"
                                               MaxWidth="380" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.GameDataPath, Mode=OneWay}" />
                                    <Button AutomationProperties.AutomationId="btnOpenDataDirectory"
                                            AutomationProperties.Name="{x:Bind L.SettingsDataOpenName, Mode=OneWay}"
                                            Content="{x:Bind L.SettingsDataOpen, Mode=OneWay}"
                                            Click="OnOpenDataDirectoryClick" />
                                </StackPanel>
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsDataDlcScan, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <TextBlock Text="{x:Bind ViewModel.DlcPath, Mode=OneWay}"
                                       AutomationProperties.AutomationId="txtDlcPath"
                                       AutomationProperties.Name="{x:Bind L.SettingsDataDlcScanName, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.DlcPath, Mode=OneWay}"
                                       MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsDataModDir, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <TextBlock Text="{x:Bind ViewModel.ModDir, Mode=OneWay}"
                                       AutomationProperties.AutomationId="txtModDir"
                                       AutomationProperties.Name="{x:Bind L.SettingsDataModDirName, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.ModDir, Mode=OneWay}"
                                       MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsDataFormatVersion, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <TextBlock Text="{x:Bind ViewModel.FormatVersionText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="txtFormatVersion"
                                       AutomationProperties.Name="{x:Bind L.SettingsDataFormatVersionName, Mode=OneWay}"
                                       MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </ct:SettingsCard>

                        <ct:SettingsCard Header="{x:Bind L.SettingsDataLoadFile, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Description="{x:Bind ViewModel.LoadFileStateText, Mode=OneWay}"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                            <TextBlock Text="{x:Bind ViewModel.LoadFilePath, Mode=OneWay}"
                                       AutomationProperties.AutomationId="txtLoadFilePath"
                                       AutomationProperties.Name="{x:Bind L.SettingsDataLoadFileName, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.LoadFilePath, Mode=OneWay}"
                                       MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </ct:SettingsCard>

                        <TextBlock Text="{x:Bind L.SettingsDataDlcHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />

                        <TextBlock Text="{x:Bind L.SettingsSectionAppData, Mode=OneWay}" Style="{StaticResource SettingsSubsectionTitleStyle}" />

                        <ct:SettingsCard Header="{x:Bind L.SettingsAppDataCurrent, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource PdxCardBackgroundBrush}"
                                         BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         MinHeight="56"
                                         Padding="16,12"
                                         IsClickEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock AutomationProperties.AutomationId="txtAppDataDirectory"
                                               AutomationProperties.Name="{x:Bind L.SettingsAppDataCurrentName, Mode=OneWay}"
                                               Text="{x:Bind ViewModel.DataDirectoryPath, Mode=OneWay}"
                                               MaxWidth="380" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.DataDirectoryPath, Mode=OneWay}" />
                                    <Button AutomationProperties.AutomationId="btnOpenAppDataDirectory"
                                            AutomationProperties.Name="{x:Bind L.SettingsAppDataOpenName, Mode=OneWay}"
                                            Content="{x:Bind L.SettingsAppDataOpen, Mode=OneWay}"
                                            Click="OnOpenAppDataDirectoryClick" />
                                </StackPanel>
                        </ct:SettingsCard>

