<Page
    x:Class="PdxLauncher.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:PdxLauncher.Core.Contracts"
    xmlns:controls="using:PdxLauncher.App.Controls"
    xmlns:svc="using:PdxLauncher.App.Services"
    xmlns:vm="using:PdxLauncher.App.ViewModels"
    NavigationCacheMode="Disabled"
    Background="{ThemeResource PdxPageVeilBrush}">

    <Page.Resources>
        <!-- 小标题下方/卡片下方的说明文字，统一走这一个样式（原来是 4 行内联属性 × 8 处）。 -->
        <Style x:Key="SettingsHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4,0,4,8" />
        </Style>
        <!-- 一个分类里的二级小节标题（「数据」「Mod 缩略图」「程序数据」…）。 -->
        <Style x:Key="SettingsSubsectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Page.Resources>

    <Grid Padding="20" RowSpacing="12" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            左侧分节导航用官方 NavigationView（与主窗口左栏同一控件、同 216 宽）：
            选中指示条左侧按规范留的是「图标位」，条目带 SymbolIcon 后条与文字之间
            自然隔开；改用纯文字 ListView 时文字会顶到指示条旁。
        -->
        <NavigationView Grid.Row="0"
                        Grid.Column="0"
                        x:Name="navSettingsSections"
                        AutomationProperties.AutomationId="lstSettingsSections"
                        AutomationProperties.Name="{x:Bind L.SettingsSectionName, Mode=OneWay}"
                        Background="Transparent"
                        PaneDisplayMode="Left"
                        OpenPaneLength="216"
                        IsPaneOpen="True"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="OnSectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel Spacing="4" Margin="0,4,0,0">
                    <TextBlock Text="{x:Bind L.SettingsTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.GameTitle, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsAppearance"
                                    Tag="0"
                                    Content="{x:Bind L.SettingsNavAppearance, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Font" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsLaunch"
                                    Tag="1"
                                    Content="{x:Bind L.SettingsNavLaunch, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsPaths"
                                    Tag="2"
                                    Content="{x:Bind L.SettingsNavPaths, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsOnline"
                                    Tag="3"
                                    Content="{x:Bind L.SettingsNavOnline, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Globe" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsCache"
                                    Tag="4"
                                    Content="{x:Bind L.SettingsNavCache, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Save" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsAdvanced"
                                    Tag="5"
                                    Content="{x:Bind L.SettingsNavAdvanced, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsTranslation"
                                    Tag="6"
                                    Content="{x:Bind L.SettingsNavTranslation, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="World" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navSettingsAbout"
                                    Tag="7"
                                    Content="{x:Bind L.SettingsNavAbout, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>

        <ScrollViewer Grid.Row="0"
                      Grid.Column="1"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          HorizontalContentAlignment="Stretch">
                <!--
                    右侧 14 DIP 是滚动条通道：WinUI 3 的 Fluent 滚动条是浮层，
                    贴在 ScrollViewer 右边缘绘制、不占内容宽度。内容若一路撑到边缘，
                    轨道和滑块就会压在卡片的 1 px 描边与 8 px 圆角上（详见 docs/SETTINGS-REWORK.md）。
                -->
                <StackPanel Spacing="12" Margin="0,0,16,0">

                    <StackPanel x:Name="secAppearance" Spacing="8">
                        <TextBlock Text="{x:Bind L.SettingsSectionTheme, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,4,0,0" />

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsThemeSource, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.ThemeSourceText, Mode=OneWay}"
                                                    ValueAutomationId="txtThemeSource"
                                                    ValueAutomationName="{x:Bind L.SettingsThemeSource, Mode=OneWay}"
                                                    ShowToolTip="False" />

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsThemeLastCheck, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.LastCheckText, Mode=OneWay}"
                                                    ValueAutomationId="txtThemeLastCheck"
                                                    ValueAutomationName="{x:Bind L.SettingsThemeLastCheck, Mode=OneWay}"
                                                    ShowToolTip="False" />

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsThemeNextCheck, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.NextCheckText, Mode=OneWay}"
                                                    ValueAutomationId="txtThemeNextCheck"
                                                    ValueAutomationName="{x:Bind L.SettingsThemeNextCheck, Mode=OneWay}"
                                                    ShowToolTip="False" />

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsThemeBackgroundFile, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.BackgroundFileText, Mode=OneWay}"
                                                    ValueAutomationId="txtThemeBackgroundFile"
                                                    ValueAutomationName="{x:Bind L.SettingsThemeBackgroundFile, Mode=OneWay}"
                                                    ShowToolTip="False" />

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsThemeLastFailure, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.LastFailureText, Mode=OneWay}"
                                                    ValueAutomationId="txtThemeLastFailure"
                                                    ValueAutomationName="{x:Bind L.SettingsThemeLastFailure, Mode=OneWay}"
                                                    ShowToolTip="False" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsThemeOnlineOn, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <ProgressRing AutomationProperties.AutomationId="ringSettingsBusy"
                                                  Width="20" Height="20"
                                                  IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsBusy), Mode=OneWay}" />
                                    <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglOnlineThemeRefresh"
                                                  AutomationProperties.Name="{x:Bind L.SettingsThemeOnlineOn, Mode=OneWay}"
                                                  IsOn="{x:Bind ViewModel.OnlineRefreshEnabled, Mode=TwoWay}" />
                                    <Button AutomationProperties.AutomationId="btnCheckThemeNow"
                                            AutomationProperties.Name="{x:Bind L.SettingsThemeCheckNow, Mode=OneWay}"
                                            Content="{x:Bind L.SettingsThemeCheckNow, Mode=OneWay}"
                                            Click="OnCheckThemeClick"
                                            IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}" />
                                </StackPanel>
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <TextBlock Text="{x:Bind L.SettingsThemeHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />

                        <TextBlock Text="{x:Bind L.SettingsSectionInterface, Mode=OneWay}" Style="{StaticResource SettingsSubsectionTitleStyle}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsInterfaceLanguage, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <controls:PdxDropDown AutomationProperties.AutomationId="cmbUiLanguage"
                                          AutomationProperties.Name="{x:Bind L.SettingsInterfaceLanguageName, Mode=OneWay}"
                                          Width="320" MinHeight="32"
                                          ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}"
                                          DisplayMemberPath="Title"
                                          SelectedItem="{x:Bind ViewModel.SelectedUiLanguage, Mode=TwoWay}"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedUiLanguage.Description, Mode=OneWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsInterfacePlaySetMode, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <controls:PdxDropDown AutomationProperties.AutomationId="cmbPlaySetPageDisplayMode"
                                          AutomationProperties.Name="{x:Bind L.SettingsInterfacePlaySetModeName, Mode=OneWay}"
                                          Width="320" MinHeight="32"
                                          ItemsSource="{x:Bind ViewModel.PlaySetDisplayModes, Mode=OneWay}"
                                          DisplayMemberPath="Title"
                                          SelectedItem="{x:Bind ViewModel.SelectedPlaySetDisplayMode, Mode=TwoWay}"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedPlaySetDisplayMode.Description, Mode=OneWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsInterfaceBackgroundMode, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <controls:PdxDropDown AutomationProperties.AutomationId="cmbBackgroundDisplayMode"
                                          AutomationProperties.Name="{x:Bind L.SettingsInterfaceBackgroundModeName, Mode=OneWay}"
                                          Width="320" MinHeight="32"
                                          ItemsSource="{x:Bind ViewModel.BackgroundDisplayModeOptions, Mode=OneWay}"
                                          DisplayMemberPath="Title"
                                          SelectedItem="{x:Bind ViewModel.SelectedBackgroundDisplayMode, Mode=TwoWay}"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedBackgroundDisplayMode.Description, Mode=OneWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsInterfaceModThumbnailSize, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <controls:PdxDropDown AutomationProperties.AutomationId="cmbModThumbnailSize"
                                          AutomationProperties.Name="{x:Bind L.SettingsInterfaceModThumbnailSizeName, Mode=OneWay}"
                                          Width="320" MinHeight="32"
                                          ItemsSource="{x:Bind ViewModel.ModThumbnailSizeOptions, Mode=OneWay}"
                                          DisplayMemberPath="Title"
                                          SelectedItem="{x:Bind ViewModel.SelectedModThumbnailSize, Mode=TwoWay}"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedModThumbnailSize.Description, Mode=OneWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsInterfaceAlwaysOnTop, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglAlwaysOnTop"
                                              AutomationProperties.Name="{x:Bind L.SettingsInterfaceAlwaysOnTopName, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <TextBlock Text="{x:Bind L.SettingsInterfaceHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="secLaunch" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind L.SettingsSectionLaunch, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsLaunchExe, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.ExePath, Mode=OneWay}"
                                                    ValueAutomationId="txtExePath"
                                                    ValueAutomationName="{x:Bind L.SettingsLaunchExeName, Mode=OneWay}" />

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsLaunchArgs, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.ExeArgsText, Mode=OneWay}"
                                                    ValueAutomationId="txtExeArgs"
                                                    ValueAutomationName="{x:Bind L.SettingsLaunchArgsName, Mode=OneWay}"
                                                    ShowToolTip="False" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsLaunchAlternatives, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <controls:PdxDropDown AutomationProperties.AutomationId="cmbAlternativeExecutable"
                                          AutomationProperties.Name="{x:Bind L.SettingsLaunchAlternativesName, Mode=OneWay}"
                                          Width="320" MinHeight="32"
                                          ItemsSource="{x:Bind ViewModel.Alternatives, Mode=OneWay}"
                                          DisplayMemberPath="DisplayLabel"
                                          SelectedItem="{x:Bind ViewModel.SelectedAlternative, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>
                    </StackPanel>

                    <StackPanel x:Name="secPaths" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind L.SettingsSectionData, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsDataGameData, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock AutomationProperties.AutomationId="txtGameDataPath"
                                               AutomationProperties.Name="{x:Bind L.SettingsDataGameDataName, Mode=OneWay}"
                                               Text="{x:Bind ViewModel.GameDataPath, Mode=OneWay}"
                                               MaxWidth="380" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.GameDataPath, Mode=OneWay}" />
                                    <Button AutomationProperties.AutomationId="btnOpenDataDirectory"
                                            AutomationProperties.Name="{x:Bind L.SettingsDataOpenName, Mode=OneWay}"
                                            Content="{x:Bind L.SettingsDataOpen, Mode=OneWay}"
                                            Click="OnOpenDataDirectoryClick" />
                                </StackPanel>
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsDataDlcScan, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.DlcPath, Mode=OneWay}"
                                                    ValueAutomationId="txtDlcPath"
                                                    ValueAutomationName="{x:Bind L.SettingsDataDlcScanName, Mode=OneWay}" />

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsDataModDir, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.ModDir, Mode=OneWay}"
                                                    ValueAutomationId="txtModDir"
                                                    ValueAutomationName="{x:Bind L.SettingsDataModDirName, Mode=OneWay}" />

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsDataFormatVersion, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.FormatVersionText, Mode=OneWay}"
                                                    ValueAutomationId="txtFormatVersion"
                                                    ValueAutomationName="{x:Bind L.SettingsDataFormatVersionName, Mode=OneWay}"
                                                    ShowToolTip="False" />

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsDataLoadFile, Mode=OneWay}"
                                                    Description="{x:Bind ViewModel.LoadFileStateText, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.LoadFilePath, Mode=OneWay}"
                                                    ValueAutomationId="txtLoadFilePath"
                                                    ValueAutomationName="{x:Bind L.SettingsDataLoadFileName, Mode=OneWay}" />

                        <TextBlock Text="{x:Bind L.SettingsDataDlcHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />

                        <TextBlock Text="{x:Bind L.SettingsSectionAppData, Mode=OneWay}" Style="{StaticResource SettingsSubsectionTitleStyle}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsAppDataCurrent, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock AutomationProperties.AutomationId="txtAppDataDirectory"
                                               AutomationProperties.Name="{x:Bind L.SettingsAppDataCurrentName, Mode=OneWay}"
                                               Text="{x:Bind ViewModel.DataDirectoryPath, Mode=OneWay}"
                                               MaxWidth="380" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.DataDirectoryPath, Mode=OneWay}" />
                                    <Button AutomationProperties.AutomationId="btnOpenAppDataDirectory"
                                            AutomationProperties.Name="{x:Bind L.SettingsAppDataOpenName, Mode=OneWay}"
                                            Content="{x:Bind L.SettingsAppDataOpen, Mode=OneWay}"
                                            Click="OnOpenAppDataDirectoryClick" />
                                </StackPanel>
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsAppDataLegacy, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock AutomationProperties.AutomationId="txtLegacyDataDirectory"
                                               AutomationProperties.Name="{x:Bind L.SettingsAppDataLegacyName, Mode=OneWay}"
                                               Text="{x:Bind ViewModel.LegacyDataDirectoryPath, Mode=OneWay}"
                                               MaxWidth="380" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.LegacyDataDirectoryPath, Mode=OneWay}" />
                                    <Button AutomationProperties.AutomationId="btnClearLegacyData"
                                            AutomationProperties.Name="{x:Bind L.SettingsAppDataClearLegacyName, Mode=OneWay}"
                                            Content="{x:Bind L.SettingsAppDataClearLegacy, Mode=OneWay}"
                                            Click="OnClearLegacyDataClick" />
                                </StackPanel>
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <TextBlock Text="{x:Bind L.SettingsAppDataHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="secOnline" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind L.SettingsSectionProxy, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsProxyMode, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <controls:PdxDropDown AutomationProperties.AutomationId="cmbProxyMode"
                                          AutomationProperties.Name="{x:Bind L.SettingsProxyModeName, Mode=OneWay}"
                                          Width="320" MinHeight="32"
                                          ItemsSource="{x:Bind ViewModel.ProxyModeOptions, Mode=OneWay}"
                                          DisplayMemberPath="Title"
                                          SelectedItem="{x:Bind ViewModel.SelectedProxyMode, Mode=TwoWay}"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedProxyMode.Description, Mode=OneWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsProxyAddress, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <TextBox AutomationProperties.AutomationId="txtProxyUrl"
                                         AutomationProperties.Name="{x:Bind L.SettingsProxyAddress, Mode=OneWay}"
                                         Width="320"
                                         PlaceholderText="{x:Bind L.SettingsProxyAddressPlaceholder, Mode=OneWay}"
                                         Text="{x:Bind ViewModel.ProxyUrl, Mode=OneWay}"
                                         IsEnabled="{x:Bind ViewModel.IsManualProxy, Mode=OneWay}"
                                         TextChanged="OnProxyUrlChanged"
                                         LostFocus="OnProxyUrlLostFocus"
                                         KeyDown="OnProxyUrlKeyDown" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsProxyCurrent, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.ProxyStatusText, Mode=OneWay}"
                                                    ValueAutomationId="txtProxyStatus"
                                                    ValueAutomationName="{x:Bind L.SettingsProxyCurrentName, Mode=OneWay}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsProxyDetected, Mode=OneWay}"
                                              Description="{x:Bind L.SettingsProxyDetectedHint, Mode=OneWay}"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasDetectedProxy), Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock AutomationProperties.AutomationId="txtDetectedProxy"
                                               AutomationProperties.Name="{x:Bind L.SettingsProxyDetectedName, Mode=OneWay}"
                                               Text="{x:Bind ViewModel.DetectedProxyText, Mode=OneWay}"
                                               MaxWidth="240"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button AutomationProperties.AutomationId="btnUseDetectedProxy"
                                            AutomationProperties.Name="{x:Bind L.SettingsProxyUseDetectedName, Mode=OneWay}"
                                            Content="{x:Bind L.SettingsProxyUseDetected, Mode=OneWay}"
                                            Click="OnUseDetectedProxyClick" />
                                </StackPanel>
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <TextBlock Text="{x:Bind L.SettingsProxyHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsSteamStateOn, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglSteamWorkshopState"
                                              AutomationProperties.Name="{x:Bind L.SettingsSteamStateOn, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.SteamStateEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <TextBlock Text="{x:Bind L.SettingsSteamStateHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsSteamSubscribeOn, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglSteamWorkshopSubscribe"
                                              AutomationProperties.Name="{x:Bind L.SettingsSteamSubscribeOn, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.SteamSubscribeEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsSteamApiHeader, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.SteamApiStatusText, Mode=OneWay}"
                                                    ValueAutomationId="txtSteamApiStatus"
                                                    ValueAutomationName="{x:Bind L.SettingsSteamApiHeader, Mode=OneWay}"
                                                    ShowToolTip="True" />

                        <TextBlock Text="{x:Bind L.SettingsSteamSubscribeHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />

                    </StackPanel>

                    <StackPanel x:Name="secCache" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind L.SettingsSectionCache, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <controls:SettingsCard Header="{x:Bind ViewModel.CacheTotalText, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button AutomationProperties.AutomationId="btnRefreshCache"
                                            AutomationProperties.Name="{x:Bind L.SettingsCacheRefreshName, Mode=OneWay}"
                                            Content="{x:Bind L.SettingsCacheRefresh, Mode=OneWay}"
                                            Click="OnRefreshCacheClick" />
                                    <Button AutomationProperties.AutomationId="btnClearAllCaches"
                                            AutomationProperties.Name="{x:Bind L.SettingsCacheClearAllName, Mode=OneWay}"
                                            Content="{x:Bind L.SettingsCacheClearAll, Mode=OneWay}"
                                            Click="OnClearAllCachesClick" />
                                </StackPanel>
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.CacheRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CacheRowViewModel">
                                    <controls:SettingsCard Margin="0,0,0,8"
                                                           Header="{x:Bind Title, Mode=OneWay}"
                                                           Description="{x:Bind Description, Mode=OneWay}"
                                                           ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}">
                                        <controls:SettingsCard.ActionContent>
                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <ProgressRing Width="16" Height="16"
                                                              IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                              Visibility="{x:Bind svc:XamlVisibility.FromBool(IsBusy), Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind SizeText, Mode=OneWay}"
                                                           MinWidth="96" TextAlignment="Right" VerticalAlignment="Center" />
                                                <Button Content="{x:Bind L.CommonClear, Mode=OneWay}"
                                                        IsEnabled="{x:Bind CanClear, Mode=OneWay}"
                                                        Click="OnClearCacheRowClick" />
                                            </StackPanel>
                                        </controls:SettingsCard.ActionContent>
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Bind L.SettingsSectionData, Mode=OneWay}" Style="{StaticResource SettingsSubsectionTitleStyle}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsDataDlcOnlineOn, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglOnlineDlcDescription"
                                              AutomationProperties.Name="{x:Bind L.SettingsDataDlcOnlineOn, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.DlcDescriptionOnlineEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsDataDlcCacheDays, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <controls:PdxDropDown AutomationProperties.AutomationId="cmbDlcDescriptionRetention"
                                          AutomationProperties.Name="{x:Bind L.SettingsDataDlcCacheDaysName, Mode=OneWay}"
                                          Width="200" MinHeight="32"
                                          ItemsSource="{x:Bind ViewModel.DlcDescriptionRetentions, Mode=OneWay}"
                                          DisplayMemberPath="Title"
                                          SelectedItem="{x:Bind ViewModel.SelectedDlcDescriptionRetention, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsDataNewsOnlineOn, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglOnlineNewsFeed"
                                              AutomationProperties.Name="{x:Bind L.SettingsDataNewsOnlineOn, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.NewsFeedOnlineEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <TextBlock Text="{x:Bind L.SettingsDataNewsHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />

                        <TextBlock Text="{x:Bind L.SettingsSectionModThumbnails, Mode=OneWay}" Style="{StaticResource SettingsSubsectionTitleStyle}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsModThumbnailsOnlineOn, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglOnlineModThumbnail"
                                              AutomationProperties.Name="{x:Bind L.SettingsModThumbnailsOnlineOn, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.ModThumbnailOnlineEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsModThumbnailsRetention, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <controls:PdxDropDown AutomationProperties.AutomationId="cmbModThumbnailRetention"
                                          AutomationProperties.Name="{x:Bind L.SettingsModThumbnailsRetentionName, Mode=OneWay}"
                                          Width="200" MinHeight="32"
                                          ItemsSource="{x:Bind ViewModel.ModThumbnailRetentions, Mode=OneWay}"
                                          DisplayMemberPath="Title"
                                          SelectedItem="{x:Bind ViewModel.SelectedModThumbnailRetention, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsModThumbnailsCacheDir, Mode=OneWay}"
                                                    Description="{x:Bind ViewModel.ModThumbnailCacheSummary, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.ModThumbnailCachePath, Mode=OneWay}"
                                                    ValueAutomationId="txtModThumbnailCachePath"
                                                    ValueAutomationName="{x:Bind L.SettingsModThumbnailsCacheDirName, Mode=OneWay}" />

                        <TextBlock Text="{x:Bind L.SettingsModThumbnailsHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />

                        <TextBlock Text="{x:Bind L.SettingsCacheHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="secAdvanced" Spacing="8" Visibility="Collapsed">
                        <!-- 补丁：只处理当前选中的游戏；素材与清单都在程序目录下，随时可整体移除。 -->
                        <TextBlock Text="{x:Bind L.SettingsPatchTitle, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsPatchStatusTitle, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <StackPanel Spacing="4" MaxWidth="440" HorizontalAlignment="Right">
                                    <TextBlock AutomationProperties.AutomationId="txtPatchStatus"
                                               AutomationProperties.Name="{x:Bind L.SettingsPatchStatusTitle, Mode=OneWay}"
                                               Text="{x:Bind ViewModel.PatchStatusText, Mode=OneWay}"
                                               HorizontalAlignment="Right"
                                               TextWrapping="Wrap" />
                                    <TextBlock AutomationProperties.AutomationId="txtPatchDetail"
                                               AutomationProperties.Name="{x:Bind L.SettingsPatchStatusTitle, Mode=OneWay}"
                                               Text="{x:Bind ViewModel.PatchDetailText, Mode=OneWay}"
                                               Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasPatchDetail), Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Right"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsPatchApply, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button AutomationProperties.AutomationId="btnApplyPatch"
                                            AutomationProperties.Name="{x:Bind L.SettingsPatchApplyName, Mode=OneWay}"
                                            Content="{x:Bind L.SettingsPatchApply, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.CanApplyPatch, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="OnApplyPatchClick" />
                                    <Button AutomationProperties.AutomationId="btnRemovePatch"
                                            AutomationProperties.Name="{x:Bind L.SettingsPatchRemoveName, Mode=OneWay}"
                                            Content="{x:Bind L.SettingsPatchRemove, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.CanRemovePatch, Mode=OneWay}"
                                            Click="OnRemovePatchClick" />
                                    <Button AutomationProperties.AutomationId="btnOpenPatchAssets"
                                            AutomationProperties.Name="{x:Bind L.SettingsPatchOpenAssetsName, Mode=OneWay}"
                                            Content="{x:Bind L.SettingsPatchOpenAssets, Mode=OneWay}"
                                            Click="OnOpenPatchAssetsClick" />
                                </StackPanel>
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <TextBlock Text="{x:Bind L.SettingsPatchHint, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="4,0,4,8" />

                        <TextBlock Text="{x:Bind L.SettingsSectionDanger, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsDangerAllowOn, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglWriteDlcSignature"
                                              AutomationProperties.Name="{x:Bind L.SettingsDangerAllowOn, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.WriteDlcSignature, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsDangerRegenerateTitle, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <Button AutomationProperties.AutomationId="btnRegenerateDlcSignature"
                                        AutomationProperties.Name="{x:Bind L.SettingsDangerRegenerate, Mode=OneWay}"
                                        Content="{x:Bind L.SettingsDangerRegenerate, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanRegenerateSignature, Mode=OneWay}"
                                        Click="OnRegenerateSignatureClick" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsDangerSignatureName, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.LastSignature, Mode=OneWay}"
                                                    ValueAutomationId="txtLastSignature"
                                                    ValueAutomationName="{x:Bind L.SettingsDangerSignatureName, Mode=OneWay}"
                                                    Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasLastSignature), Mode=OneWay}" />

                        <TextBlock Text="{x:Bind L.SettingsDangerHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="secTranslation" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind L.SettingsSectionTranslation, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateEnabled, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglTranslateEnabled"
                                              AutomationProperties.Name="{x:Bind L.SettingsTranslateEnabledName, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.TranslateEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateKeepLoaded, Mode=OneWay}"
                                               Description="{x:Bind L.SettingsTranslateKeepLoadedDesc, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglTranslateKeepLoaded"
                                              AutomationProperties.Name="{x:Bind L.SettingsTranslateKeepLoadedName, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.KeepTranslationModelLoaded, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateEngine, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <controls:PdxDropDown AutomationProperties.AutomationId="cmbTranslateEngineMode"
                                          AutomationProperties.Name="{x:Bind L.SettingsTranslateEngineName, Mode=OneWay}"
                                          Width="320" MinHeight="32"
                                          ItemsSource="{x:Bind ViewModel.TranslationEngineOptions, Mode=OneWay}"
                                          DisplayMemberPath="Title"
                                          SelectedItem="{x:Bind ViewModel.SelectedTranslationEngine, Mode=TwoWay}"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedTranslationEngine.Description, Mode=OneWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateBaseUrl, Mode=OneWay}"
                                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasOpenAiFields), Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <TextBox AutomationProperties.AutomationId="txtTranslateBaseUrl"
                                         AutomationProperties.Name="{x:Bind L.SettingsTranslateBaseUrlName, Mode=OneWay}"
                                         Width="320"
                                         PlaceholderText="{x:Bind L.SettingsTranslateBaseUrlPlaceholder, Mode=OneWay}"
                                         Text="{x:Bind ViewModel.TranslateBaseUrl, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateApiKey, Mode=OneWay}"
                                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasOpenAiFields), Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <PasswordBox AutomationProperties.AutomationId="pwdTranslateApiKey"
                                             AutomationProperties.Name="{x:Bind L.SettingsTranslateApiKeyName, Mode=OneWay}"
                                             Width="320"
                                             Password="{x:Bind ViewModel.TranslateApiKey, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateModel, Mode=OneWay}"
                                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasOpenAiFields), Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <TextBox AutomationProperties.AutomationId="txtTranslateModel"
                                         AutomationProperties.Name="{x:Bind L.SettingsTranslateModelName, Mode=OneWay}"
                                         Width="320"
                                         PlaceholderText="{x:Bind L.SettingsTranslateModelPlaceholder, Mode=OneWay}"
                                         Text="{x:Bind ViewModel.TranslateModel, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateMicrosoftKey, Mode=OneWay}"
                                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasMicrosoftFields), Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <PasswordBox AutomationProperties.AutomationId="pwdTranslateMicrosoftKey"
                                             AutomationProperties.Name="{x:Bind L.SettingsTranslateMicrosoftKeyName, Mode=OneWay}"
                                             Width="320"
                                             Password="{x:Bind ViewModel.TranslateMicrosoftKey, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateMicrosoftRegion, Mode=OneWay}"
                                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasMicrosoftFields), Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <TextBox AutomationProperties.AutomationId="txtTranslateMicrosoftRegion"
                                         AutomationProperties.Name="{x:Bind L.SettingsTranslateMicrosoftRegionName, Mode=OneWay}"
                                         Width="320"
                                         PlaceholderText="{x:Bind L.SettingsTranslateMicrosoftRegionPlaceholder, Mode=OneWay}"
                                         Text="{x:Bind ViewModel.TranslateMicrosoftRegion, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <StackPanel Spacing="4"
                                    Margin="0,0,0,8"
                                    Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasMicrosoftFields), Mode=OneWay}">
                            <TextBlock Text="{x:Bind L.SettingsTranslateMicrosoftHint, Mode=OneWay}"
                                       Style="{StaticResource SettingsHintTextStyle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="txtTranslateMicrosoftHint" />
                            <HyperlinkButton Padding="0"
                                             Click="OnTranslateMicrosoftPortalClick"
                                             Content="{x:Bind L.SettingsTranslateMicrosoftPortal, Mode=OneWay}"
                                             AutomationProperties.AutomationId="btnTranslateMicrosoftPortal" />
                        </StackPanel>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateGoogleKey, Mode=OneWay}"
                                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasGoogleCloudFields), Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <PasswordBox AutomationProperties.AutomationId="pwdTranslateGoogleKey"
                                             AutomationProperties.Name="{x:Bind L.SettingsTranslateGoogleKeyName, Mode=OneWay}"
                                             Width="320"
                                             Password="{x:Bind ViewModel.TranslateGoogleKey, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <StackPanel Spacing="4"
                                    Margin="0,0,0,8"
                                    Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasGoogleCloudFields), Mode=OneWay}">
                            <TextBlock Text="{x:Bind L.SettingsTranslateGoogleCloudHint, Mode=OneWay}"
                                       Style="{StaticResource SettingsHintTextStyle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="txtTranslateGoogleCloudHint" />
                            <HyperlinkButton Padding="0"
                                             Click="OnTranslateGoogleCloudPortalClick"
                                             Content="{x:Bind L.SettingsTranslateGoogleCloudPortal, Mode=OneWay}"
                                             AutomationProperties.AutomationId="btnTranslateGoogleCloudPortal" />
                        </StackPanel>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateLanguage, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <controls:PdxDropDown AutomationProperties.AutomationId="cmbTranslateTargetLanguage"
                                          AutomationProperties.Name="{x:Bind L.SettingsTranslateLanguageName, Mode=OneWay}"
                                          Width="320" MinHeight="32"
                                          ItemsSource="{x:Bind ViewModel.TranslationLanguageOptions, Mode=OneWay}"
                                          DisplayMemberPath="Title"
                                          SelectedItem="{x:Bind ViewModel.SelectedTranslationLanguage, Mode=TwoWay}"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedTranslationLanguage.Description, Mode=OneWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <TextBlock Text="{x:Bind L.SettingsTranslateScope, Mode=OneWay}" Style="{StaticResource SettingsSubsectionTitleStyle}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateScopeNames, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglTranslateNames"
                                              AutomationProperties.Name="{x:Bind L.SettingsTranslateScopeNames, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.TranslateNamesEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateScopeDescription, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglTranslateDescription"
                                              AutomationProperties.Name="{x:Bind L.SettingsTranslateScopeDescription, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.TranslateDescriptionEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateScopeChangelog, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglTranslateChangelog"
                                              AutomationProperties.Name="{x:Bind L.SettingsTranslateScopeChangelog, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.TranslateChangelogEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateScopeComments, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglTranslateComments"
                                              AutomationProperties.Name="{x:Bind L.SettingsTranslateScopeComments, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.TranslateCommentsEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateCacheDays, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <TextBox AutomationProperties.AutomationId="txtTranslateCacheDays"
                                         AutomationProperties.Name="{x:Bind L.SettingsTranslateCacheDaysName, Mode=OneWay}"
                                         Width="120"
                                         Text="{x:Bind ViewModel.TranslateCacheDaysText, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateTest, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <Button Click="OnTranslateTestClick"
                                        Content="{x:Bind L.SettingsTranslateTest, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanTestTranslation, Mode=OneWay}"
                                        AutomationProperties.AutomationId="btnTranslateTest"
                                        AutomationProperties.Name="{x:Bind L.SettingsTranslateTestName, Mode=OneWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <TextBlock AutomationProperties.AutomationId="txtTranslateTestResult"
                                   Text="{x:Bind ViewModel.TranslateTestText, Mode=OneWay}"
                                   Style="{StaticResource SettingsHintTextStyle}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{x:Bind L.SettingsTranslateLocalModels, Mode=OneWay}"
                                   Style="{StaticResource SettingsSubsectionTitleStyle}" />

                        <TextBlock Text="{x:Bind L.SettingsTranslateLocalModelsHint, Mode=OneWay}"
                                   Style="{StaticResource SettingsHintTextStyle}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.LocalModelRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LocalModelRowViewModel">
                                    <controls:SettingsCard Margin="0,0,0,8"
                                                           Header="{x:Bind Title, Mode=OneWay}"
                                                           Description="{x:Bind Description, Mode=OneWay}">
                                        <controls:SettingsCard.ActionContent>
                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <ProgressRing Width="16" Height="16"
                                                              IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                              Visibility="{x:Bind svc:XamlVisibility.FromBool(IsBusy), Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                           MinWidth="120" TextAlignment="Right" VerticalAlignment="Center" />
                                                <Button Content="{x:Bind L.SettingsTranslateLocalModelDownload, Mode=OneWay}"
                                                        IsEnabled="{x:Bind CanDownload, Mode=OneWay}"
                                                        Click="OnDownloadLocalModelClick"
                                                        AutomationProperties.AutomationId="btnDownloadLocalModel" />
                                                <Button Content="{x:Bind L.SettingsTranslateLocalModelRemove, Mode=OneWay}"
                                                        IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                                                        Click="OnRemoveLocalModelClick"
                                                        AutomationProperties.AutomationId="btnRemoveLocalModel" />
                                            </StackPanel>
                                        </controls:SettingsCard.ActionContent>
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Bind L.SettingsTranslateGlossary, Mode=OneWay}"
                                   Style="{StaticResource SettingsSubsectionTitleStyle}" />

                        <TextBlock Text="{x:Bind L.SettingsTranslateGlossaryHint, Mode=OneWay}"
                                   Style="{StaticResource SettingsHintTextStyle}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.GlossaryEntries, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GlossaryEntryViewModel">
                                    <Grid ColumnSpacing="8" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 AutomationProperties.AutomationId="txtGlossarySource"
                                                 Text="{x:Bind Source, Mode=TwoWay}" />
                                        <TextBox Grid.Column="1"
                                                 AutomationProperties.AutomationId="txtGlossaryTarget"
                                                 Text="{x:Bind Target, Mode=TwoWay}" />
                                        <Button Grid.Column="2"
                                                Content="{x:Bind L.SettingsTranslateGlossaryRemove, Mode=OneWay}"
                                                Click="OnRemoveGlossaryEntryClick"
                                                AutomationProperties.AutomationId="btnRemoveGlossaryEntry" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnSpacing="8" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     AutomationProperties.AutomationId="txtGlossarySourceInput"
                                     AutomationProperties.Name="{x:Bind L.SettingsTranslateGlossarySource, Mode=OneWay}"
                                     PlaceholderText="{x:Bind L.SettingsTranslateGlossarySourcePlaceholder, Mode=OneWay}"
                                     Text="{x:Bind ViewModel.GlossarySourceInput, Mode=TwoWay}" />
                            <TextBox Grid.Column="1"
                                     AutomationProperties.AutomationId="txtGlossaryTargetInput"
                                     AutomationProperties.Name="{x:Bind L.SettingsTranslateGlossaryTarget, Mode=OneWay}"
                                     PlaceholderText="{x:Bind L.SettingsTranslateGlossaryTargetPlaceholder, Mode=OneWay}"
                                     Text="{x:Bind ViewModel.GlossaryTargetInput, Mode=TwoWay}" />
                            <Button Grid.Column="2"
                                    Content="{x:Bind L.SettingsTranslateGlossaryAdd, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanAddGlossaryEntry, Mode=OneWay}"
                                    Click="OnAddGlossaryEntryClick"
                                    AutomationProperties.AutomationId="btnAddGlossaryEntry" />
                        </Grid>

                        <controls:SettingsCard Header="{x:Bind L.SettingsTranslateGlossarySave, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <Button Click="OnSaveGlossaryClick"
                                        Content="{x:Bind L.SettingsTranslateGlossarySave, Mode=OneWay}"
                                        AutomationProperties.AutomationId="btnSaveGlossary"
                                        AutomationProperties.Name="{x:Bind L.SettingsTranslateGlossarySave, Mode=OneWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <TextBlock Text="{x:Bind L.SettingsTranslateHint, Mode=OneWay}" Style="{StaticResource SettingsHintTextStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="secAbout" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind L.SettingsAboutTitle, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsAboutLauncherVersion, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.LauncherVersionText, Mode=OneWay}"
                                                    ValueAutomationId="txtLauncherVersion"
                                                    ValueAutomationName="{x:Bind L.SettingsAboutLauncherVersion, Mode=OneWay}" />

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsAboutInstallMode, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.InstallModeText, Mode=OneWay}"
                                                    ValueAutomationId="txtInstallMode"
                                                    ValueAutomationName="{x:Bind L.SettingsAboutInstallModeName, Mode=OneWay}" />

                        <controls:SettingsCard Header="{x:Bind L.SettingsAboutAutoCheck, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglAutoCheckUpdates"
                                              AutomationProperties.Name="{x:Bind L.SettingsAboutAutoCheckName, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind L.SettingsAboutCheckNow, Mode=OneWay}">
                            <controls:SettingsCard.ActionContent>
                                <Button AutomationProperties.AutomationId="btnCheckUpdates"
                                        AutomationProperties.Name="{x:Bind L.SettingsAboutCheckNowName, Mode=OneWay}"
                                        Content="{x:Bind L.SettingsAboutCheckNow, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanCheckUpdates, Mode=OneWay}"
                                        Click="OnCheckUpdatesClick" />
                            </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>

                        <controls:SettingsValueCard Header="{x:Bind L.SettingsAboutLastCheckLabel, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.LastUpdateCheckText, Mode=OneWay}"
                                                    ValueAutomationId="txtLastUpdateCheck"
                                                    ValueAutomationName="{x:Bind L.SettingsAboutLastCheckLabel, Mode=OneWay}" />

                        <TextBlock AutomationProperties.AutomationId="txtUpdateStatus"
                                   Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                                   Style="{StaticResource SettingsHintTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

        <!-- 与滚动内容共用 14 DIP 右侧通道，整页右边缘保持对齐。 -->
        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,0,16,0"
                Background="{ThemeResource PdxCardBackgroundBrush}"
                BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasStatusMessage), Mode=OneWay}">
            <TextBlock AutomationProperties.AutomationId="txtSettingsStatus"
                       AutomationProperties.Name="{x:Bind L.SettingsStatusName, Mode=OneWay}"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Page>
