                                                   Text="{x:Bind ViewModel.InstallModeDirectory, Mode=OneWay}"
                                                   MaxWidth="380" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.InstallModeDirectory, Mode=OneWay}" />
                                        <Button AutomationProperties.AutomationId="btnOpenInstallModeDirectory"
                                                AutomationProperties.Name="{x:Bind L.SettingsAboutInstallModeOpenDirectory, Mode=OneWay}"
                                                Content="{x:Bind L.SettingsAboutInstallModeOpenDirectory, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanOpenInstallModeDirectory, Mode=OneWay}"
                                                Click="OnOpenInstallModeDirectoryClick" />
                                    </StackPanel>
                            </ct:SettingsCard>

                            <ct:SettingsCard HorizontalAlignment="Stretch"
                                             ContentAlignment="Vertical"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             MinHeight="0"
                                             Padding="16,8,16,8"
                                             IsClickEnabled="False"
                                             Visibility="{x:Bind ViewModel.HasInstallModeHint, Mode=OneWay}">
                                <TextBlock AutomationProperties.AutomationId="txtInstallModeHint"
                                           Text="{x:Bind ViewModel.InstallModeHintText, Mode=OneWay}"
                                           Style="{StaticResource SettingsHintTextStyle}" />
                            </ct:SettingsCard>

                            <ct:SettingsCard Header="{x:Bind L.SettingsAboutInstallModeDataDirectory, Mode=OneWay}"
                                             HorizontalAlignment="Stretch"
                                             Background="Transparent"
                                             BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                             BorderThickness="0,1,0,0"
                                             CornerRadius="0"
                                             MinHeight="56"
                                             Padding="16,12"
                                             IsClickEnabled="False">
                                <TextBlock Text="{x:Bind ViewModel.InstallModeDataDirectory, Mode=OneWay}"
                                           AutomationProperties.AutomationId="txtInstallModeDataDirectory"
                                           AutomationProperties.Name="{x:Bind L.SettingsAboutInstallModeDataDirectory, Mode=OneWay}"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.InstallModeDataDirectory, Mode=OneWay}"
                                           MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </ct:SettingsCard>

                            <ct:SettingsCard HorizontalAlignment="Stretch"
                                             ContentAlignment="Vertical"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             MinHeight="0"
                                             Padding="16,8,16,8"
                                             IsClickEnabled="False"
                                             Visibility="{x:Bind ViewModel.ShowInstallModeDataNote, Mode=OneWay}">
                                <TextBlock AutomationProperties.AutomationId="txtInstallModeDataNote"
                                           Text="{x:Bind ViewModel.InstallModeDataNoteText, Mode=OneWay}"
                                           Style="{StaticResource SettingsHintTextStyle}" />
                            </ct:SettingsCard>

                            <ct:SettingsCard Header="{x:Bind L.SettingsAboutAutoCheck, Mode=OneWay}"
                                             HorizontalAlignment="Stretch"
                                             Background="Transparent"
                                             BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                             BorderThickness="0,1,0,0"
                                             CornerRadius="0"
                                             MinHeight="56"
                                             Padding="16,12"
                                             IsClickEnabled="False">
                                    <ToggleSwitch MinWidth="0" AutomationProperties.AutomationId="tglAutoCheckUpdates"
                                                  AutomationProperties.Name="{x:Bind L.SettingsAboutAutoCheckName, Mode=OneWay}"
                                                  IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" />
                            </ct:SettingsCard>

                            <ct:SettingsCard Header="{x:Bind L.SettingsAboutCheckNow, Mode=OneWay}"
                                             HorizontalAlignment="Stretch"
                                             Background="Transparent"
                                             BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                             BorderThickness="0,1,0,0"
                                             CornerRadius="0"
                                             MinHeight="56"
                                             Padding="16,12"
                                             IsClickEnabled="False">
                                    <Button AutomationProperties.AutomationId="btnCheckUpdates"
                                            AutomationProperties.Name="{x:Bind L.SettingsAboutCheckNowName, Mode=OneWay}"
                                            Content="{x:Bind L.SettingsAboutCheckNow, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.CanCheckUpdates, Mode=OneWay}"
                                            Click="OnCheckUpdatesClick" />
                            </ct:SettingsCard>

                            <ct:SettingsCard Header="{x:Bind L.SettingsAboutLastCheckLabel, Mode=OneWay}"
                                             HorizontalAlignment="Stretch"
                                             Background="Transparent"
                                             BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                             BorderThickness="0,1,0,0"
                                             CornerRadius="0"
                                             MinHeight="56"
                                             Padding="16,12"
                                             IsClickEnabled="False">
                                <TextBlock Text="{x:Bind ViewModel.LastUpdateCheckText, Mode=OneWay}"
                                           AutomationProperties.AutomationId="txtLastUpdateCheck"
                                           AutomationProperties.Name="{x:Bind L.SettingsAboutLastCheckLabel, Mode=OneWay}"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.LastUpdateCheckText, Mode=OneWay}"
                                           MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </ct:SettingsCard>

                            <ct:SettingsCard HorizontalAlignment="Stretch"
                                             ContentAlignment="Vertical"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             MinHeight="0"
                                             Padding="16,8,16,8"
                                             IsClickEnabled="False">
                                <TextBlock AutomationProperties.AutomationId="txtUpdateStatus"
                                           Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                                           Style="{StaticResource SettingsHintTextStyle}"
                                           TextWrapping="Wrap" />
                            </ct:SettingsCard>
                                </ct:SettingsExpander.Items>
                            </ct:SettingsExpander>
                            <!-- 模板自带的深色描边会被内部卡片盖住；这层只画 Pdx 外框。 -->
                            <Border IsHitTestVisible="False"
                                    BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8" />
                        </Grid>
                    </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

        <!-- 与滚动内容共用 16 DIP 右侧通道，整页右边缘保持对齐。 -->
        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,0,16,0"
                Background="{ThemeResource PdxCardBackgroundBrush}"
                BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasStatusMessage), Mode=OneWay}">
            <TextBlock AutomationProperties.AutomationId="txtSettingsStatus"
                       AutomationProperties.Name="{x:Bind L.SettingsStatusName, Mode=OneWay}"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Page>
