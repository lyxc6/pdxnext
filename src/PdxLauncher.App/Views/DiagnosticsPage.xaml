<Page
    x:Class="PdxLauncher.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PdxLauncher.App.Controls"
    xmlns:svc="using:PdxLauncher.App.Services"
    xmlns:vm="using:PdxLauncher.App.ViewModels"
    NavigationCacheMode="Disabled"
    Background="{ThemeResource PdxPageVeilBrush}">

    <Page.Resources>
        <!-- 与设置页同一套说明文字样式，保证两个诊断型页面看起来是一家人。 -->
        <Style x:Key="DiagnosticsHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4,0,4,8" />
        </Style>
        <Style x:Key="DiagnosticsSubsectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <DataTemplate x:Key="MetricRowTemplate" x:DataType="vm:DiagnosticMetricViewModel">
            <controls:SettingsValueCard Margin="0,0,0,8"
                                        Header="{x:Bind Title}"
                                        Description="{x:Bind Detail}"
                                        Value="{x:Bind Value}"
                                        ValueAutomationId="{x:Bind AutomationId}"
                                        MaxValueWidth="320" />
        </DataTemplate>

        <DataTemplate x:Key="HintRowTemplate" x:DataType="vm:DiagnosticHintViewModel">
            <controls:SettingsCard Margin="0,0,0,8"
                                   Header="{x:Bind Title}"
                                   Description="{x:Bind Detail}"
                                   AutomationProperties.AutomationId="{x:Bind AutomationId}" />
        </DataTemplate>

        <DataTemplate x:Key="CacheRowTemplate" x:DataType="vm:CacheRowViewModel">
            <controls:SettingsCard Margin="0,0,0,8"
                                   Header="{x:Bind Title, Mode=OneWay}"
                                   Description="{x:Bind Description, Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind Path}">
                <controls:SettingsCard.ActionContent>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressRing Width="16"
                                      Height="16"
                                      IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                      Visibility="{x:Bind svc:XamlVisibility.FromBool(IsBusy), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind SizeText, Mode=OneWay}"
                                   MinWidth="96"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                        <Button Content="{x:Bind L.CommonClear, Mode=OneWay}"
                                IsEnabled="{x:Bind CanClear, Mode=OneWay}"
                                Click="OnClearCacheRowClick" />
                    </StackPanel>
                </controls:SettingsCard.ActionContent>
            </controls:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="NetworkRowTemplate" x:DataType="vm:NetworkHostRowViewModel">
            <controls:SettingsCard Margin="0,0,0,8"
                                   Header="{x:Bind Host}"
                                   Description="{x:Bind StatsText}"
                                   AutomationProperties.AutomationId="{x:Bind AutomationId}">
                <controls:SettingsCard.ActionContent>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind LastRequestText}"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind CooldownText}"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </controls:SettingsCard.ActionContent>
            </controls:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="StartupRowTemplate" x:DataType="vm:StartupMarkRowViewModel">
            <controls:SettingsCard Margin="0,0,0,8"
                                   Header="{x:Bind Label}"
                                   Description="{x:Bind DeltaText}"
                                   AutomationProperties.AutomationId="{x:Bind AutomationId}">
                <controls:SettingsCard.ActionContent>
                    <TextBlock Text="{x:Bind ElapsedText}"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas" />
                </controls:SettingsCard.ActionContent>
            </controls:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20"
          RowSpacing="12"
          ColumnSpacing="16"
          AutomationProperties.AutomationId="pageDiagnostics">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 左侧分节与设置页同构（216 宽、无返回/设置按钮），选中态自己管。 -->
        <NavigationView Grid.Row="0"
                        Grid.Column="0"
                        x:Name="navDiagnosticsSections"
                        AutomationProperties.AutomationId="lstDiagnosticsSections"
                        AutomationProperties.Name="{x:Bind L.DiagnosticsPageTitle, Mode=OneWay}"
                        Background="Transparent"
                        PaneDisplayMode="Left"
                        OpenPaneLength="216"
                        IsPaneOpen="True"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="OnSectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel Spacing="4" Margin="0,4,0,0">
                    <TextBlock Text="{x:Bind L.DiagnosticsPageTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind L.DiagnosticsPageSubtitle, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem AutomationProperties.AutomationId="navDiagOverview"
                                    Tag="0"
                                    Content="{x:Bind L.DiagnosticsSectionOverview, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="View" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navDiagCache"
                                    Tag="1"
                                    Content="{x:Bind L.DiagnosticsSectionCache, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Save" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navDiagLog"
                                    Tag="2"
                                    Content="{x:Bind L.DiagnosticsSectionLog, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navDiagNetwork"
                                    Tag="3"
                                    Content="{x:Bind L.DiagnosticsSectionNetwork, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Globe" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navDiagStartup"
                                    Tag="4"
                                    Content="{x:Bind L.DiagnosticsSectionStartup, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>

        <ScrollViewer Grid.Row="0"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch">
            <!-- 右侧 14 DIP 同样是浮层滚动条通道，与设置页保持一致。 -->
            <StackPanel Spacing="12" Margin="0,0,14,0">

                <!-- ============ 概览 ============ -->
                <StackPanel x:Name="secOverview" Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind L.DiagnosticsSectionOverview, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,4,0,0" />
                            <TextBlock Text="{x:Bind ViewModel.LastSampleText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing Width="16" Height="16"
                                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                          Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsBusy), Mode=OneWay}" />
                            <Button AutomationProperties.AutomationId="btnDiagRefresh"
                                    Content="{x:Bind L.DiagnosticsOverviewRefresh, Mode=OneWay}"
                                    Click="OnRefreshOverviewClick" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{x:Bind L.DiagnosticsOverviewMetricsTitle, Mode=OneWay}" Style="{StaticResource DiagnosticsSubsectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Metrics, Mode=OneWay}"
                                  ItemTemplate="{StaticResource MetricRowTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="{x:Bind L.DiagnosticsOverviewCountersTitle, Mode=OneWay}" Style="{StaticResource DiagnosticsSubsectionTitleStyle}" />
                    <controls:SettingsCard Header="{x:Bind ViewModel.CacheTotalText, Mode=OneWay}"
                                           Description="{x:Bind L.DiagnosticsCacheHint, Mode=OneWay}">
                        <controls:SettingsCard.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressRing Width="16" Height="16"
                                              IsActive="{x:Bind ViewModel.IsCacheBusy, Mode=OneWay}"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsCacheBusy), Mode=OneWay}" />
                                <Button AutomationProperties.AutomationId="btnDiagRefreshCacheOverview"
                                        Content="{x:Bind L.SettingsCacheRefresh, Mode=OneWay}"
                                        Click="OnRefreshCacheClick" />
                            </StackPanel>
                        </controls:SettingsCard.ActionContent>
                    </controls:SettingsCard>

                    <TextBlock Text="{x:Bind L.DiagnosticsOverviewHintsTitle, Mode=OneWay}" Style="{StaticResource DiagnosticsSubsectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Hints, Mode=OneWay}"
                                  ItemTemplate="{StaticResource HintRowTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind L.DiagnosticsOverviewHintsEmpty, Mode=OneWay}"
                               Style="{StaticResource DiagnosticsHintTextStyle}"
                               Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(ViewModel.HasHints), Mode=OneWay}" />
                </StackPanel>

                <!-- ============ 缓存 ============ -->
                <StackPanel x:Name="secCache" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="{x:Bind L.DiagnosticsSectionCache, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="{x:Bind L.DiagnosticsCacheHint, Mode=OneWay}" Style="{StaticResource DiagnosticsHintTextStyle}" />

                    <controls:SettingsCard Header="{x:Bind ViewModel.CacheTotalText, Mode=OneWay}">
                        <controls:SettingsCard.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing Width="16" Height="16"
                                              IsActive="{x:Bind ViewModel.IsCacheBusy, Mode=OneWay}"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsCacheBusy), Mode=OneWay}" />
                                <Button AutomationProperties.AutomationId="btnDiagRefreshCache"
                                        Content="{x:Bind L.SettingsCacheRefresh, Mode=OneWay}"
                                        Click="OnRefreshCacheClick" />
                                <Button AutomationProperties.AutomationId="btnDiagClearAllCaches"
                                        Content="{x:Bind L.SettingsCacheClearAll, Mode=OneWay}"
                                        Click="OnClearAllCachesClick" />
                            </StackPanel>
                        </controls:SettingsCard.ActionContent>
                    </controls:SettingsCard>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.CacheRows, Mode=OneWay}"
                                  ItemTemplate="{StaticResource CacheRowTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- ============ 日志 ============ -->
                <StackPanel x:Name="secLog" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="{x:Bind L.DiagnosticsSectionLog, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="{x:Bind L.DiagnosticsLogHint, Mode=OneWay}" Style="{StaticResource DiagnosticsHintTextStyle}" />

                    <controls:SettingsCard Header="{x:Bind ViewModel.LogSummaryText, Mode=OneWay}"
                                           Description="{x:Bind ViewModel.LogRotationText, Mode=OneWay}">
                        <controls:SettingsCard.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing Width="16" Height="16"
                                              IsActive="{x:Bind ViewModel.IsLogBusy, Mode=OneWay}"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsLogBusy), Mode=OneWay}" />
                                <Button AutomationProperties.AutomationId="btnDiagRefreshLog"
                                        Content="{x:Bind L.CommonRefresh, Mode=OneWay}"
                                        Click="OnRefreshLogClick" />
                                <Button AutomationProperties.AutomationId="btnDiagOpenLogFolder"
                                        Content="{x:Bind L.DiagnosticsLogOpenFolder, Mode=OneWay}"
                                        Click="OnOpenLogFolderClick" />
                            </StackPanel>
                        </controls:SettingsCard.ActionContent>
                    </controls:SettingsCard>

                    <TextBlock Text="{x:Bind ViewModel.LogLastWriteText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="4,0,4,0" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind L.DiagnosticsLogFilterTitle, Mode=OneWay}" VerticalAlignment="Center" />
                            <RadioButton AutomationProperties.AutomationId="rdoDiagLogAll"
                                         GroupName="diagLogFilter"
                                         Content="{x:Bind L.DiagnosticsLogFilterAll, Mode=OneWay}"
                                         Tag="All"
                                         IsChecked="True"
                                         Checked="OnLogFilterChecked" />
                            <RadioButton AutomationProperties.AutomationId="rdoDiagLogWarn"
                                         GroupName="diagLogFilter"
                                         Content="{x:Bind L.DiagnosticsLogFilterWarn, Mode=OneWay}"
                                         Tag="Warning"
                                         Checked="OnLogFilterChecked" />
                            <RadioButton AutomationProperties.AutomationId="rdoDiagLogError"
                                         GroupName="diagLogFilter"
                                         Content="{x:Bind L.DiagnosticsLogFilterError, Mode=OneWay}"
                                         Tag="Error"
                                         Checked="OnLogFilterChecked" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      MinWidth="0"
                                      AutomationProperties.AutomationId="tglDiagAutoRefresh"
                                      AutomationProperties.Name="{x:Bind L.DiagnosticsLogAutoRefreshName, Mode=OneWay}"
                                      OffContent=""
                                      OnContent="{x:Bind L.DiagnosticsLogAutoRefresh, Mode=OneWay}"
                                      Toggled="OnAutoRefreshToggled" />
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.LogTailTitleText, Mode=OneWay}" Style="{StaticResource DiagnosticsSubsectionTitleStyle}" />
                    <TextBox x:Name="txtDiagLogTail"
                             AutomationProperties.AutomationId="txtDiagLogTail"
                             Text="{x:Bind ViewModel.LogTailText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             IsSpellCheckEnabled="False"
                             FontFamily="Cascadia Mono, Consolas"
                             Height="340"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Padding="10,8" />
                </StackPanel>

                <!-- ============ 网络 ============ -->
                <StackPanel x:Name="secNetwork" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="{x:Bind L.DiagnosticsSectionNetwork, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="{x:Bind L.DiagnosticsNetworkHint, Mode=OneWay}" Style="{StaticResource DiagnosticsHintTextStyle}" />

                    <controls:SettingsCard Header="{x:Bind L.DiagnosticsNetworkProxyTitle, Mode=OneWay}"
                                           Description="{x:Bind ViewModel.ProxyText, Mode=OneWay}" />
                    <InfoBar Severity="Warning"
                             IsOpen="{x:Bind ViewModel.HasProxyWarning, Mode=OneWay}"
                             IsClosable="False"
                             Title="{x:Bind L.DiagnosticsNetworkProxyTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.ProxyWarningText, Mode=OneWay}" />

                    <TextBlock Text="{x:Bind L.DiagnosticsNetworkThrottleTitle, Mode=OneWay}" Style="{StaticResource DiagnosticsSubsectionTitleStyle}" />
                    <TextBlock Text="{x:Bind L.DiagnosticsNetworkEmpty, Mode=OneWay}"
                               Style="{StaticResource DiagnosticsHintTextStyle}"
                               Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(ViewModel.HasNetworkRows), Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NetworkRows, Mode=OneWay}"
                                  ItemTemplate="{StaticResource NetworkRowTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- ============ 启动耗时 ============ -->
                <StackPanel x:Name="secStartup" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="{x:Bind L.DiagnosticsSectionStartup, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="{x:Bind L.DiagnosticsPageSubtitle, Mode=OneWay}" Style="{StaticResource DiagnosticsHintTextStyle}" />

                    <controls:SettingsCard Header="{x:Bind ViewModel.StartupTotalText, Mode=OneWay}"
                                           Description="{x:Bind L.DiagnosticsStartupNote, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind L.DiagnosticsStartupEmpty, Mode=OneWay}"
                               Style="{StaticResource DiagnosticsHintTextStyle}"
                               Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(ViewModel.HasStartupMarks), Mode=OneWay}" />

                    <TextBlock Text="{x:Bind L.DiagnosticsStartupTitle, Mode=OneWay}" Style="{StaticResource DiagnosticsSubsectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.StartupRows, Mode=OneWay}"
                                  ItemTemplate="{StaticResource StartupRowTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,0,14,0"
                Padding="16,10"
                Background="{ThemeResource PdxCardBackgroundBrush}"
                BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasStatusMessage), Mode=OneWay}">
            <TextBlock AutomationProperties.AutomationId="txtDiagStatus"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Page>
