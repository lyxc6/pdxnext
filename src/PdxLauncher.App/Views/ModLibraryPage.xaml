<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdxLauncher.App.Views.ModLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:PdxLauncher.App.Services"
    xmlns:vm="using:PdxLauncher.App.ViewModels"
    xmlns:controls="using:PdxLauncher.App.Controls"
    NavigationCacheMode="Disabled"
    Background="{ThemeResource PdxPageVeilBrush}">

    <!--
        Mod 库页：列出当前游戏的全部 mod（mods 表 + 磁盘上的本地 mod）。
        每行显示缩略图、名称、大小 / 订阅时间、mod 自己声明的支持版本与播放集归属；
        本地 mod、库里状态不是 ready_to_play 的 mod，以及声明的支持版本低于当前游戏版本的 mod
        带三角提示图标，提示内容只讲「支持哪个版本 / 与当前版本对不对得上」。
        行尾三个图标按钮：打开本地文件夹 / 在 Steam 中打开 / 在浏览器中打开（不可用时置灰）。
        所有交互控件都带 AutomationProperties.AutomationId，便于 UI 自动化与无障碍。
    -->
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具条：标题 / 计数 / 搜索 / 排序 / 方向 / 刷新 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind L.ModlibTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.GameTitle, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <AutoSuggestBox Grid.Column="1"
                            x:Name="SearchBox"
                            MinWidth="160"
                            MaxWidth="320"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            QueryIcon="Find"
                            PlaceholderText="{x:Bind L.ModlibSearchPlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.SearchText, Mode=OneWay}"
                            TextChanged="OnSearchTextChanged"
                            QuerySubmitted="OnSearchQuerySubmitted"
                            AutomationProperties.AutomationId="txtModLibrarySearch"
                            AutomationProperties.Name="{x:Bind L.ModlibSearchName, Mode=OneWay}" />

            <controls:PdxDropDown Grid.Column="2"
                                 x:Name="SortBox"
                                 MinWidth="150"
                                 VerticalAlignment="Center"
                                 ItemsSource="{x:Bind ViewModel.SortModes, Mode=OneWay}"
                                 SelectedItem="{x:Bind ViewModel.SelectedSortMode, Mode=OneWay}"
                                 SelectionChanged="OnSortSelectionChanged"
                                 AutomationProperties.AutomationId="cmbModLibrarySort"
                                 AutomationProperties.Name="{x:Bind L.ModlibSortName, Mode=OneWay}" />

            <!-- 排序方向切换：正序 / 倒序共用一个按钮，图标与提示随方向换（code-behind 里维护）。 -->
            <Button Grid.Column="3"
                    x:Name="SortDirectionButton"
                    VerticalAlignment="Center"
                    Click="OnSortDirectionClick"
                    ToolTipService.ToolTip="{x:Bind L.ModlibSortDirectionName, Mode=OneWay}"
                    AutomationProperties.AutomationId="btnModLibrarySortDirection"
                    AutomationProperties.Name="{x:Bind L.ModlibSortDirectionName, Mode=OneWay}">
                <FontIcon x:Name="SortDirectionGlyph" Glyph="&#xE8DD;" FontSize="16" />
            </Button>

            <controls:PdxDropDown Grid.Column="4"
                                 x:Name="SourceBox"
                                 MinWidth="130"
                                 VerticalAlignment="Center"
                                 ItemsSource="{x:Bind ViewModel.SourceFilterModes, Mode=OneWay}"
                                 SelectedItem="{x:Bind ViewModel.SelectedSourceFilter, Mode=OneWay}"
                                 SelectionChanged="OnSourceFilterChanged"
                                 AutomationProperties.AutomationId="cmbModLibrarySource"
                                 AutomationProperties.Name="{x:Bind L.ModlibSourceFilterName, Mode=OneWay}" />

            <StackPanel Grid.Column="5"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <ProgressRing Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              AutomationProperties.AutomationId="ringModLibraryBusy"
                              AutomationProperties.Name="{x:Bind L.CommonLoading, Mode=OneWay}" />
                <!-- 转换专用进度 / 取消：只在本次转换在途时出现；取消按钮不绑 IsEditorEnabled。 -->
                <ProgressRing Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              IsActive="{x:Bind ViewModel.IsConvertToLocalBusy, Mode=OneWay}"
                              AutomationProperties.AutomationId="ringConvertToLocalBusy"
                              AutomationProperties.Name="{x:Bind L.CommonConvertToLocal, Mode=OneWay}" />
                <Button Content="{x:Bind L.CommonCancel, Mode=OneWay}"
                        Click="OnCancelConvertToLocalClick"
                        Visibility="{x:Bind ViewModel.IsConvertToLocalBusy, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind L.CommonCancel, Mode=OneWay}"
                        AutomationProperties.AutomationId="btnCancelConvertToLocal"
                        AutomationProperties.Name="{x:Bind L.CommonCancel, Mode=OneWay}" />
            </StackPanel>

            <Button Grid.Column="6"
                    VerticalAlignment="Center"
                    Click="OnRefreshClick"
                    AutomationProperties.AutomationId="btnRefreshModLibrary"
                    AutomationProperties.Name="{x:Bind L.ModlibRefreshName, Mode=OneWay}">
                <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>
        </Grid>

        <!-- 主体：mod 列表 + 空状态 -->
        <Grid Grid.Row="1">
            <!-- 列表底衬：半透明玻璃面，压住整窗背景图保证行文字对比度 -->
            <Border Background="{ThemeResource PdxCardGlassBrush}" CornerRadius="8" />

            <ListView x:Name="ModList"
                      ItemsSource="{x:Bind ViewModel.Mods, Mode=OneWay}"
                      SelectionMode="None"
                      AutomationProperties.AutomationId="lstModLibrary"
                      AutomationProperties.Name="{x:Bind L.ModlibListName, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModLibraryRowViewModel">
                        <Grid ColumnSpacing="8"
                              Padding="4,8"
                              AutomationProperties.AutomationId="{x:Bind RowAutomationId, Mode=OneTime}"
                              AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"
                              AutomationProperties.HelpText="{x:Bind WarningText, Mode=OneWay}">
                            <!-- 翻译项是页面级动作（对当前列表全部名称生效），菜单打开时按 ViewModel 状态
                                 在 code-behind 里统一设 IsEnabled。 -->
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="OnTranslationMenuOpening">
                                    <MenuFlyoutItem
                                        Text="{x:Bind WorkshopDetailText, Mode=OneWay}"
                                        Click="OnOpenDetailClick"
                                        IsEnabled="{x:Bind HasWorkshopDetail, Mode=OneTime}"
                                        AutomationProperties.AutomationId="menuModLibraryOpenDetail" />
                                    <MenuFlyoutItem
                                        Text="{x:Bind L.ModlibOpenFolder, Mode=OneWay}"
                                        Click="OnOpenFolderClick"
                                        IsEnabled="{x:Bind HasLocalContent, Mode=OneTime}"
                                        AutomationProperties.AutomationId="menuModLibraryOpenFolder" />
                                    <MenuFlyoutItem
                                        Text="{x:Bind L.ModlibOpenSteam, Mode=OneWay}"
                                        Click="OnOpenSteamClick"
                                        IsEnabled="{x:Bind HasWorkshopPage, Mode=OneTime}"
                                        AutomationProperties.AutomationId="menuModLibraryOpenSteam" />
                                    <MenuFlyoutItem
                                        Text="{x:Bind L.ModlibOpenBrowser, Mode=OneWay}"
                                        Click="OnOpenBrowserClick"
                                        IsEnabled="{x:Bind HasWorkshopPage, Mode=OneTime}"
                                        AutomationProperties.AutomationId="menuModLibraryOpenBrowser" />
                                    <MenuFlyoutItem
                                        Text="{x:Bind L.ModlibSteamDownloadName, Mode=OneWay}"
                                        Click="OnSteamDownloadClick"
                                        IsEnabled="{x:Bind CanTriggerSteamDownload, Mode=OneTime}"
                                        AutomationProperties.AutomationId="menuModLibrarySteamDownload" />
                                    <MenuFlyoutItem
                                        Text="{x:Bind SteamDisableActionText, Mode=OneWay}"
                                        Click="OnSteamDisableClick"
                                        IsEnabled="{x:Bind HasWorkshopPage, Mode=OneTime}"
                                        AutomationProperties.AutomationId="menuModLibrarySteamDisable" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Text="{x:Bind L.CommonPageRefresh, Mode=OneWay}"
                                        Click="OnRefreshClick"
                                        AutomationProperties.AutomationId="menuModLibraryPageRefresh" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Text="{x:Bind L.CommonConvertToLocal, Mode=OneWay}"
                                        Click="OnConvertToLocalClick"
                                        AutomationProperties.AutomationId="menuModLibraryConvertToLocal"
                                        IsEnabled="{x:Bind CanConvertToLocal, Mode=OneWay}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Text="{x:Bind L.CommonTranslationRetry, Mode=OneWay}"
                                        Click="OnTranslationRetryClick"
                                        AutomationProperties.AutomationId="menuModLibraryTranslationRetry" />
                                    <MenuFlyoutItem
                                        Text="{x:Bind L.CommonTranslationRefresh, Mode=OneWay}"
                                        Click="OnTranslationRefreshClick"
                                        AutomationProperties.AutomationId="menuModLibraryTranslationRefresh" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 缩略图：有图显示图片，没有则用图标占位 -->
                            <Border Grid.Column="0"
                                    Width="{x:Bind ThumbnailSize, Mode=OneTime}"
                                    Height="{x:Bind ThumbnailSize, Mode=OneTime}"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Image Source="{x:Bind svc:XamlImage.FromPath(ThumbnailPath, 72), Mode=OneWay}"
                                           Stretch="Uniform"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(HasThumbnail), Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE8B9;"
                                              FontSize="20"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(HasThumbnail), Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- 来源徽标：本地 / 订阅。两个 Border 各自绑一种来源，靠可见性切换，
                                         比在代码里拼画刷更省事，也天然跟着主题字典走。 -->
                                    <Border VerticalAlignment="Center"
                                            Padding="8,4"
                                            CornerRadius="4"
                                            Background="{ThemeResource PdxOriginLocalBackgroundBrush}"
                                            Visibility="{x:Bind svc:XamlVisibility.FromBool(IsLocalOrigin), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind OriginText, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource PdxOriginLocalForegroundBrush}" />
                                    </Border>
                                    <Border VerticalAlignment="Center"
                                            Padding="8,4"
                                            CornerRadius="4"
                                            Background="{ThemeResource PdxOriginSubscribedBackgroundBrush}"
                                            Visibility="{x:Bind svc:XamlVisibility.FromBool(IsSubscribedOrigin), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind OriginText, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource PdxOriginSubscribedForegroundBrush}" />
                                    </Border>
                                </StackPanel>
                                <!-- 译名：原文与译文同显，译文在标题下方的描边框里（决策：不做二选一切换；不加「译文」标题）。
                                     HorizontalAlignment=Left 让框只包住译文本身（纵向 StackPanel 里默认 Stretch 会通栏拉满），
                                     译文过长时仍按可用宽度省略号收尾。 -->
                                <Border Margin="0,8,0,0"
                                        Padding="8,4"
                                        HorizontalAlignment="Left"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Visibility="{x:Bind svc:XamlVisibility.FromString(TranslatedName), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind TranslatedName, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <TextBlock Text="{x:Bind SubtitleText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind svc:XamlVisibility.FromString(SubtitleText), Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;"
                                          FontSize="14"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          ToolTipService.ToolTip="{x:Bind WarningText, Mode=OneWay}"
                                          AutomationProperties.Name="{x:Bind L.ModlibWarningName, Mode=OneWay}"
                                          AutomationProperties.HelpText="{x:Bind WarningText, Mode=OneWay}"
                                          Visibility="{x:Bind svc:XamlVisibility.FromBool(HasWarning), Mode=OneTime}" />
                                <TextBlock Text="{x:Bind ModVersionText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind ModVersionText, Mode=OneWay}"
                                           AutomationProperties.AutomationId="{x:Bind ModVersionAutomationId, Mode=OneTime}"
                                           AutomationProperties.Name="{x:Bind L.ModlibModVersionName, Mode=OneWay}"
                                           Visibility="{x:Bind svc:XamlVisibility.FromString(ModVersionText), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind SupportedVersionText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind SupportedVersionText, Mode=OneWay}"
                                           AutomationProperties.AutomationId="{x:Bind VersionAutomationId, Mode=OneTime}"
                                           AutomationProperties.Name="{x:Bind L.ModlibSupportedVersionName, Mode=OneWay}"
                                           Visibility="{x:Bind svc:XamlVisibility.FromString(SupportedVersionText), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind VersionUndeclaredText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind VersionUndeclaredHint, Mode=OneWay}"
                                           AutomationProperties.Name="{x:Bind VersionUndeclaredHint, Mode=OneWay}"
                                           Visibility="{x:Bind svc:XamlVisibility.FromString(VersionUndeclaredText), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind PlaySetText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           AutomationProperties.Name="{x:Bind L.ModlibPlaySetName, Mode=OneWay}"
                                           Visibility="{x:Bind svc:XamlVisibility.FromString(PlaySetText), Mode=OneWay}" />

                                <!-- Steam 侧真实状态：下载中 / 需要更新 / 已安装 / 本地禁用。
                                     数据来自 steam-host 子进程的一次整库查询，拿不到就整块不显示。 -->
                                <Border Padding="8,4"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        AutomationProperties.AutomationId="{x:Bind SteamStateAutomationId, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind L.ModlibSteamStateName, Mode=OneWay}"
                                        AutomationProperties.HelpText="{x:Bind SteamStateBadgeText, Mode=OneWay}"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ShowSteamStateBadge), Mode=OneTime}">
                                    <TextBlock Text="{x:Bind SteamStateBadgeText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>

                                <!-- 行操作：四个图标按钮，一个动作一个按钮，不用再展开菜单 -->
                                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                    <Button Width="32"
                                            Height="32"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnOpenDetailClick"
                                            IsEnabled="{x:Bind HasWorkshopDetail, Mode=OneTime}"
                                            ToolTipService.ToolTip="{x:Bind WorkshopDetailText, Mode=OneWay}"
                                            AutomationProperties.AutomationId="{x:Bind WorkshopDetailAutomationId, Mode=OneTime}"
                                            AutomationProperties.Name="{x:Bind WorkshopDetailText, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                                    </Button>
                                    <Button Width="32"
                                            Height="32"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnOpenFolderClick"
                                            IsEnabled="{x:Bind HasLocalContent, Mode=OneTime}"
                                            ToolTipService.ToolTip="{x:Bind L.ModlibOpenFolder, Mode=OneWay}"
                                            AutomationProperties.AutomationId="{x:Bind OpenFolderAutomationId, Mode=OneTime}"
                                            AutomationProperties.Name="{x:Bind L.ModlibOpenFolder, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                    </Button>
                                    <Button Width="32"
                                            Height="32"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnOpenSteamClick"
                                            IsEnabled="{x:Bind HasWorkshopPage, Mode=OneTime}"
                                            ToolTipService.ToolTip="{x:Bind L.ModlibOpenSteam, Mode=OneWay}"
                                            AutomationProperties.AutomationId="{x:Bind OpenSteamAutomationId, Mode=OneTime}"
                                            AutomationProperties.Name="{x:Bind L.ModlibOpenSteam, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="16" />
                                    </Button>
                                    <Button Width="32"
                                            Height="32"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnOpenBrowserClick"
                                            IsEnabled="{x:Bind HasWorkshopPage, Mode=OneTime}"
                                            ToolTipService.ToolTip="{x:Bind L.ModlibOpenBrowser, Mode=OneWay}"
                                            AutomationProperties.AutomationId="{x:Bind OpenBrowserAutomationId, Mode=OneTime}"
                                            AutomationProperties.Name="{x:Bind L.ModlibOpenBrowser, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE774;" FontSize="16" />
                                    </Button>

                                    <!-- 让 Steam 立刻下载这条（工坊条目 + 尚未安装 + 不在下载中） -->
                                    <Button Width="32"
                                            Height="32"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnSteamDownloadClick"
                                            IsEnabled="{x:Bind CanTriggerSteamDownload, Mode=OneTime}"
                                            ToolTipService.ToolTip="{x:Bind L.ModlibSteamDownloadName, Mode=OneWay}"
                                            AutomationProperties.AutomationId="{x:Bind SteamDownloadAutomationId, Mode=OneTime}"
                                            AutomationProperties.Name="{x:Bind L.ModlibSteamDownloadName, Mode=OneWay}"
                                            Visibility="{x:Bind svc:XamlVisibility.FromBool(HasWorkshopPage), Mode=OneTime}">
                                        <FontIcon Glyph="&#xE896;" FontSize="16" />
                                    </Button>

                                    <!-- 在 Steam 里本地禁用 / 解除禁用（订阅保留，只是游戏不加载） -->
                                    <Button Width="32"
                                            Height="32"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnSteamDisableClick"
                                            ToolTipService.ToolTip="{x:Bind SteamDisableActionText, Mode=OneWay}"
                                            AutomationProperties.AutomationId="{x:Bind SteamDisableAutomationId, Mode=OneTime}"
                                            AutomationProperties.Name="{x:Bind SteamDisableActionText, Mode=OneWay}"
                                            Visibility="{x:Bind svc:XamlVisibility.FromBool(HasWorkshopPage), Mode=OneTime}">
                                        <FontIcon Glyph="&#xE8D8;" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态：未选游戏 / 该游戏没有 mod -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowEmptyState), Mode=OneWay}">
                <TextBlock Text="{x:Bind L.ModlibNoGameHint, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowNoGameHint), Mode=OneWay}"
                           AutomationProperties.AutomationId="txtModLibraryNoGame"
                           AutomationProperties.Name="{x:Bind L.ModlibNoGameName, Mode=OneWay}" />
                <TextBlock Text="{x:Bind L.ModlibNoModsHint, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowNoModsHint), Mode=OneWay}"
                           AutomationProperties.AutomationId="txtModLibraryNoMods"
                           AutomationProperties.Name="{x:Bind L.ModlibNoModsName, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- 状态栏：平时显示加载 / 筛选计数，译名整批失败时显示原因；重试入口在 mod 行的右键菜单里。 -->
        <Border Grid.Row="2"
                Padding="12,8"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="txtModLibraryStatus"
                           AutomationProperties.Name="{x:Bind L.ModlibStatusName, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
