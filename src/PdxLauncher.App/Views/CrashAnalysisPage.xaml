<Page
    x:Class="PdxLauncher.App.Views.CrashAnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PdxLauncher.App.Controls"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:svc="using:PdxLauncher.App.Services"
    xmlns:vm="using:PdxLauncher.App.ViewModels"
    NavigationCacheMode="Disabled"
    Background="{ThemeResource PdxPageVeilBrush}">

    <Page.Resources>
        <Style x:Key="CrashHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4,0,4,8" />
        </Style>
        <Style x:Key="CrashSubsectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <DataTemplate x:Key="CrashSummaryRowTemplate" x:DataType="vm:CrashSummaryRowViewModel">
            <ct:SettingsCard Header="{x:Bind Title}"
                             Description="{x:Bind Detail}"
                             Background="{ThemeResource PdxCardBackgroundBrush}"
                             BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                             BorderThickness="1"
                             CornerRadius="8"
                             MinHeight="56"
                             Padding="16,12"
                             IsClickEnabled="False"
                             Margin="0,0,0,8">
                <TextBlock Text="{x:Bind Value}"
                           AutomationProperties.AutomationId="{x:Bind AutomationId}"
                           ToolTipService.ToolTip="{x:Bind Value}"
                           MaxWidth="320"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </ct:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="CrashFindingRowTemplate" x:DataType="vm:CrashFindingRowViewModel">
            <Border Background="{ThemeResource PdxCardBackgroundBrush}"
                    BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,8"
                    AutomationProperties.AutomationId="{x:Bind AutomationId}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE7BA;"
                                  FontSize="18"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                  Visibility="{x:Bind svc:XamlVisibility.FromBool(IsCritical)}" />
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE7BA;"
                                  FontSize="18"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                  Visibility="{x:Bind svc:XamlVisibility.FromBool(IsWarning)}" />
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE946;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind svc:XamlVisibility.FromBool(IsInfo)}" />

                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Title}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind BadgeText}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind FixText}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Expander Header="{x:Bind EvidenceHeader}"
                              Visibility="{x:Bind svc:XamlVisibility.FromBool(HasEvidence)}"
                              IsExpanded="{x:Bind ExpandByDefault}"
                              HorizontalAlignment="Stretch">
                        <TextBox Text="{x:Bind EvidenceText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 IsSpellCheckEnabled="False"
                                 TextWrapping="NoWrap"
                                 FontFamily="Cascadia Mono, Consolas"
                                 MinHeight="72"
                                 MaxHeight="220"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Padding="12,8" />
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CrashBundleRowTemplate" x:DataType="vm:CrashBundleRowViewModel">
            <ct:SettingsCard Header="{x:Bind Title}"
                             Description="{x:Bind Detail}"
                             Background="{ThemeResource PdxCardBackgroundBrush}"
                             BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                             BorderThickness="1"
                             CornerRadius="8"
                             MinHeight="56"
                             Padding="16,12"
                             IsClickEnabled="False"
                             Margin="0,0,0,8">
                <Button Content="{x:Bind OpenText}"
                        Tag="{x:Bind Path}"
                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                        Click="OnOpenBundleClick" />
            </ct:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="CrashModRowTemplate" x:DataType="vm:CrashModRowViewModel">
            <ct:SettingsCard Header="{x:Bind Name}"
                             Description="{x:Bind Detail}"
                             ToolTipService.ToolTip="{x:Bind Path}"
                             Background="{ThemeResource PdxCardBackgroundBrush}"
                             BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                             BorderThickness="1"
                             CornerRadius="8"
                             MinHeight="56"
                             Width="320"
                             Padding="16,12"
                             IsClickEnabled="False"
                             AutomationProperties.AutomationId="{x:Bind AutomationId}" />
        </DataTemplate>

        <DataTemplate x:Key="CrashLaunchRowTemplate" x:DataType="vm:CrashLaunchRowViewModel">
            <ct:SettingsCard Header="{x:Bind Title}"
                             Description="{x:Bind Detail}"
                             Background="{ThemeResource PdxCardBackgroundBrush}"
                             BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                             BorderThickness="1"
                             CornerRadius="8"
                             MinHeight="56"
                             Padding="16,12"
                             IsClickEnabled="False"
                             Margin="0,0,0,8">
                <TextBlock Text="{x:Bind Value}"
                           AutomationProperties.AutomationId="{x:Bind AutomationId}"
                           MaxWidth="360"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </ct:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="CrashGroupRowTemplate" x:DataType="vm:CrashLogGroupRowViewModel">
            <ct:SettingsCard Header="{x:Bind Title}"
                             Description="{x:Bind Detail}"
                             ToolTipService.ToolTip="{x:Bind Sample}"
                             Background="{ThemeResource PdxCardBackgroundBrush}"
                             BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                             BorderThickness="1"
                             CornerRadius="8"
                             MinHeight="52"
                             Padding="16,12"
                             IsClickEnabled="False"
                             Margin="0,0,0,4"
                             AutomationProperties.AutomationId="{x:Bind AutomationId}" />
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20"
          RowSpacing="12"
          ColumnSpacing="16"
          AutomationProperties.AutomationId="pageCrashAnalysis">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView Grid.Row="0"
                        Grid.Column="0"
                        x:Name="navCrashSections"
                        AutomationProperties.AutomationId="lstCrashSections"
                        AutomationProperties.Name="{x:Bind L.CrashPageTitle, Mode=OneWay}"
                        Background="Transparent"
                        PaneDisplayMode="Left"
                        OpenPaneLength="216"
                        IsPaneOpen="True"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="OnSectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel Spacing="4" Margin="0,4,0,0">
                    <TextBlock Text="{x:Bind L.CrashPageTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind L.CrashPageSubtitle, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem AutomationProperties.AutomationId="navCrashOverview"
                                    Tag="0"
                                    Content="{x:Bind L.CrashSectionOverview, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="View" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navCrashCrashes"
                                    Tag="1"
                                    Content="{x:Bind L.CrashSectionCrashes, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Important" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navCrashLogs"
                                    Tag="2"
                                    Content="{x:Bind L.CrashSectionLogs, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="navCrashLaunch"
                                    Tag="3"
                                    Content="{x:Bind L.CrashSectionLaunch, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>

        <Grid Grid.Row="0" Grid.Column="1">
            <ScrollViewer x:Name="crashSectionScroller"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" Margin="0,0,16,0">

                    <!-- ============ 诊断结论 ============ -->
                    <StackPanel x:Name="secOverview" Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind L.CrashSectionOverview, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,4,0,0" />
                                <TextBlock Text="{x:Bind ViewModel.LastAnalysisText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing Width="16" Height="16"
                                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsBusy), Mode=OneWay}" />
                                <Button AutomationProperties.AutomationId="btnCrashRefresh"
                                        Content="{x:Bind L.CrashActionRefresh, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.HasGame, Mode=OneWay}"
                                        Click="OnRefreshClick" />
                                <Button AutomationProperties.AutomationId="btnCrashCopy"
                                        Content="{x:Bind L.CrashActionCopy, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.HasReport, Mode=OneWay}"
                                        Click="OnCopyReportClick" />
                            </StackPanel>
                        </Grid>

                        <controls:PdxWrapPanel Spacing="8">
                            <Button AutomationProperties.AutomationId="btnCrashOpenCrash"
                                    Content="{x:Bind L.CrashActionOpenCrash, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.HasCrashes, Mode=OneWay}"
                                    Click="OnOpenCrashFolderClick" />
                            <Button AutomationProperties.AutomationId="btnCrashOpenLogs"
                                    Content="{x:Bind L.CrashActionOpenLogs, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.HasLogFiles, Mode=OneWay}"
                                    Click="OnOpenLogFolderClick" />
                        </controls:PdxWrapPanel>

                        <InfoBar x:Name="infCrashCritical"
                                 AutomationProperties.AutomationId="infCrashCritical"
                                 Severity="Error"
                                 IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.HasCritical, Mode=OneWay}"
                                 Title="{x:Bind ViewModel.VerdictTitle, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.VerdictMessage, Mode=OneWay}" />
                        <InfoBar x:Name="infCrashWarning"
                                 AutomationProperties.AutomationId="infCrashWarning"
                                 Severity="Warning"
                                 IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                                 Title="{x:Bind ViewModel.VerdictTitle, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.VerdictMessage, Mode=OneWay}" />
                        <InfoBar x:Name="infCrashClear"
                                 AutomationProperties.AutomationId="infCrashClear"
                                 Severity="Success"
                                 IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.HasClear, Mode=OneWay}"
                                 Title="{x:Bind ViewModel.VerdictTitle, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.VerdictMessage, Mode=OneWay}" />
                        <InfoBar x:Name="infCrashNoGame"
                                 AutomationProperties.AutomationId="infCrashNoGame"
                                 Severity="Informational"
                                 IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.HasNoGame, Mode=OneWay}"
                                 Title="{x:Bind L.CrashOverviewNoGame, Mode=OneWay}" />
                        <InfoBar x:Name="infCrashNoReport"
                                 AutomationProperties.AutomationId="infCrashNoReport"
                                 Severity="Warning"
                                 IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.HasNoReport, Mode=OneWay}"
                                 Title="{x:Bind L.CrashOverviewNoReport, Mode=OneWay}" />

                        <TextBlock Text="{x:Bind L.CrashOverviewSummaryTitle, Mode=OneWay}" Style="{StaticResource CrashSubsectionTitleStyle}" />
                        <ItemsControl x:Name="lstCrashSummary"
                                      AutomationProperties.AutomationId="lstCrashSummary"
                                      ItemsSource="{x:Bind ViewModel.SummaryRows, Mode=OneWay}"
                                      ItemTemplate="{StaticResource CrashSummaryRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="{x:Bind L.CrashOverviewFindingsTitle, Mode=OneWay}" Style="{StaticResource CrashSubsectionTitleStyle}" />
                        <TextBlock Text="{x:Bind L.CrashOverviewFindingsEmpty, Mode=OneWay}"
                                   Style="{StaticResource CrashHintTextStyle}"
                                   Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(ViewModel.HasFindings), Mode=OneWay}" />
                        <ItemsControl x:Name="lstCrashFindings"
                                      AutomationProperties.AutomationId="lstCrashFindings"
                                      ItemsSource="{x:Bind ViewModel.Findings, Mode=OneWay}"
                                      ItemTemplate="{StaticResource CrashFindingRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Expander Header="{x:Bind L.CrashOverviewModsTitle, Mode=OneWay}"
                                  AutomationProperties.AutomationId="expCrashMods"
                                  IsExpanded="False"
                                  HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.ModListHint, Mode=OneWay}"
                                           Style="{StaticResource CrashHintTextStyle}"
                                           Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.ModListHint), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind L.CrashOverviewModsEmpty, Mode=OneWay}"
                                           Style="{StaticResource CrashHintTextStyle}"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(ViewModel.HasMods), Mode=OneWay}" />
                                <ItemsControl x:Name="lstCrashMods"
                                              AutomationProperties.AutomationId="lstCrashMods"
                                              ItemsSource="{x:Bind ViewModel.Mods, Mode=OneWay}"
                                              ItemTemplate="{StaticResource CrashModRowTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:PdxWrapPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- ============ 崩溃记录 ============ -->
                    <StackPanel x:Name="secCrashes" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind L.CrashSectionCrashes, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,4,0,0" />
                        <TextBlock Text="{x:Bind L.CrashCrashesHint, Mode=OneWay}" Style="{StaticResource CrashHintTextStyle}" />
                        <TextBlock Text="{x:Bind L.CrashCrashesEmpty, Mode=OneWay}"
                                   Style="{StaticResource CrashHintTextStyle}"
                                   Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(ViewModel.HasCrashes), Mode=OneWay}" />
                        <ItemsControl x:Name="lstCrashBundles"
                                      AutomationProperties.AutomationId="lstCrashBundles"
                                      ItemsSource="{x:Bind ViewModel.Crashes, Mode=OneWay}"
                                      ItemTemplate="{StaticResource CrashBundleRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ============ 启动链路 ============ -->
                    <StackPanel x:Name="secLaunch" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind L.CrashSectionLaunch, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,4,0,0" />
                        <TextBlock Text="{x:Bind L.CrashLaunchHint, Mode=OneWay}" Style="{StaticResource CrashHintTextStyle}" />
                        <TextBlock Text="{x:Bind L.CrashLaunchEmpty, Mode=OneWay}"
                                   Style="{StaticResource CrashHintTextStyle}"
                                   Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(ViewModel.HasLaunchRows), Mode=OneWay}" />
                        <ItemsControl x:Name="lstCrashLaunch"
                                      AutomationProperties.AutomationId="lstCrashLaunch"
                                      ItemsSource="{x:Bind ViewModel.LaunchRows, Mode=OneWay}"
                                      ItemTemplate="{StaticResource CrashLaunchRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 日志证据 ============ -->
            <Grid x:Name="secLogs"
                  Visibility="Collapsed"
                  Margin="0,0,16,0"
                  RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind L.CrashSectionLogs, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="{x:Bind L.CrashLogsHint, Mode=OneWay}" Style="{StaticResource CrashHintTextStyle}" />

                    <controls:PdxWrapPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind L.CrashLogsFileLabel, Mode=OneWay}" VerticalAlignment="Center" />
                            <controls:PdxDropDown x:Name="cmbCrashLogFile"
                                                  AutomationProperties.AutomationId="cmbCrashLogFile"
                                                  AutomationProperties.Name="{x:Bind L.CrashLogsFileLabel, Mode=OneWay}"
                                                  Width="320"
                                                  MinHeight="32"
                                                  ItemsSource="{x:Bind ViewModel.LogFiles, Mode=OneWay}"
                                                  DisplayMemberPath="DisplayText"
                                                  SelectedItem="{x:Bind ViewModel.SelectedLogFile, Mode=TwoWay}"
                                                  PlaceholderText="{x:Bind L.CrashLogsFileEmpty, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind L.CrashLogsOnlyErrors, Mode=OneWay}" VerticalAlignment="Center" />
                            <ToggleSwitch MinWidth="0"
                                          AutomationProperties.AutomationId="tglCrashOnlyErrors"
                                          AutomationProperties.Name="{x:Bind L.CrashLogsOnlyErrorsName, Mode=OneWay}"
                                          OffContent=""
                                          OnContent=""
                                          IsOn="{x:Bind ViewModel.OnlyErrors, Mode=TwoWay}" />
                        </StackPanel>
                    </controls:PdxWrapPanel>

                    <TextBlock Text="{x:Bind ViewModel.LogSummaryText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind L.CrashLogsFileEmpty, Mode=OneWay}"
                               Style="{StaticResource CrashHintTextStyle}"
                               Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(ViewModel.HasLogFiles), Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="8">
                    <TextBlock Text="{x:Bind L.CrashLogsGroupsTitle, Mode=OneWay}" Style="{StaticResource CrashSubsectionTitleStyle}" />
                    <TextBlock Text="{x:Bind L.CrashLogsGroupsEmpty, Mode=OneWay}"
                               Style="{StaticResource CrashHintTextStyle}"
                               Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(ViewModel.HasGroups), Mode=OneWay}" />
                    <ScrollViewer MaxHeight="180"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasGroups), Mode=OneWay}">
                        <ItemsControl x:Name="lstCrashGroups"
                                      AutomationProperties.AutomationId="lstCrashGroups"
                                      ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                                      ItemTemplate="{StaticResource CrashGroupRowTemplate}" />
                    </ScrollViewer>
                </StackPanel>

                <Grid Grid.Row="2" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind L.CrashLogsTailTitle, Mode=OneWay}" Style="{StaticResource CrashSubsectionTitleStyle}" />
                    <TextBox Grid.Row="1"
                             x:Name="txtCrashLogTail"
                             AutomationProperties.AutomationId="txtCrashLogTail"
                             Text="{x:Bind ViewModel.LogTailText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             IsSpellCheckEnabled="False"
                             FontFamily="Cascadia Mono, Consolas"
                             MinHeight="160"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Padding="12,8" />
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,0,16,0"
                Padding="16,12"
                Background="{ThemeResource PdxCardBackgroundBrush}"
                BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasStatusMessage), Mode=OneWay}">
            <TextBlock AutomationProperties.AutomationId="txtCrashStatus"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Page>
