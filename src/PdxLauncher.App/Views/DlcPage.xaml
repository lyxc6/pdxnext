<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdxLauncher.App.Views.DlcPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:PdxLauncher.App.Services"
    xmlns:vm="using:PdxLauncher.App.ViewModels"
    NavigationCacheMode="Required"
    Background="{ThemeResource PdxPageVeilBrush}">

    <!--
        DLC 页：以纵向列表列出当前游戏磁盘上真实的 DLC。
        布局对齐官方启动器：左侧固定尺寸缩略图（208x117，绝不随文字缩放），
        右侧标题 + 两行简介，最右是启用开关。
        保存时写 playsets_dlcs（sqlite）并同步重写加载文件（disabledDLC / disabled_dlcs）。
        没有激活播放集时全部 DLC 视为启用（与官方启动器一致），此时保存会被拒绝并提示。
    -->
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具条 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="DLC" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.GameTitle, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.CountsText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{x:Bind L.DlcEnableAll, Mode=OneWay}"
                        Click="OnEnableAllClick"
                        AutomationProperties.AutomationId="btnEnableAllDlcs"
                        AutomationProperties.Name="{x:Bind L.DlcEnableAllName, Mode=OneWay}" />
                <Button Content="{x:Bind L.DlcDisableAll, Mode=OneWay}"
                        Click="OnDisableAllClick"
                        AutomationProperties.AutomationId="btnDisableAllDlcs"
                        AutomationProperties.Name="{x:Bind L.DlcDisableAllName, Mode=OneWay}" />
                <Button Content="{x:Bind L.CommonSave, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSaveClick"
                        AutomationProperties.AutomationId="btnSaveDlcs"
                        AutomationProperties.Name="{x:Bind L.DlcSaveName, Mode=OneWay}" />
                <ProgressRing Width="20"
                              Height="20"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              AutomationProperties.AutomationId="ringDlcBusy"
                              AutomationProperties.Name="{x:Bind L.CommonLoading, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- 列表底衬：半透明玻璃面，把行文字从背景图上托起来，避免与插图直接叠在一起 -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource PdxCardGlassBrush}"
            CornerRadius="8" />

        <!-- DLC 列表（保留 gvDlcs 这个 AutomationId：UI 测试按它定位列表） -->
        <ListView Grid.Row="1"
                  x:Name="DlcList"
                  ItemsSource="{x:Bind ViewModel.Dlcs, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  AutomationProperties.AutomationId="gvDlcs"
                  AutomationProperties.Name="{x:Bind L.DlcListName, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DlcRowViewModel">
                    <Grid Padding="12,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="208" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 缩略图：宽高写死在 Border 上，文字再长也只会被裁剪，不会把图压小 -->
                        <Border Grid.Column="0"
                                Width="208"
                                Height="117"
                                Background="{ThemeResource PdxPlaceholderBackgroundBrush}"
                                BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <FontIcon Glyph="&#xE8B9;"
                                          FontSize="28"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          AutomationProperties.AccessibilityView="Raw"
                                          Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(HasThumbnail), Mode=OneWay}" />
                                <Image Source="{x:Bind svc:XamlImage.FromPath(ThumbnailPath), Mode=OneTime}"
                                       Stretch="UniformToFill"
                                       AutomationProperties.Name="{x:Bind DisplayName, Mode=OneTime}" />
                            </Grid>
                        </Border>

                        <!-- 标题 + 简介：简介来自描述文件（V3）或联网补全（CK3/Stellaris），没有时整行折叠 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       MaxWidth="880"
                                       HorizontalAlignment="Left"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind DescriptionToolTip, Mode=OneWay}"
                                       AutomationProperties.AutomationId="{x:Bind DescriptionAutomationId, Mode=OneTime}"
                                       AutomationProperties.Name="{x:Bind L.DlcDescriptionName, Mode=OneWay}"
                                       Visibility="{x:Bind svc:XamlVisibility.FromBool(HasDescription), Mode=OneWay}" />
                        </StackPanel>

                        <!--
                            pops_id 为空的 DLC 无法写进 content_load.json 的 disabledDLC
                            （官方 app.asar 的 X2.mapPopsId 会丢弃空 id），所以这里把开关置灰。
                        -->
                        <ToggleSwitch Grid.Column="2"
                                      VerticalAlignment="Center"
                                      IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                      IsEnabled="{x:Bind CanBeDisabled, Mode=OneWay}"
                                      OnContent="{x:Bind L.CommonEnable, Mode=OneWay}"
                                      OffContent="{x:Bind L.CommonDisable, Mode=OneWay}"
                                      ToolTipService.ToolTip="{x:Bind ToggleToolTip, Mode=OneWay}"
                                      AutomationProperties.AutomationId="{x:Bind ToggleAutomationId, Mode=OneTime}"
                                      AutomationProperties.Name="{x:Bind DisplayName, Mode=OneTime}"
                                      AutomationProperties.HelpText="{x:Bind ToggleToolTip, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 状态栏 -->
        <Border Grid.Row="2"
                Padding="10,6"
                CornerRadius="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="txtDlcStatus"
                       AutomationProperties.Name="{x:Bind L.DlcStatusName, Mode=OneWay}" />
        </Border>
    </Grid>
</Page>
