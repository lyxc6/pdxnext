<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdxLauncher.App.Views.WorkshopDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PdxLauncher.App.Controls"
    xmlns:svc="using:PdxLauncher.App.Services"
    xmlns:vm="using:PdxLauncher.App.ViewModels"
    Background="{ThemeResource PdxPageVeilBrush}">

    <!--
        创意工坊 mod 详情子页：从列表点一行进来，整页滚动显示完整内容
        （封面 / 作者 / 评分订阅收藏浏览 / Markdown 简介 / 图片墙 / 更新日志 / 依赖 / 外链 / 评论区）。
        以前这些挤在一个 MaxHeight=560 的 ContentDialog 里，长描述看不全。
        左栏选中项保持「创意工坊」，页头的返回按钮负责退回列表。
    -->
    <Grid>
        <Grid Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 页头：返回 / 标题 / 作者 / 打开方式 -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="btnWorkshopDetailBack"
                        Width="36"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="OnBackClick"
                        ToolTipService.ToolTip="{x:Bind L.WorkshopDetailBack, Mode=OneWay}"
                        AutomationProperties.AutomationId="btnWorkshopDetailBack"
                        AutomationProperties.Name="{x:Bind L.WorkshopDetailBack, Mode=OneWay}">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="txtWorkshopDetailTitle" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.SourceLabel), Mode=OneWay}" />
                        <!-- 作者：有主页时是可点的超链接（跳到 Steam 个人页） -->
                        <HyperlinkButton x:Name="btnWorkshopDetailAuthor"
                                         Padding="0"
                                         VerticalAlignment="Center"
                                         Click="OnAuthorClick"
                                         IsEnabled="{x:Bind ViewModel.HasAuthorProfile, Mode=OneWay}"
                                         Content="{x:Bind ViewModel.AuthorText, Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind L.WorkshopDetailAuthorHint, Mode=OneWay}"
                                         AutomationProperties.AutomationId="btnWorkshopDetailAuthor"
                                         AutomationProperties.Name="{x:Bind ViewModel.AuthorText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        x:Name="btnWorkshopDetailBrowser"
                        Width="36"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="OnOpenBrowserClick"
                        IsEnabled="{x:Bind ViewModel.HasWebUrl, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind L.WorkshopOpenBrowser, Mode=OneWay}"
                        AutomationProperties.AutomationId="btnWorkshopDetailBrowser"
                        AutomationProperties.Name="{x:Bind L.WorkshopOpenBrowserName, Mode=OneWay}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                </Button>

                <Button Grid.Column="3"
                        x:Name="btnWorkshopDetailSteam"
                        Width="36"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="OnOpenSteamClick"
                        IsEnabled="{x:Bind ViewModel.CanOpenSteam, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind L.WorkshopOpenSteam, Mode=OneWay}"
                        AutomationProperties.AutomationId="btnWorkshopDetailSteam"
                        AutomationProperties.Name="{x:Bind L.WorkshopOpenSteamName, Mode=OneWay}">
                    <FontIcon Glyph="&#xE7FC;" FontSize="14" />
                </Button>
            </Grid>

            <!-- 正文：整页纵向滚动 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          AutomationProperties.AutomationId="scrollWorkshopDetail">
                <StackPanel Spacing="12">

                    <!-- 概览卡：封面 + 元信息 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="320"
                                    Height="180"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <FontIcon Glyph="&#xE8B9;"
                                             FontSize="32"
                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(ViewModel.HasCover), Mode=OneWay}" />
                                    <Image Source="{x:Bind svc:XamlImage.FromPath(ViewModel.CoverPath), Mode=OneWay}"
                                           Stretch="UniformToFill"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCover), Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.MetaText, Mode=OneWay}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.MetaText), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.CreatedText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCreated), Mode=OneWay}" />
                                <Border HorizontalAlignment="Left"
                                        Padding="8,3"
                                        CornerRadius="4"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowInstalled), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind L.WorkshopDetailInstalled, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.TagsText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasTags), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 读取中 -->
                    <Border Padding="16"
                            CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsLoading), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="18" Height="18" />
                            <TextBlock Text="{x:Bind L.WorkshopDetailLoading, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- 失败：原因 + 重试 -->
                    <Border Padding="16"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasError), Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="txtWorkshopDetailError" />
                            <Button Content="{x:Bind L.WorkshopDetailRetry, Mode=OneWay}"
                                    Click="OnRetryClick"
                                    AutomationProperties.AutomationId="btnWorkshopDetailRetry" />
                        </StackPanel>
                    </Border>

                    <!-- 正文来自缓存（断网兜底） -->
                    <Border Padding="12"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCachedHint), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.CachedHint, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- 简介：Markdown / HTML 富文本渲染 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind L.WorkshopDetailDescription, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ctl:MarkdownView Markdown="{x:Bind ViewModel.DescriptionDocument, Mode=OneWay}"
                                              LinkRequested="OnMarkdownLinkRequested"
                                              ImageRequested="OnMarkdownImageRequested"
                                              AutomationProperties.AutomationId="txtWorkshopDetailDescription"
                                              AutomationProperties.Name="{x:Bind ViewModel.DescriptionText, Mode=OneWay}"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasDescription), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind L.WorkshopDetailNoDescription, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowNoDescription), Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- 图片墙（PDX 截图 + 描述配图），点开进入全屏查看器 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasScreenshots), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind L.WorkshopDetailScreenshotsTitle, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsLoadingScreenshots), Mode=OneWay}">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingScreenshots, Mode=OneWay}"
                                              Width="16"
                                              Height="16" />
                                <TextBlock Text="{x:Bind L.WorkshopDetailScreenshotsLoading, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- 图片墙：横向缩略图条，点任意一张进全屏查看器（可在查看器里翻页/缩放）。 -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalScrollMode="Disabled">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Screenshots, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WorkshopScreenshotViewModel">
                                            <Button Width="200"
                                                    Height="120"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnScreenshotClick"
                                                    AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                    ToolTipService.ToolTip="{x:Bind L.WorkshopDetailViewImage, Mode=OneWay}">
                                                <Border CornerRadius="8"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8B9;"
                                                                 FontSize="32"
                                                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(HasPath), Mode=OneWay}" />
                                                        <Image Source="{x:Bind svc:XamlImage.FromPath(Path), Mode=OneWay}"
                                                               Stretch="Uniform"
                                                               Margin="6"
                                                               Visibility="{x:Bind svc:XamlVisibility.FromBool(HasPath), Mode=OneWay}" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- 前置依赖（PDX 有） -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasDependencies), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind L.WorkshopDetailDependencies, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DependencySummary, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="txtWorkshopDependencySummary"
                                       Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasDependencySummary), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Dependencies, Mode=OneWay}"
                                          AutomationProperties.AutomationId="lstWorkshopDependencies">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkshopDependencyViewModel">
                                        <Grid Padding="0,6" ColumnSpacing="10"
                                              AutomationProperties.AutomationId="{x:Bind AutomationId}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE7BA;"
                                                     FontSize="14"
                                                     VerticalAlignment="Center"
                                                     Visibility="{x:Bind svc:XamlVisibility.FromBool(NeedsAttention), Mode=OneWay}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource BodyTextBlockStyle}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind DetailText}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Padding="8,3"
                                                    CornerRadius="4"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StateText}"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 更新日志（PDX 有，Markdown） -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasChangelog), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind L.WorkshopDetailChangelog, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ctl:MarkdownView Markdown="{x:Bind ViewModel.ChangelogDocument, Mode=OneWay}"
                                              LinkRequested="OnMarkdownLinkRequested"
                                              ImageRequested="OnMarkdownImageRequested"
                                              AutomationProperties.AutomationId="txtWorkshopDetailChangelog" />
                        </StackPanel>
                    </Border>

                    <!-- 外链 + 论坛帖 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasLinks), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind L.WorkshopDetailLinks, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Links, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkshopLinkViewModel">
                                        <Button Margin="0,0,0,4"
                                                Padding="10,6"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Click="OnLinkClick"
                                                AutomationProperties.AutomationId="{x:Bind AutomationId}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE71B;" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Title}"
                                                           Style="{StaticResource BodyTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Url}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 评论区（Steam 有；服务端直出的首屏评论） -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowCommentsSection), Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind L.WorkshopDetailComments, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="16" Height="16"
                                                  IsActive="{x:Bind ViewModel.IsLoadingComments, Mode=OneWay}"
                                                  Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsLoadingComments), Mode=OneWay}" />
                                    <HyperlinkButton Padding="0"
                                                     Click="OnOpenBrowserClick"
                                                     Content="{x:Bind L.WorkshopDetailCommentsAll, Mode=OneWay}"
                                                     AutomationProperties.AutomationId="btnWorkshopDetailCommentsAll" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.CommentsSummary, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="txtWorkshopCommentsSummary"
                                       Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCommentsSummary), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind L.WorkshopDetailNoComments, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowNoComments), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Comments, Mode=OneWay}"
                                          AutomationProperties.AutomationId="lstWorkshopComments">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkshopCommentViewModel">
                                        <Border Margin="0,0,0,8"
                                                Padding="12"
                                                CornerRadius="8"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                AutomationProperties.AutomationId="{x:Bind AutomationId}">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <HyperlinkButton Padding="0"
                                                                     Click="OnCommentAuthorClick"
                                                                     Content="{x:Bind AuthorName}"
                                                                     IsEnabled="{x:Bind HasProfile}"
                                                                     AutomationProperties.Name="{x:Bind AuthorName}"
                                                                     AutomationProperties.AutomationId="{x:Bind AuthorAutomationId}" />
                                                    <TextBlock Text="{x:Bind PostedText}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Visibility="{x:Bind svc:XamlVisibility.FromString(PostedText), Mode=OneWay}" />
                                                </StackPanel>
                                                <ctl:MarkdownView Markdown="{x:Bind Body, Mode=OneWay}"
                                                                  LinkRequested="OnMarkdownLinkRequested"
                                                                  ImageRequested="OnMarkdownImageRequested"
                                                                  AutomationProperties.Name="{x:Bind BodyPlain}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 图片查看器：整页浮层（FlipView 翻页 + 每页可缩放），点右上角或按 Esc 关闭 -->
        <Grid x:Name="ImageOverlay"
              Visibility="Collapsed"
              Background="#D9000000"
              AutomationProperties.AutomationId="overlayWorkshopImages">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="16" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtWorkshopImageCounter"
                           Grid.Column="1"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" />
                <Button x:Name="btnWorkshopImageClose"
                        Grid.Column="2"
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        Click="OnCloseImageViewer"
                        AutomationProperties.AutomationId="btnWorkshopImageClose"
                        AutomationProperties.Name="{x:Bind L.WorkshopDetailCloseViewer, Mode=OneWay}">
                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" />
                </Button>
            </Grid>

            <FlipView x:Name="GalleryFlip"
                      Grid.Row="1"
                      AutomationProperties.AutomationId="flipWorkshopImages"
                      AutomationProperties.Name="{x:Bind L.WorkshopDetailScreenshotsTitle, Mode=OneWay}"
                      SelectionChanged="OnGallerySelectionChanged"
                      KeyDown="OnGalleryKeyDown">
                <FlipView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkshopScreenshotViewModel">
                        <ScrollViewer ZoomMode="Enabled"
                                      MinZoomFactor="1"
                                      MaxZoomFactor="4"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Enabled">
                            <Image Source="{x:Bind svc:XamlImage.FromPath(Path), Mode=OneWay}"
                                   Stretch="Uniform"
                                   Margin="16" />
                        </ScrollViewer>
                    </DataTemplate>
                </FlipView.ItemTemplate>
            </FlipView>
        </Grid>
    </Grid>
</Page>
