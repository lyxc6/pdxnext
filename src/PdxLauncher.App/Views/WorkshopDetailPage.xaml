<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdxLauncher.App.Views.WorkshopDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PdxLauncher.App.Controls"
    xmlns:svc="using:PdxLauncher.App.Services"
    xmlns:vm="using:PdxLauncher.App.ViewModels"
    Background="{ThemeResource PdxPageVeilBrush}">

    <!--
        创意工坊 mod 详情子页：从列表点一行进来，整页滚动显示完整内容。
        版式参照 Steam 物品页：标题 → 图片区（FlipView + 缩略图条）→ 左订阅 / 右信息两列
        → 描述（Markdown）→ 依赖 → 更新日志 → 外链 → 评论区（Steam 可翻页看全部评论）。
        左栏选中项保持进入前的那一页，页头的返回按钮退回发起方（创意工坊列表或 Mod 库）。
    -->
    <Grid x:Name="RootLayout" SizeChanged="OnPageSizeChanged">
        <Grid Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 页头：返回 / 标题 / 作者 / 打开方式 -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="btnWorkshopDetailBack"
                        Width="36"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="OnBackClick"
                        ToolTipService.ToolTip="{x:Bind ViewModel.BackText, Mode=OneWay}"
                        AutomationProperties.AutomationId="btnWorkshopDetailBack"
                        AutomationProperties.Name="{x:Bind ViewModel.BackText, Mode=OneWay}">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="txtWorkshopDetailTitle" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.SourceLabel), Mode=OneWay}" />
                        <Border Padding="8,4"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                AutomationProperties.AutomationId="txtWorkshopDetailCollectionBadge"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsCollection), Mode=OneWay}">
                            <TextBlock Text="{x:Bind L.WorkshopCollectionBadge, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <!-- 作者：有主页时是可点的超链接 -->
                        <HyperlinkButton x:Name="btnWorkshopDetailAuthor"
                                         Padding="0"
                                         VerticalAlignment="Center"
                                         Click="OnAuthorClick"
                                         IsEnabled="{x:Bind ViewModel.HasAuthorProfile, Mode=OneWay}"
                                         Content="{x:Bind ViewModel.AuthorText, Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind L.WorkshopDetailAuthorHint, Mode=OneWay}"
                                         AutomationProperties.AutomationId="btnWorkshopDetailAuthor"
                                         AutomationProperties.Name="{x:Bind ViewModel.AuthorText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        x:Name="btnWorkshopDetailBrowser"
                        Width="36"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="OnOpenBrowserClick"
                        IsEnabled="{x:Bind ViewModel.HasWebUrl, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind L.WorkshopOpenBrowser, Mode=OneWay}"
                        AutomationProperties.AutomationId="btnWorkshopDetailBrowser"
                        AutomationProperties.Name="{x:Bind L.WorkshopOpenBrowserName, Mode=OneWay}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                </Button>

                <Button Grid.Column="3"
                        x:Name="btnWorkshopDetailSteam"
                        Width="36"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="OnOpenSteamClick"
                        IsEnabled="{x:Bind ViewModel.CanOpenSteam, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind L.WorkshopOpenSteam, Mode=OneWay}"
                        AutomationProperties.AutomationId="btnWorkshopDetailSteam"
                        AutomationProperties.Name="{x:Bind L.WorkshopOpenSteamName, Mode=OneWay}">
                    <FontIcon Glyph="&#xE7FC;" FontSize="14" />
                </Button>
            </Grid>

            <!-- 正文：整页纵向滚动 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          AutomationProperties.AutomationId="scrollWorkshopDetail">
                <StackPanel Spacing="12">

                    <!-- 1. 图片区：内联 FlipView 翻页 + 缩略图条，点大图进全屏查看器 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowGalleryCard), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind L.WorkshopDetailScreenshotsTitle, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsLoadingScreenshots), Mode=OneWay}">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingScreenshots, Mode=OneWay}"
                                              Width="16"
                                              Height="16" />
                                <TextBlock Text="{x:Bind L.WorkshopDetailScreenshotsLoading, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid>
                                <FlipView x:Name="FlipWorkshopScreenshots"
                                          Height="360"
                                          ItemsSource="{x:Bind ViewModel.Screenshots, Mode=OneWay}"
                                          AutomationProperties.AutomationId="flipWorkshopScreenshots"
                                          AutomationProperties.Name="{x:Bind L.WorkshopDetailScreenshotsTitle, Mode=OneWay}"
                                          SelectionChanged="OnInlineGallerySelectionChanged">
                                    <!-- FlipView 的条目默认靠左上且不拉伸；不显式设成 Stretch，大图会被量成 0 尺寸显示不出来。 -->
                                    <FlipView.ItemContainerStyle>
                                        <Style TargetType="FlipViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </FlipView.ItemContainerStyle>
                                    <FlipView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WorkshopScreenshotViewModel">
                                            <Grid Background="Transparent" Tapped="OnInlineImageTapped">
                                                <!-- 既没在下载、也没失败、又没本地图：中性占位图案。 -->
                                                <FontIcon Glyph="&#xE8B9;"
                                                         FontSize="32"
                                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="{x:Bind svc:XamlVisibility.FromBool(ShowPlaceholder), Mode=OneWay}" />
                                                <!--
                                                    下载中：只看这一张自己的状态。
                                                    以前 FlipView 根本没有 ItemsSource、要等整批下完才补，
                                                    于是下面的缩略图都出来了，这里还是一块黑。
                                                -->
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Spacing="8"
                                                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ShowPending), Mode=OneWay}">
                                                    <ProgressRing IsActive="{x:Bind ShowPending, Mode=OneWay}"
                                                                  Width="24"
                                                                  Height="24" />
                                                    <TextBlock Text="{x:Bind L.WorkshopDetailScreenshotDownloading, Mode=OneWay}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <!-- 失败：说清楚这一张没下来，不再无限「下载中」。 -->
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Spacing="8"
                                                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ShowFailed), Mode=OneWay}">
                                                    <FontIcon Glyph="&#xE783;"
                                                              FontSize="24"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind L.WorkshopDetailScreenshotFailed, Mode=OneWay}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <Image Source="{x:Bind svc:XamlImage.FromPath(Path, 1024), Mode=OneWay}"
                                                       Stretch="Uniform"
                                                       Margin="8"
                                                       Visibility="{x:Bind svc:XamlVisibility.FromBool(HasPath), Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </FlipView.ItemTemplate>
                                </FlipView>
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,12,12,0"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        Background="#99000000">
                                    <TextBlock x:Name="txtWorkshopInlineCounter"
                                               Foreground="White"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalScrollMode="Disabled">
                                <ItemsControl x:Name="lstWorkshopScreenshots"
                                              ItemsSource="{x:Bind ViewModel.Screenshots, Mode=OneWay}"
                                              AutomationProperties.AutomationId="lstWorkshopScreenshots">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WorkshopScreenshotViewModel">
                                            <Grid>
                                                <Button Width="200"
                                                        Height="120"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="OnThumbnailClick"
                                                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                        ToolTipService.ToolTip="{x:Bind L.WorkshopDetailViewImage, Mode=OneWay}">
                                                    <Border CornerRadius="8"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE8B9;"
                                                                     FontSize="32"
                                                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(HasPath), Mode=OneWay}" />
                                                            <Image Source="{x:Bind svc:XamlImage.FromPath(Path, 200), Mode=OneWay}"
                                                                   Stretch="Uniform"
                                                                   Margin="8"
                                                                   Visibility="{x:Bind svc:XamlVisibility.FromBool(HasPath), Mode=OneWay}" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                                <Border BorderThickness="2"
                                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="8"
                                                        IsHitTestVisible="False"
                                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(IsCurrent), Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- 2. 左订阅 / 右信息 -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                VerticalAlignment="Stretch"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowSubscribeCard), Mode=OneWay}">
                            <StackPanel Spacing="12">
                                <!-- 订阅状态不入徽章：已订阅时按钮文案就是「取消订阅」，再挂一颗「已订阅」是同一句话说两遍。 -->
                                <TextBlock Text="{x:Bind L.WorkshopDetailSubscribe, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button x:Name="btnWorkshopDetailSubscribe"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Content="{x:Bind ViewModel.SubscribeActionText, Mode=OneWay}"
                                        Click="OnSubscribeClick"
                                        IsEnabled="{x:Bind ViewModel.CanToggleSubscription, Mode=OneWay}"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowPdxSubscribeButton), Mode=OneWay}"
                                        AutomationProperties.AutomationId="btnWorkshopDetailSubscribe" />
                                <Button x:Name="btnWorkshopDetailSubscribeSteam"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Content="{x:Bind ViewModel.SteamSubscribeActionText, Mode=OneWay}"
                                        Click="OnSubscribeSteamClick"
                                        IsEnabled="{x:Bind ViewModel.CanToggleSteamSubscription, Mode=OneWay}"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowSteamSubscribeButton), Mode=OneWay}"
                                        AutomationProperties.AutomationId="btnWorkshopDetailSubscribeSteam" />
                                <Border Padding="8,4"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowSteamUpdateHint), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind L.WorkshopDetailSteamNeedsUpdate, Mode=OneWay}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.SteamDownloadProgressText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="txtWorkshopDetailSteamDownloadProgress"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasSteamDownloadProgress), Mode=OneWay}" />
                                <ProgressRing Width="16"
                                              Height="16"
                                              HorizontalAlignment="Left"
                                              IsActive="{x:Bind ViewModel.IsSteamSubscribing, Mode=OneWay}"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsSteamSubscribing), Mode=OneWay}" />
                                <ProgressRing Width="16"
                                              Height="16"
                                              HorizontalAlignment="Left"
                                              IsActive="{x:Bind ViewModel.IsSubscribing, Mode=OneWay}"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsSubscribing), Mode=OneWay}" />
                                <!-- 只报失败：成功后按钮文案/状态已经变了，再写一句「已订阅」就是重复。 -->
                                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="txtWorkshopDetailStatus"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasStatusText), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.SubscribeHint, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasSubscribeHint), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.SteamSubscribeHint, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="txtWorkshopDetailSteamSubscribeHint"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasSteamSubscribeHint), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.CollectionSubscribeHint, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="txtWorkshopDetailCollectionSubscribeHint"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCollectionSubscribeHint), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.SteamUnavailableReason, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="txtWorkshopDetailSteamUnavailable"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasSteamUnavailableReason), Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowInfoCard), Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind L.WorkshopDetailInfo, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.MetaText, Mode=OneWay}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="txtWorkshopDetailMeta"
                                           Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.MetaText), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.CreatedText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCreated), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.TagsText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasTags), Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 2.5 合集概览（蒸汽合集页语义：封面 + 统计 + 订阅全部；不是 mod 订阅卡） -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            MaxWidth="992"
                            Padding="16"
                            AutomationProperties.AutomationId="pnlWorkshopCollectionHero"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowCollectionHero), Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="128"
                                    Height="128"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Image Source="{x:Bind svc:XamlImage.FromPath(ViewModel.CoverPath, 128), Mode=OneWay}"
                                           Stretch="UniformToFill"
                                           AutomationProperties.AutomationId="imgWorkshopCollectionCover"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCover), Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE8B9;"
                                              FontSize="28"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(ViewModel.HasCover), Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind ViewModel.CollectionSummaryText, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               AutomationProperties.AutomationId="txtWorkshopCollectionHeroSummary"
                                               Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCollectionSummary), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.CollectionSubscribedText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="txtWorkshopCollectionSubscribed"
                                               Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCollectionSubscribedSummary), Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{x:Bind ViewModel.CollectionSubscribeActionText, Mode=OneWay}"
                                            Click="OnCollectionSubscribeClick"
                                            IsEnabled="{x:Bind ViewModel.CanToggleCollectionSubscription, Mode=OneWay}"
                                            AutomationProperties.AutomationId="btnWorkshopCollectionSubscribe" />
                                    <ProgressRing Width="16"
                                                  Height="16"
                                                  IsActive="{x:Bind ViewModel.IsSteamSubscribing, Mode=OneWay}"
                                                  Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsSteamSubscribing), Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock Text="{x:Bind ViewModel.CollectionSubscribeHint, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="txtWorkshopCollectionHeroHint"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCollectionSubscribeHint), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.SteamSubscribeHint, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasSteamSubscribeHint), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.SteamUnavailableReason, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasSteamUnavailableReason), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="txtWorkshopCollectionHeroStatus"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasStatusText), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. 状态：读取中 / 失败 / 缓存兜底 -->
                    <Border Padding="16"
                            CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsLoading), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="18" Height="18" />
                            <TextBlock Text="{x:Bind L.WorkshopDetailLoading, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="16"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasError), Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="txtWorkshopDetailError" />
                            <Button Content="{x:Bind L.WorkshopDetailRetry, Mode=OneWay}"
                                    Click="OnRetryClick"
                                    AutomationProperties.AutomationId="btnWorkshopDetailRetry" />
                        </StackPanel>
                    </Border>

                    <Border Padding="12"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCachedHint), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.CachedHint, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- 翻译没出结果：说明原因，并指路到设置页的「测试翻译」。 -->
                    <Border Padding="12"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasTranslationNotice), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.TranslationNotice, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="txtWorkshopDetailTranslationNotice" />
                    </Border>

                    <!-- 4. 描述（Markdown / HTML 富文本）；宽窗口下按 Steam 物品页的阅读列宽收在 992（内容 960）。 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            MaxWidth="992"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind L.WorkshopDetailDescription, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <!-- 译文按块与原文交替显示：TranslatedMarkdown 交给同一个 MarkdownView，
                                 每段原文下方紧跟一段描边框译文（见 MarkdownView.BuildTranslatedBlock）。 -->
                            <ctl:MarkdownView x:Name="DescriptionView"
                                              Markdown="{x:Bind ViewModel.DescriptionDocument, Mode=OneWay}"
                                              TranslatedMarkdown="{x:Bind ViewModel.TranslatedDescriptionDocument, Mode=OneWay}"
                                              LinkRequested="OnMarkdownLinkRequested"
                                              ImageRequested="OnMarkdownImageRequested"
                                              AutomationProperties.AutomationId="txtWorkshopDetailDescription"
                                              AutomationProperties.Name="{x:Bind ViewModel.DescriptionText, Mode=OneWay}"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasDescription), Mode=OneWay}" />
                            <!-- 翻译在途：原文照常显示，先在原文下方给一条环形进度；译文到达后自动隐藏，
                                 译文由上面的 MarkdownView 按块插回各段原文之后。 -->
                            <Border Margin="0,8,0,0"
                                    Padding="12"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowTranslatingDescription), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ProgressRing Width="16"
                                                  Height="16"
                                                  IsActive="{x:Bind ViewModel.ShowTranslatingDescription, Mode=OneWay}"
                                                  AutomationProperties.AutomationId="ringTranslatingDescription" />
                                    <TextBlock Text="{x:Bind L.WorkshopDetailTranslatingDescription, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="txtTranslatingDescription"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{x:Bind L.WorkshopDetailNoDescription, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowNoDescription), Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- 4.5 合集内容（Steam 合集才有）：子项按服务端 sortorder 排列，点一行进子项详情。 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            MaxWidth="992"
                            Padding="16"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowCollectionCard), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind L.WorkshopDetailCollectionTitle, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.CollectionSummaryText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="txtWorkshopCollectionSummary"
                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCollectionSummary), Mode=OneWay}" />
                                <ProgressRing Width="16"
                                              Height="16"
                                              IsActive="{x:Bind ViewModel.IsLoadingCollection, Mode=OneWay}"
                                              Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsLoadingCollection), Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.CollectionStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="txtWorkshopCollectionStatus"
                                       AutomationProperties.LiveSetting="Polite"
                                       Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCollectionStatus), Mode=OneWay}" />
                            <ListView ItemsSource="{x:Bind ViewModel.CollectionItems, Mode=OneWay}"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="OnCollectionItemClick"
                                      AutomationProperties.AutomationId="lstWorkshopCollectionItems">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkshopRowViewModel">
                                        <Grid Padding="4,8"
                                              ColumnSpacing="12"
                                              AutomationProperties.AutomationId="{x:Bind RowAutomationId, Mode=OneTime}"
                                              AutomationProperties.Name="{x:Bind Name, Mode=OneTime}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 子项缩略图：先占位，后台逐张落地后原地刷新 -->
                                            <Border Grid.Column="0"
                                                    Width="{x:Bind ThumbnailSize, Mode=OneTime}"
                                                    Height="{x:Bind ThumbnailSize, Mode=OneTime}"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{x:Bind svc:XamlImage.FromPath(CoverPath, 72), Mode=OneWay}"
                                                           Stretch="Uniform"
                                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(HasCover), Mode=OneWay}" />
                                                    <FontIcon Glyph="&#xE8B9;"
                                                              FontSize="18"
                                                              Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(HasCover), Mode=OneWay}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ShortDescription, Mode=OneTime}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{x:Bind svc:XamlVisibility.FromBool(HasShortDescription), Mode=OneWay}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind SubtitleText, Mode=OneWay}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{x:Bind svc:XamlVisibility.FromString(SubtitleText), Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind SizeText, Mode=OneWay}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Visibility="{x:Bind svc:XamlVisibility.FromString(SizeText), Mode=OneWay}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <!-- 已订阅 / 已安装 / 下载中 / 需要更新 -->
                                                <Border Padding="8,4"
                                                        CornerRadius="4"
                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        AutomationProperties.AutomationId="{x:Bind SteamStateAutomationId, Mode=OneTime}"
                                                        AutomationProperties.Name="{x:Bind L.ModlibSteamStateName, Mode=OneWay}"
                                                        AutomationProperties.HelpText="{x:Bind SteamStateBadgeText, Mode=OneWay}"
                                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ShowSteamStateBadge), Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind SteamStateBadgeText, Mode=OneWay}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </Border>
                                                <Button Content="{x:Bind SteamSubscribeActionText, Mode=OneWay}"
                                                        Click="OnCollectionItemSubscribeClick"
                                                        IsEnabled="{x:Bind CanToggleSteamSubscription, Mode=OneWay}"
                                                        AutomationProperties.AutomationId="{x:Bind SteamSubscribeAutomationId, Mode=OneTime}" />
                                                <Button Width="32"
                                                        Height="32"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="OnCollectionItemOpenSteamClick"
                                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(CanOpenSteam), Mode=OneWay}"
                                                        AutomationProperties.AutomationId="{x:Bind OpenSteamAutomationId, Mode=OneTime}"
                                                        AutomationProperties.Name="{x:Bind L.WorkshopOpenSteamName, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind L.WorkshopOpenSteamName, Mode=OneWay}">
                                                    <FontIcon Glyph="&#xE7FC;" FontSize="16" />
                                                </Button>
                                                <Button Width="32"
                                                        Height="32"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="OnCollectionItemOpenBrowserClick"
                                                        AutomationProperties.AutomationId="{x:Bind OpenBrowserAutomationId, Mode=OneTime}"
                                                        AutomationProperties.Name="{x:Bind L.WorkshopOpenBrowserName, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind L.WorkshopOpenBrowserName, Mode=OneWay}">
                                                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- 5. 前置依赖（PDX 有） -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasDependencies), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind L.WorkshopDetailDependencies, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DependencySummary, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="txtWorkshopDependencySummary"
                                       Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasDependencySummary), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Dependencies, Mode=OneWay}"
                                          AutomationProperties.AutomationId="lstWorkshopDependencies">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkshopDependencyViewModel">
                                        <Grid Padding="0,8"
                                              ColumnSpacing="8"
                                              AutomationProperties.AutomationId="{x:Bind AutomationId}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE7BA;"
                                                     FontSize="14"
                                                     VerticalAlignment="Center"
                                                     Visibility="{x:Bind svc:XamlVisibility.FromBool(NeedsAttention), Mode=OneWay}" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource BodyTextBlockStyle}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind DetailText}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Padding="8,4"
                                                    CornerRadius="4"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StateText}"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 6. 更新日志（PDX 有，Markdown）；与描述用同一阅读列宽 992（内容 960）。 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            MaxWidth="992"
                            Padding="16"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasChangelog), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind L.WorkshopDetailChangelog, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <!-- 译文与描述同规则：按块交替显示，每段原文下方紧跟一段描边框译文。 -->
                            <ctl:MarkdownView x:Name="ChangelogView"
                                              Markdown="{x:Bind ViewModel.ChangelogDocument, Mode=OneWay}"
                                              TranslatedMarkdown="{x:Bind ViewModel.TranslatedChangelogDocument, Mode=OneWay}"
                                              LinkRequested="OnMarkdownLinkRequested"
                                              ImageRequested="OnMarkdownImageRequested"
                                              AutomationProperties.AutomationId="txtWorkshopDetailChangelog" />
                            <!-- 翻译在途：原文照常显示，先在原文下方给一条环形进度；译文到达后自动隐藏。 -->
                            <Border Margin="0,8,0,0"
                                    Padding="12"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowTranslatingChangelog), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ProgressRing Width="16"
                                                  Height="16"
                                                  IsActive="{x:Bind ViewModel.ShowTranslatingChangelog, Mode=OneWay}"
                                                  AutomationProperties.AutomationId="ringTranslatingChangelog" />
                                    <TextBlock Text="{x:Bind L.WorkshopDetailTranslatingChangelog, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="txtTranslatingChangelog"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 7. 外链 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasLinks), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind L.WorkshopDetailLinks, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Links, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkshopLinkViewModel">
                                        <Button Margin="0,0,0,4"
                                                Padding="12,8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Click="OnLinkClick"
                                                AutomationProperties.AutomationId="{x:Bind AutomationId}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE71B;" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Title}"
                                                           Style="{StaticResource BodyTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Url}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 8. 评论区（Steam 有；首屏 + 翻页看全部） -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowCommentsSection), Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind L.WorkshopDetailComments, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="16"
                                                  Height="16"
                                                  IsActive="{x:Bind ViewModel.IsLoadingComments, Mode=OneWay}"
                                                  Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsLoadingComments), Mode=OneWay}" />
                                    <HyperlinkButton Padding="0"
                                                     Click="OnOpenBrowserClick"
                                                     Content="{x:Bind L.WorkshopDetailCommentsAll, Mode=OneWay}"
                                                     AutomationProperties.AutomationId="btnWorkshopDetailCommentsAll" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.CommentsSummary, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="txtWorkshopCommentsSummary"
                                       Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCommentsSummary), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.CommentsStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="txtWorkshopCommentsStatus"
                                       Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCommentsStatusText), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind L.WorkshopDetailNoComments, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowNoComments), Mode=OneWay}" />
                            <!-- 翻译在途：评论是逐条翻的（一条几秒），用一条带文字的环形进度概括整段，译好一条挂一条。 -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12"
                                        Margin="0,0,0,4"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowTranslatingComments), Mode=OneWay}">
                                <ProgressRing Width="16"
                                              Height="16"
                                              IsActive="{x:Bind ViewModel.ShowTranslatingComments, Mode=OneWay}"
                                              AutomationProperties.AutomationId="ringTranslatingComments" />
                                <TextBlock Text="{x:Bind L.WorkshopDetailTranslatingComments, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="txtTranslatingComments"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Comments, Mode=OneWay}"
                                          AutomationProperties.AutomationId="lstWorkshopComments">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkshopCommentViewModel">
                                        <Border Margin="0,0,0,8"
                                                Padding="12"
                                                CornerRadius="8"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                AutomationProperties.AutomationId="{x:Bind AutomationId}">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <HyperlinkButton Padding="0"
                                                                     Click="OnCommentAuthorClick"
                                                                     Content="{x:Bind AuthorName}"
                                                                     IsEnabled="{x:Bind HasProfile}"
                                                                     AutomationProperties.Name="{x:Bind AuthorName}"
                                                                     AutomationProperties.AutomationId="{x:Bind AuthorAutomationId}" />
                                                    <TextBlock Text="{x:Bind PostedText}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Visibility="{x:Bind svc:XamlVisibility.FromString(PostedText), Mode=OneWay}" />
                                                </StackPanel>
                                                <ctl:MarkdownView Markdown="{x:Bind Body, Mode=OneWay}"
                                                                  LinkRequested="OnMarkdownLinkRequested"
                                                                  ImageRequested="OnMarkdownImageRequested"
                                                                  Loaded="OnCommentMarkdownLoaded"
                                                                  Unloaded="OnCommentMarkdownUnloaded"
                                                                  AutomationProperties.Name="{x:Bind BodyPlain}" />
                                                <!-- 译文：原文与译文同显，只显示译文正文（不加「译文」标题）；评论模板按 x:DataType 绑定，L 取自 LocalizedObservableObject。 -->
                                                <Border Margin="0,8,0,0"
                                                        Padding="12"
                                                        CornerRadius="8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(HasTranslation), Mode=OneWay}">
                                                    <ctl:MarkdownView Markdown="{x:Bind TranslatedBody, Mode=OneWay}"
                                                                      LinkRequested="OnMarkdownLinkRequested"
                                                                      ImageRequested="OnMarkdownImageRequested"
                                                                      Loaded="OnCommentMarkdownLoaded"
                                                                      Unloaded="OnCommentMarkdownUnloaded"
                                                                      AutomationProperties.Name="{x:Bind TranslatedBodyPlain}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 分页：Steam 评论区那种「上一页 / 第 n 页 / 下一页」 -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCommentsPaging), Mode=OneWay}">
                                <Button x:Name="btnCommentsPrev"
                                        Padding="12,4"
                                        Click="OnCommentsPrevClick"
                                        IsEnabled="{x:Bind ViewModel.CanCommentsPrev, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind L.WorkshopCommentsPrev, Mode=OneWay}"
                                        AutomationProperties.AutomationId="btnCommentsPrev"
                                        AutomationProperties.Name="{x:Bind L.WorkshopCommentsPrev, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                </Button>
                                <TextBlock Text="{x:Bind ViewModel.CommentsPageText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="txtWorkshopCommentsPage" />
                                <Button x:Name="btnCommentsNext"
                                        Padding="12,4"
                                        Click="OnCommentsNextClick"
                                        IsEnabled="{x:Bind ViewModel.CanCommentsNext, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind L.WorkshopCommentsNext, Mode=OneWay}"
                                        AutomationProperties.AutomationId="btnCommentsNext"
                                        AutomationProperties.Name="{x:Bind L.WorkshopCommentsNext, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 图片查看器：整页浮层（FlipView 翻页 + 每页可缩放），点右上角或按 Esc 关闭 -->
        <Grid x:Name="ImageOverlay"
              Visibility="Collapsed"
              Background="#D9000000"
              SizeChanged="OnViewerSizeChanged"
              AutomationProperties.AutomationId="overlayWorkshopImages">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="16" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtWorkshopImageCounter"
                           Grid.Column="1"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" />
                <Button x:Name="btnWorkshopImageClose"
                        Grid.Column="2"
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        Click="OnCloseImageViewer"
                        AutomationProperties.AutomationId="btnWorkshopImageClose"
                        AutomationProperties.Name="{x:Bind L.WorkshopDetailCloseViewer, Mode=OneWay}">
                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" />
                </Button>
            </Grid>

            <FlipView x:Name="FlipWorkshopViewer"
                      Grid.Row="1"
                      AutomationProperties.AutomationId="flipWorkshopImages"
                      AutomationProperties.Name="{x:Bind L.WorkshopDetailScreenshotsTitle, Mode=OneWay}"
                      SelectionChanged="OnGallerySelectionChanged"
                      KeyDown="OnGalleryKeyDown">
                <FlipView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkshopScreenshotViewModel">
                        <Grid>
                            <ScrollViewer ZoomMode="Enabled"
                                          MinZoomFactor="1"
                                          MaxZoomFactor="4"
                                          Padding="16"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Disabled"
                                          VerticalScrollMode="Disabled"
                                          DoubleTapped="OnViewerDoubleTapped"
                                          PointerWheelChanged="OnViewerPointerWheelChanged">
                                <!--
                                    缩放开启后 ScrollViewer 按内容自身尺寸测量，工坊画廊给的是 imw=5000 的原图，
                                    不限制就会被裁掉一大块（1x 也不能拖）。MaxWidth/MaxHeight 由页面按浮层尺寸算好，
                                    1x 刚好整张放进窗口，放大后才滚动。
                                -->
                                <Image Source="{x:Bind svc:XamlImage.FromPath(Path, 1600), Mode=OneWay}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       MaxWidth="{x:Bind ViewerMaxWidth, Mode=OneWay}"
                                       MaxHeight="{x:Bind ViewerMaxHeight, Mode=OneWay}" />
                            </ScrollViewer>
                            <!-- 全屏打开时这一张可能还没下完：给出与内联大图一致的「下载中 / 失败」说明。 -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ShowPending), Mode=OneWay}">
                                <ProgressRing IsActive="{x:Bind ShowPending, Mode=OneWay}"
                                              Width="32"
                                              Height="32"
                                              Foreground="White" />
                                <TextBlock Text="{x:Bind L.WorkshopDetailScreenshotDownloading, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="White"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ShowFailed), Mode=OneWay}">
                                <FontIcon Glyph="&#xE783;" FontSize="28" Foreground="White" />
                                <TextBlock Text="{x:Bind L.WorkshopDetailScreenshotFailed, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="White"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </FlipView.ItemTemplate>
            </FlipView>
        </Grid>
    </Grid>
</Page>
