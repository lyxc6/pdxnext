<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdxLauncher.App.Views.McpKeyEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:PdxLauncher.App.Services"
    NavigationCacheMode="Disabled"
    Background="{ThemeResource PdxPageVeilBrush}">

    <!--
        「MCP 访问密钥」子页：新建 / 编辑共用。
        页头（返回 + 标题 + 前缀状态）固定，表单在滚动区，底部固定保存条。
        左栏没有这个页面的菜单项，选中态停在「设置」。
        所有交互控件都带 AutomationProperties.AutomationId，便于 UI 自动化与无障碍。
    -->
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="btnMcpKeyBack"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="OnBackClick"
                    ToolTipService.ToolTip="{x:Bind L.SettingsMcpKeyBack, Mode=OneWay}"
                    AutomationProperties.AutomationId="btnMcpKeyBack"
                    AutomationProperties.Name="{x:Bind L.SettingsMcpKeyBack, Mode=OneWay}">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>

            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind PageTitle, Mode=OneWay}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           AutomationProperties.AutomationId="txtMcpKeyTitle" />
                <TextBlock Text="{x:Bind SubtitleText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="txtMcpKeySubtitle" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.KeyPrefix, Mode=OneWay}"
                           FontFamily="Consolas"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="txtMcpKeyPrefix" />
                <Border Padding="8,4"
                        CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="txtMcpKeyStatus" />
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="FormScroller"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Padding="0,0,16,0">

                <!-- 一次性密钥（新建 / 轮换后） -->
                <Border Padding="12"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                        Background="{ThemeResource PdxCardBackgroundBrush}"
                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasCreatedToken), Mode=OneWay}"
                        AutomationProperties.AutomationId="panelMcpCreatedToken">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind L.SettingsMcpKeyCreatedTitle, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind L.SettingsMcpKeyCreatedHint, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox Text="{x:Bind ViewModel.CreatedToken, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 AutomationProperties.AutomationId="txtMcpCreatedToken" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind L.CommonCopy, Mode=OneWay}"
                                    Click="OnCopyTokenClick"
                                    AutomationProperties.AutomationId="btnMcpCopyToken" />
                            <TextBlock x:Name="TokenCopiedText"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 基本信息 -->
                <Border Padding="16"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                        Background="{ThemeResource PdxCardBackgroundBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind L.SettingsMcpKeySectionBasics, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBox x:Name="NameBox"
                                 Header="{x:Bind L.SettingsMcpKeyDisplayName, Mode=OneWay}"
                                 PlaceholderText="{x:Bind L.SettingsMcpKeyDisplayNamePlaceholder, Mode=OneWay}"
                                 MaxLength="80"
                                 Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}"
                                 AutomationProperties.AutomationId="txtMcpKeyEditorName" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind L.SettingsMcpKeyExpiry, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.ExpiryText, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="txtMcpKeyExpiry" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="{x:Bind L.SettingsMcpKeySetExpiry, Mode=OneWay}"
                                        Click="OnSetExpiryClick"
                                        AutomationProperties.AutomationId="btnMcpKeySetExpiry" />
                                <Button Content="{x:Bind L.SettingsMcpKeyClearExpiry, Mode=OneWay}"
                                        Click="OnClearExpiryClick"
                                        IsEnabled="{x:Bind ViewModel.HasExpiry, Mode=OneWay}"
                                        AutomationProperties.AutomationId="btnMcpKeyClearExpiry" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 能力勾选：按业务域分组 -->
                <Border Padding="16"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                        Background="{ThemeResource PdxCardBackgroundBrush}"
                        AutomationProperties.AutomationId="panelMcpCapabilities">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind L.SettingsMcpKeySectionCapabilities, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind L.SettingsMcpKeyCapabilitiesHint, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="{x:Bind L.SettingsMcpCapGroupGames, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox Content="{x:Bind L.SettingsMcpCapGames, Mode=OneWay}"
                                  IsChecked="{x:Bind ViewModel.GamesReadEnabled, Mode=TwoWay}"
                                  Checked="OnCapabilityChecked"
                                  Unchecked="OnCapabilityChecked"
                                  AutomationProperties.AutomationId="chkMcpCapGames" />
                        <TextBlock Text="{x:Bind L.SettingsMcpCapGamesDesc, Mode=OneWay}"
                                   Margin="28,0,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="{x:Bind L.SettingsMcpCapGroupUpload, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox Content="{x:Bind L.SettingsMcpCapUploadRead, Mode=OneWay}"
                                  IsChecked="{x:Bind ViewModel.UploadReadEnabled, Mode=TwoWay}"
                                  Checked="OnCapabilityChecked"
                                  Unchecked="OnCapabilityChecked"
                                  AutomationProperties.AutomationId="chkMcpCapUploadRead" />
                        <TextBlock Text="{x:Bind L.SettingsMcpCapUploadReadDesc, Mode=OneWay}"
                                   Margin="28,0,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox Content="{x:Bind L.SettingsMcpCapUploadWrite, Mode=OneWay}"
                                  IsChecked="{x:Bind ViewModel.UploadWriteEnabled, Mode=TwoWay}"
                                  Checked="OnCapabilityChecked"
                                  Unchecked="OnCapabilityChecked"
                                  AutomationProperties.AutomationId="chkMcpCapUploadWrite" />
                        <TextBlock Text="{x:Bind L.SettingsMcpCapUploadWriteDesc, Mode=OneWay}"
                                   Margin="28,0,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="{x:Bind L.SettingsMcpCapGroupPlaySets, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox Content="{x:Bind L.SettingsMcpCapPlaySetsRead, Mode=OneWay}"
                                  IsChecked="{x:Bind ViewModel.PlaySetsReadEnabled, Mode=TwoWay}"
                                  Checked="OnCapabilityChecked"
                                  Unchecked="OnCapabilityChecked"
                                  AutomationProperties.AutomationId="chkMcpCapPlaySetsRead" />
                        <TextBlock Text="{x:Bind L.SettingsMcpCapPlaySetsReadDesc, Mode=OneWay}"
                                   Margin="28,0,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox Content="{x:Bind L.SettingsMcpCapPlaySetsPlan, Mode=OneWay}"
                                  IsChecked="{x:Bind ViewModel.PlaySetsPlanEnabled, Mode=TwoWay}"
                                  Checked="OnCapabilityChecked"
                                  Unchecked="OnCapabilityChecked"
                                  AutomationProperties.AutomationId="chkMcpCapPlaySetsPlan" />
                        <TextBlock Text="{x:Bind L.SettingsMcpCapPlaySetsPlanDesc, Mode=OneWay}"
                                   Margin="28,0,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="{x:Bind L.SettingsMcpCapGroupSettings, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox Content="{x:Bind L.SettingsMcpCapSettingsRead, Mode=OneWay}"
                                  IsChecked="{x:Bind ViewModel.SettingsReadEnabled, Mode=TwoWay}"
                                  Checked="OnCapabilityChecked"
                                  Unchecked="OnCapabilityChecked"
                                  AutomationProperties.AutomationId="chkMcpCapSettingsRead" />
                        <TextBlock Text="{x:Bind L.SettingsMcpCapSettingsReadDesc, Mode=OneWay}"
                                   Margin="28,0,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox Content="{x:Bind L.SettingsMcpCapSettingsPlan, Mode=OneWay}"
                                  IsChecked="{x:Bind ViewModel.SettingsPlanEnabled, Mode=TwoWay}"
                                  Checked="OnCapabilityChecked"
                                  Unchecked="OnCapabilityChecked"
                                  AutomationProperties.AutomationId="chkMcpCapSettingsPlan" />
                        <TextBlock Text="{x:Bind L.SettingsMcpCapSettingsPlanDesc, Mode=OneWay}"
                                   Margin="28,0,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <!-- 勾了任一写入能力才出现的风险说明 -->
                        <Border Padding="12"
                                CornerRadius="4"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasWriteCapability), Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE72E;"
                                          FontSize="14"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind L.SettingsMcpKeyWriteWarning, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{x:Bind ViewModel.SelectedCapabilitiesText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.AutomationId="txtMcpSelectedCapabilities" />
                    </StackPanel>
                </Border>

                <!-- 编辑态才有的密钥维护 / 危险操作 -->
                <Border Padding="16"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                        Background="{ThemeResource PdxCardBackgroundBrush}"
                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.IsExisting), Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind L.SettingsMcpKeySectionDanger, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind L.SettingsMcpKeyDangerHint, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind L.SettingsMcpKeyRotate, Mode=OneWay}"
                                    Click="OnRotateClick"
                                    AutomationProperties.AutomationId="btnMcpKeyRotate" />
                            <Button Content="{x:Bind L.SettingsMcpKeyDelete, Mode=OneWay}"
                                    Click="OnDeleteClick"
                                    AutomationProperties.AutomationId="btnMcpKeyDelete" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasError), Mode=OneWay}"
                           AutomationProperties.AutomationId="txtMcpKeyError" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定操作条 -->
        <Border Grid.Row="2"
                Padding="16,12"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource PdxCardStrokeBrush}"
                Background="{ThemeResource PdxCardBackgroundBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="{x:Bind L.SettingsMcpKeyCancel, Mode=OneWay}"
                        Click="OnBackClick"
                        AutomationProperties.AutomationId="btnMcpKeyCancel" />
                <Button x:Name="SaveButton"
                        Content="{x:Bind L.SettingsMcpKeySave, Mode=OneWay}"
                        Click="OnSaveClick"
                        IsEnabled="{x:Bind ViewModel.CanSaveName, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="btnMcpKeySave" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
