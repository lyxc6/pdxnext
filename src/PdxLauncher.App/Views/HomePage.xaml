<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdxLauncher.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:PdxLauncher.App.Services"
    xmlns:controls="using:PdxLauncher.App.Controls"
    NavigationCacheMode="Required"
    Background="Transparent">

    <!--
        当前游戏主页，布局与视觉常量对齐官方 Paradox 启动器（Electron 版）：
          居中字标 → 继续（左）+ 开始游戏（右）→ 播放集下拉 → 版本号（公告栏正上方、左对齐）
          → 底部三张官方公告卡。
        官方主页没有卡片容器：按钮、下拉、公告都直接浮在背景图上，因此这里也不套 Border。
        控件仍然全部是 WinUI 3 标准 Button，以及统一下拉控件 controls:PdxDropDown
        （内部是标准 DropDownButton + Flyout + ListView）：不自绘悬浮左栏、不自绘顶栏，
        主题与高对比度交给系统 ThemeDictionaries 与 ThemeSpec。
        页面自身不画底色（Background=Transparent），背景图由 MainWindow 统一铺满窗口。

        两个主按钮：尺寸 232x66、圆角 4、内嵌高光 2px 白 22% + 底边 1px 白 33%
        （对应官方 themedButton 的 pureCSS 变体的 box-shadow: inset 0 -1px #ffffff54,
        inset 0 0 0 2px #ffffff38）。底图/文字色/字体/字号/字重来自当前游戏主题，
        见 code-behind ApplyThemeAsync / ApplyThemedButton。

        公告卡：官方 .news 是固定 451x230（main）与 246x230（secondary）的纯图块，
        图用 background-size:cover 铺满、圆角 4、外圈 1px 黑 40% + 内圈 1px 白 10%，
        悬停叠 50% #131724 遮罩，只有存在标题时才在左下角叠 24px 白字 + 底部渐变。
        这里用 Image(UniformToFill) 等价实现，不渲染正文（官方也不渲染）。
    -->
    <ScrollViewer x:Name="HomeScrollViewer" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel
            MaxWidth="1120"
            Padding="24"
            HorizontalAlignment="Center"
            Spacing="16">

            <!--
                页头即主视觉：字标 / 标题居中排列，直接浮在整窗背景图上；
                版本号不在这里（见公告区上方的 txtHomeVersion），也不再放刷新按钮
                ——主页在页面 Loaded 与切换游戏时自动刷新，官方那个按钮按用户要求去掉了。
                MinHeight 给背景留呼吸空间，不写死高度以免裁掉字标。
            -->
            <Grid MinHeight="220">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <Image
                        x:Name="LogoImage"
                        MaxWidth="420"
                        MaxHeight="160"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="imgHomeLogo"
                        AutomationProperties.Name="{x:Bind L.HomeGameLogoName, Mode=OneWay}"
                        Stretch="Uniform"
                        Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.LogoPath), Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="txtHomeGameTitle"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.GameTitle, Mode=OneWay}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind svc:XamlVisibility.FromStringInverse(ViewModel.LogoPath), Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        AutomationProperties.AutomationId="ringHomeBusy"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!--
                启动区：官方主页里没有任何外框，按钮与播放集下拉直接浮在背景上。
                按钮间距 16 DIP（官方 .playBtns>*:not(:first-child){margin-inline-start:1rem}），
                按钮行到播放集行约 40 DIP（官方截图实测 ~44 DIP）。
            -->
            <StackPanel HorizontalAlignment="Stretch" Spacing="0">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <!-- 尺寸照官方启动器：min-width 14.5rem × height 4.1667rem = 232x66 -->
                    <Button
                        x:Name="ContinueButton"
                        Width="232"
                        Height="66"
                        Padding="0"
                        RenderTransformOrigin="0.5,0.5"
                        AutomationProperties.AutomationId="btnHomeContinue"
                        AutomationProperties.Name="{x:Bind L.HomeContinueName, Mode=OneWay}"
                        Click="OnContinueClick"
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.HasContinue, Mode=OneWay}"
                        PointerEntered="OnThemedButtonPointerEntered"
                        PointerExited="OnThemedButtonPointerExited"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ContinueToolTip, Mode=OneWay}"
                        VerticalContentAlignment="Stretch">
                        <Button.RenderTransform>
                            <CompositeTransform />
                        </Button.RenderTransform>
                        <Grid x:Name="ContinueSurface">
                            <Border
                                x:Name="ContinueGlow"
                                Background="White"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="ContinueInnerRing"
                                BorderBrush="#38FFFFFF"
                                BorderThickness="2"
                                CornerRadius="4"
                                IsHitTestVisible="False" />
                            <Border
                                x:Name="ContinueBottomLine"
                                Height="1"
                                Margin="2,0,2,1"
                                VerticalAlignment="Bottom"
                                Background="#54FFFFFF"
                                IsHitTestVisible="False" />
                            <TextBlock
                                x:Name="ContinueLabel"
                                HorizontalAlignment="Center"
                                Text="{x:Bind L.HomeContinue, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="StartButton"
                        Width="232"
                        Height="66"
                        Padding="0"
                        RenderTransformOrigin="0.5,0.5"
                        AutomationProperties.AutomationId="btnStartGame"
                        AutomationProperties.Name="{x:Bind L.HomeStartName, Mode=OneWay}"
                        Click="OnStartClick"
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.HasGame, Mode=OneWay}"
                        PointerEntered="OnThemedButtonPointerEntered"
                        PointerExited="OnThemedButtonPointerExited"
                        VerticalContentAlignment="Stretch">
                        <Button.RenderTransform>
                            <CompositeTransform />
                        </Button.RenderTransform>
                        <Grid x:Name="StartSurface">
                            <Border
                                x:Name="StartGlow"
                                Background="White"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="StartInnerRing"
                                BorderBrush="#38FFFFFF"
                                BorderThickness="2"
                                CornerRadius="4"
                                IsHitTestVisible="False" />
                            <Border
                                x:Name="StartBottomLine"
                                Height="1"
                                Margin="2,0,2,1"
                                VerticalAlignment="Bottom"
                                Background="#54FFFFFF"
                                IsHitTestVisible="False" />
                            <TextBlock
                                x:Name="StartLabel"
                                HorizontalAlignment="Center"
                                Text="{x:Bind L.HomeStart, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.SupportsContentManagement), Mode=OneWay}">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind L.HomePlaySetLabel, Mode=OneWay}" />
                    <controls:PdxDropDown
                        x:Name="PlaySetSwitcher"
                        Width="220"
                        MinHeight="32"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.PlaySets, Mode=OneWay}"
                        DisplayMemberPath="Name"
                        SelectedItem="{x:Bind ViewModel.SelectedPlaySet, Mode=OneWay}"
                        SelectionChanged="OnPlaySetSelectionChanged"
                        AutomationProperties.AutomationId="btnHomePlaySets"
                        AutomationProperties.Name="{x:Bind L.HomePlaySetName, Mode=OneWay}" />
                    <TextBlock
                        x:Name="txtHomeNoPlaySet"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind L.HomeNoPlaySets, Mode=OneWay}"
                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasNoPlaySets), Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    x:Name="txtHomeNoGame"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind L.HomeSelectGameHint, Mode=OneWay}"
                    Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(ViewModel.HasGame), Mode=OneWay}" />

                <TextBlock
                    x:Name="txtHomeSupportNotice"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="txtHomeSupportNotice"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.SupportNotice, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.SupportNotice), Mode=OneWay}" />
            </StackPanel>

            <!-- 启动结果 -->
            <InfoBar
                x:Name="HomeInfoBar"
                AutomationProperties.AutomationId="infHomeLaunch"
                IsOpen="False"
                Severity="Error"
                Title="{x:Bind L.HomeLaunchFailedTitle, Mode=OneWay}" />

            <!--
                版本号：照官方 Victoria 3 启动器放在广告卡正上方、右对齐，与公告行同宽（986）。
                不能用 HorizontalAlignment="Center" + 内部 Left：Grid 会按文字宽度收缩再整体居中，
                看起来就是居中的（上一轮的问题）；Stretch + MaxWidth 才能吃掉整列宽度。
                文本用裸版本串（官方没有「版本」前缀）。
            -->
            <Grid MaxWidth="986" HorizontalAlignment="Stretch">
                <TextBlock
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="txtHomeVersion"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.RawVersionText, Mode=OneWay}" />
            </Grid>

            <!--
                官方公告卡：三块固定尺寸纯图卡，整行最大 986 DIP 居中
                （451 + 246 + 246 + 2x21 间距 = 985，对应官方 28.1875rem 内容宽）。
                官方是 flex 行（.news__container），缺哪块就少一块、整行仍居中，所以这里用
                「Viewbox + 水平 StackPanel」而不是三列 Grid —— Grid 会给隐藏的卡留空列。
                Viewbox 只向下缩放：窗口窄于 985 时整行等比缩小，不裁切、不横向滚动。
                卡片用透明 Button 承载点击与无障碍，系统按钮底色在 Button.Resources 里全部压成透明；
                视觉全部由 Content 里的 Border/Image 提供：无内边距、图铺满整卡、只有标题叠加层。
                悬停反馈是叠一层 50% 深色遮罩（官方 .news:hover:after），不改 Button.Background。
            -->
            <Viewbox
                x:Name="NewsRegion"
                MaxWidth="986"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Stretch="Uniform"
                StretchDirection="DownOnly"
                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasNews), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="21">

                <Button
                    x:Name="btnNewsMain"
                    Width="451"
                    Height="230"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="btnNewsMain"
                    Click="OnNewsMainClick"
                    CornerRadius="4"
                    PointerEntered="OnNewsCardPointerEntered"
                    PointerExited="OnNewsCardPointerExited"
                    Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasNewsMain), Mode=OneWay}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                    <Border
                        Background="{ThemeResource PdxCardGlassBrush}"
                        BorderBrush="#66000000"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Image
                                AutomationProperties.AutomationId="imgNews_main"
                                AutomationProperties.Name="{x:Bind L.HomeNewsImageName, Mode=OneWay}"
                                Stretch="UniformToFill"
                                Source="{x:Bind svc:XamlImage.FromPath(ViewModel.NewsMain.ImagePath, 1024), Mode=OneWay}"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.NewsMain.HasImage), Mode=OneWay}" />
                            <Border
                                IsHitTestVisible="False"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.NewsMain.HasTitle), Mode=OneWay}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#80000000" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock
                                Margin="28,0,28,24"
                                VerticalAlignment="Bottom"
                                FontSize="24"
                                Foreground="White"
                                MaxLines="3"
                                Text="{x:Bind ViewModel.NewsMain.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.NewsMain.HasTitle), Mode=OneWay}" />
                            <Border
                                x:Name="NewsHoverVeilMain"
                                Background="#80131724"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Button>

                <Button
                    x:Name="btnNewsSecondary1"
                    Width="246"
                    Height="230"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="btnNewsSecondary1"
                    Click="OnNewsSecondary1Click"
                    CornerRadius="4"
                    PointerEntered="OnNewsCardPointerEntered"
                    PointerExited="OnNewsCardPointerExited"
                    Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasNewsSecondary1), Mode=OneWay}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                    <Border
                        Background="{ThemeResource PdxCardGlassBrush}"
                        BorderBrush="#66000000"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Image
                                AutomationProperties.AutomationId="imgNews_secondary1"
                                AutomationProperties.Name="{x:Bind L.HomeNewsImageName, Mode=OneWay}"
                                Stretch="UniformToFill"
                                Source="{x:Bind svc:XamlImage.FromPath(ViewModel.NewsSecondary1.ImagePath, 640), Mode=OneWay}"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.NewsSecondary1.HasImage), Mode=OneWay}" />
                            <Border
                                IsHitTestVisible="False"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.NewsSecondary1.HasTitle), Mode=OneWay}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#80000000" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock
                                Margin="28,0,28,24"
                                VerticalAlignment="Bottom"
                                FontSize="24"
                                Foreground="White"
                                MaxLines="3"
                                Text="{x:Bind ViewModel.NewsSecondary1.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.NewsSecondary1.HasTitle), Mode=OneWay}" />
                            <Border
                                x:Name="NewsHoverVeilSecondary1"
                                Background="#80131724"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Button>

                <Button
                    x:Name="btnNewsSecondary2"
                    Width="246"
                    Height="230"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="btnNewsSecondary2"
                    Click="OnNewsSecondary2Click"
                    CornerRadius="4"
                    PointerEntered="OnNewsCardPointerEntered"
                    PointerExited="OnNewsCardPointerExited"
                    Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.HasNewsSecondary2), Mode=OneWay}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                    <Border
                        Background="{ThemeResource PdxCardGlassBrush}"
                        BorderBrush="#66000000"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Image
                                AutomationProperties.AutomationId="imgNews_secondary2"
                                AutomationProperties.Name="{x:Bind L.HomeNewsImageName, Mode=OneWay}"
                                Stretch="UniformToFill"
                                Source="{x:Bind svc:XamlImage.FromPath(ViewModel.NewsSecondary2.ImagePath, 640), Mode=OneWay}"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.NewsSecondary2.HasImage), Mode=OneWay}" />
                            <Border
                                IsHitTestVisible="False"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.NewsSecondary2.HasTitle), Mode=OneWay}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#80000000" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock
                                Margin="28,0,28,24"
                                VerticalAlignment="Bottom"
                                FontSize="24"
                                Foreground="White"
                                MaxLines="3"
                                Text="{x:Bind ViewModel.NewsSecondary2.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.NewsSecondary2.HasTitle), Mode=OneWay}" />
                            <Border
                                x:Name="NewsHoverVeilSecondary2"
                                Background="#80131724"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Button>
                </StackPanel>
            </Viewbox>

            <!-- 公告点击提示：链接是 pdxlaun:// 这类内部深链时告知暂不支持，不再把卡片灰掉 -->
            <InfoBar
                x:Name="NewsInfoBar"
                AutomationProperties.AutomationId="infHomeNews"
                IsOpen="False"
                Severity="Informational"
                Title="{x:Bind L.HomeNewsTitle, Mode=OneWay}" />

            <!-- 状态文案 -->
            <TextBlock
                AutomationProperties.AutomationId="txtHomeStatus"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind svc:XamlVisibility.FromString(ViewModel.StatusMessage), Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
