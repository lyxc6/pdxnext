<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdxLauncher.App.Views.AddModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PdxLauncher.App.Controls"
    xmlns:svc="using:PdxLauncher.App.Services"
    xmlns:vm="using:PdxLauncher.App.ViewModels"
    Background="{ThemeResource PdxPageVeilBrush}">

    <!--
        「添加模组」子页：从 mod 库里挑还没进当前播放集的 mod，多选后交回播放集页。
        页面自己不写库：勾选结果通过 ModsSelected 事件交回发起方（播放集页），
        由它在自己的上下文里追加并自动保存。
        左栏没有这个页面的菜单项，所以选中态停在「播放集」。
        所有交互控件都带 AutomationProperties.AutomationId，便于 UI 自动化与无障碍。

        版式（4 DIP 网格）：页头 48（返回 32 + 标题 + 「→ 播放集名」同一行 + 计数固定 96）、
        搜索行 32（搜索框定宽 320 + 排序下拉）、列表 *、底栏 Auto。
        页头原来把标题和播放集名各占一行，看起来像 5 行；合并后整个页面只有 4 段。
    -->
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头：返回 + 标题 + 目标播放集（同一行的小字），右侧计数固定列宽。 -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>

            <Button x:Name="btnAddModsBack"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="OnBackClick"
                    ToolTipService.ToolTip="{x:Bind ViewModel.BackText, Mode=OneWay}"
                    AutomationProperties.AutomationId="btnAddModsBack"
                    AutomationProperties.Name="{x:Bind ViewModel.BackText, Mode=OneWay}">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>

            <!--
                标题与目标播放集同一行：播放集名用 caption 级小字紧跟在标题后面，
                不再单独占一行（原来那行让页头看起来像 5 行）。
                两列都用 Auto + MaxWidth：星号列会把这行小字推到计数旁边，
                看起来像另一个独立元素，和标题脱节。
            -->
            <Grid Grid.Column="1"
                  VerticalAlignment="Center"
                  ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock MaxWidth="520"
                           Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="txtAddModsTitle"
                           AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}" />

                <TextBlock Grid.Column="1"
                           MaxWidth="320"
                           VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.TargetText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="txtAddModsTarget"
                           AutomationProperties.Name="{x:Bind ViewModel.TargetText, Mode=OneWay}" />
            </Grid>

            <ProgressRing Grid.Column="2"
                          Width="16"
                          Height="16"
                          VerticalAlignment="Center"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          AutomationProperties.AutomationId="ringAddModsBusy"
                          AutomationProperties.Name="{x:Bind L.CommonLoading, Mode=OneWay}" />

            <!--
                计数列固定 96：数字位数变化（9 → 60 → 387）时不再把标题挤动，
                文案也收短到「共 N 个可添加」，保证在 96 里不被裁成半截。
            -->
            <TextBlock Grid.Column="3"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       Text="{x:Bind ViewModel.CandidateCountText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="txtAddModsCandidateCount"
                       AutomationProperties.Name="{x:Bind ViewModel.CandidateCountText, Mode=OneWay}" />
        </Grid>

        <!--
            搜索行：搜索框定宽 320，右侧跟排序下拉。
            排序框与搜索框同高（PdxDropDown 的 DropDownButton 是 32），不额外占行。
        -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="SearchBox"
                            Width="320"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            QueryIcon="Find"
                            PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.SearchText, Mode=OneTime}"
                            TextChanged="OnSearchTextChanged"
                            QuerySubmitted="OnSearchQuerySubmitted"
                            AutomationProperties.AutomationId="txtAddModsSearch"
                            AutomationProperties.Name="{x:Bind ViewModel.SearchName, Mode=OneWay}" />

            <controls:PdxDropDown Grid.Column="1"
                                  x:Name="SortBox"
                                  MinWidth="150"
                                  VerticalAlignment="Center"
                                  ItemsSource="{x:Bind ViewModel.SortModes, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSortMode, Mode=OneWay}"
                                  SelectionChanged="OnSortSelectionChanged"
                                  AutomationProperties.AutomationId="cmbAddModsSort"
                                  AutomationProperties.Name="{x:Bind ViewModel.SortName, Mode=OneWay}" />
        </Grid>

        <!-- 主体：候选列表 + 空状态 -->
        <Grid Grid.Row="2">
            <!-- 列表底衬：半透明玻璃面，压住整窗背景图保证行文字对比度 -->
            <Border Background="{ThemeResource PdxCardGlassBrush}" CornerRadius="8" />

            <ListView x:Name="CandidateList"
                      ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                      SelectionMode="None"
                      AutomationProperties.AutomationId="lstAddModsCandidates"
                      AutomationProperties.Name="{x:Bind ViewModel.ListName, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AddModRowViewModel">
                        <!--
                            列：勾选 24 / 缩略图 40 / 名称 + 徽标 * / 版本 96。
                            勾选框必须 MinWidth=0：WinUI 的 CheckBox 默认最小宽度 120 DIP，
                            不压下去会在行首留出 100 多 DIP 的空白（播放集页同一个坑已经踩过）。
                        -->
                        <Grid ColumnSpacing="8"
                              Padding="8,4"
                              MinHeight="56"
                              AutomationProperties.AutomationId="{x:Bind RowAutomationId, Mode=OneTime}"
                              AutomationProperties.Name="{x:Bind Name, Mode=OneTime}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>

                            <!-- 勾选框：勾中的 mod 会被加入播放集 -->
                            <CheckBox Grid.Column="0"
                                      MinWidth="0"
                                      Padding="0,0,8,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="{x:Bind CheckAutomationId, Mode=OneTime}"
                                      AutomationProperties.Name="{x:Bind Name, Mode=OneTime}" />

                            <!-- 缩略图：固定 40，行高 56 里居中 -->
                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Image Source="{x:Bind svc:XamlImage.FromPath(ThumbnailPath, 72), Mode=OneWay}"
                                       Stretch="Uniform" />
                            </Border>

                            <!-- 名称 + 徽标 + 副标题（大小 / 注册 id） -->
                            <Grid Grid.Column="2" VerticalAlignment="Center" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--
                                    名称与徽标用 Grid 而不是横向 StackPanel：名字过长时按 MaxWidth 截断，
                                    「订阅 / 本地」徽标始终紧跟其后、不会被顶出可视区。
                                    名字列取 Auto + MaxWidth（不用星号列）：这一行有 1300 多 DIP 宽，
                                    星号列会把徽标推到行尾，名字和徽标相隔近千像素，看起来像两个不相干的元素。
                                -->
                                <Grid Grid.Row="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock MaxWidth="520"
                                               Text="{x:Bind Name, Mode=OneTime}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}" />

                                    <!-- 来源徽标：本地 / 订阅，与 Mod 库页同一套画刷。 -->
                                    <Border Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Padding="8,4"
                                            CornerRadius="4"
                                            Background="{ThemeResource PdxOriginLocalBackgroundBrush}"
                                            Visibility="{x:Bind svc:XamlVisibility.FromBool(IsLocalOrigin), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind OriginText, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource PdxOriginLocalForegroundBrush}" />
                                    </Border>
                                    <Border Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Padding="8,4"
                                            CornerRadius="4"
                                            Background="{ThemeResource PdxOriginSubscribedBackgroundBrush}"
                                            Visibility="{x:Bind svc:XamlVisibility.FromBoolInverse(IsLocalOrigin), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind OriginText, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource PdxOriginSubscribedForegroundBrush}" />
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{x:Bind SubtitleText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <!--
                                版本列：第一行是 mod 作者版本，第二行是声明支持的游戏版本；
                                缺失给短横（支持版本）或不显示（mod 版本），偏低于当前游戏版本时加警告图标。
                            -->
                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <!-- 警告图标只在版本偏低时出现；Id 挂在始终存在的文字上，自动化不受可见性影响。 -->
                                <FontIcon Glyph="&#xE7BA;"
                                          FontSize="16"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          Visibility="{x:Bind svc:XamlVisibility.FromBool(HasVersionWarning), Mode=OneWay}"
                                          ToolTipService.ToolTip="{x:Bind VersionWarningText, Mode=OneWay}"
                                          AutomationProperties.Name="{x:Bind VersionWarningText, Mode=OneWay}" />
                                <StackPanel Orientation="Vertical"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ModVersionText, Mode=OneWay}"
                                               HorizontalAlignment="Right"
                                               TextAlignment="Right"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind ModVersionName, Mode=OneWay}"
                                               AutomationProperties.AutomationId="{x:Bind ModVersionAutomationId, Mode=OneTime}"
                                               AutomationProperties.Name="{x:Bind ModVersionName, Mode=OneWay}"
                                               Visibility="{x:Bind svc:XamlVisibility.FromBool(HasModVersion), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind RequiredVersionText, Mode=OneWay}"
                                               HorizontalAlignment="Right"
                                               TextAlignment="Right"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind RequiredVersionText, Mode=OneWay}"
                                               AutomationProperties.AutomationId="{x:Bind VersionAutomationId, Mode=OneTime}"
                                               AutomationProperties.Name="{x:Bind RequiredVersionText, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态：mod 库里没有可加的 mod -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowEmptyState), Mode=OneWay}">
                <FontIcon Glyph="&#xE8B7;"
                          FontSize="28"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="txtAddModsEmpty"
                           AutomationProperties.Name="{x:Bind ViewModel.EmptyText, Mode=OneWay}" />
            </StackPanel>

            <!-- 搜索无结果 -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind svc:XamlVisibility.FromBool(ViewModel.ShowNoMatch), Mode=OneWay}">
                <FontIcon Glyph="&#xE721;"
                          FontSize="24"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.NoMatchText, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="txtAddModsNoMatch"
                           AutomationProperties.Name="{x:Bind ViewModel.NoMatchText, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- 底栏：提示 + 已选计数 + 状态 + 按钮 -->
        <Border Grid.Row="3"
                Padding="12,8"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.HintText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive"
                               AutomationProperties.AutomationId="txtAddModsStatus"
                               AutomationProperties.Name="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.SelectedCountText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="txtAddModsSelectedCount"
                           AutomationProperties.Name="{x:Bind ViewModel.SelectedCountText, Mode=OneWay}" />

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        Content="{x:Bind L.CommonCancel, Mode=OneWay}"
                        Click="OnCancelClick"
                        ToolTipService.ToolTip="{x:Bind ViewModel.BackText, Mode=OneWay}"
                        AutomationProperties.AutomationId="btnAddModsCancel"
                        AutomationProperties.Name="{x:Bind L.CommonCancel, Mode=OneWay}" />

                <Button Grid.Column="3"
                        VerticalAlignment="Center"
                        Content="{x:Bind ViewModel.AddText, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                        Click="OnConfirmClick"
                        ToolTipService.ToolTip="{x:Bind ViewModel.AddText, Mode=OneWay}"
                        AutomationProperties.AutomationId="btnAddModsConfirm"
                        AutomationProperties.Name="{x:Bind ViewModel.AddText, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
