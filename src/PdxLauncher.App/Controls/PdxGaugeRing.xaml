<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PdxLauncher.App.Controls">

    <!--
        带值圆环仪表（性能概览的四个核心指标）。
        画布固定 120×120，外层 Viewbox 按控件尺寸等比缩放；弧线由 PdxGaugeRing 代码按补间后的值生成。
        三态描边取 WinUI 内置语义画笔，跟随 Light / Dark / HighContrast；
        GlowPath 与弧线同几何、更粗更淡，由 PulseOpacity 驱动短暂高亮；
        环下方一条 60 秒迷你趋势折线（带标注与浅底槽），值越高线越靠上。
        控件宽 132：四列在 1040 DIP 最小窗口宽下仍能排成一行；折成 3+1 会留下孤立的第四张卡。
    -->
    <Style TargetType="local:PdxGaugeRing">
        <Setter Property="Width" Value="132" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PdxGaugeRing">
                    <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="StatusStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="ArcPath.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Setter Target="GlowPath.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Setter Target="PercentText.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Setter Target="TrendPath.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Warning">
                                    <VisualState.Setters>
                                        <Setter Target="ArcPath.Stroke" Value="{ThemeResource SystemFillColorCautionBrush}" />
                                        <Setter Target="GlowPath.Stroke" Value="{ThemeResource SystemFillColorCautionBrush}" />
                                        <Setter Target="PercentText.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                                        <Setter Target="TrendPath.Stroke" Value="{ThemeResource SystemFillColorCautionBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Critical">
                                    <VisualState.Setters>
                                        <Setter Target="ArcPath.Stroke" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <Setter Target="GlowPath.Stroke" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <Setter Target="PercentText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <Setter Target="TrendPath.Stroke" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Viewbox Width="104" Height="104" Stretch="Uniform">
                            <Grid Width="120" Height="120">
                                <!-- 底环：整圈淡描边，表示「到达目标」。 -->
                                <Ellipse Width="104" Height="104"
                                         Stroke="{ThemeResource SubtleFillColorSecondaryBrush}"
                                         StrokeThickness="8" />
                                <!-- 高亮弧：与前景弧同几何、更粗，透明度由 PulseOpacity 动画驱动。 -->
                                <Path x:Name="GlowPath"
                                      StrokeThickness="12"
                                      StrokeLineJoin="Round"
                                      Opacity="{Binding PulseOpacity, RelativeSource={RelativeSource TemplatedParent}}" />
                                <!-- 前景弧：Path.Data 由代码按补间值生成，从正上方顺时针画出。 -->
                                <Path x:Name="ArcPath" StrokeThickness="8" />
                                <!-- 圆心读数：短数值 + 到达目标百分比，均不随弧线旋转。 -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                    <TextBlock Text="{TemplateBinding ValueText}"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               FontSize="18"
                                               TextAlignment="Center"
                                               TextWrapping="NoWrap"
                                               IsTextSelectionEnabled="False" />
                                    <TextBlock x:Name="PercentText"
                                               Text="{TemplateBinding DetailText}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextAlignment="Center"
                                               TextWrapping="NoWrap"
                                               IsTextSelectionEnabled="False" />
                                </StackPanel>
                            </Grid>
                        </Viewbox>

                        <!-- 60 秒迷你趋势线：放进与圆环等宽的槽里并配文字标注，避免被误读成页面边框。 -->
                        <StackPanel Width="120" Spacing="4" HorizontalAlignment="Center">
                            <Border Height="24"
                                    CornerRadius="4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Opacity="0.35">
                                <Viewbox Height="24" Stretch="Uniform">
                                    <Path x:Name="TrendPath" StrokeThickness="1.5" />
                                </Viewbox>
                            </Border>
                            <TextBlock Text="{TemplateBinding TrendCaption}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="NoWrap"
                                       IsTextSelectionEnabled="False" />
                        </StackPanel>

                        <TextBlock Text="{TemplateBinding Title}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="NoWrap"
                                   IsTextSelectionEnabled="False" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
