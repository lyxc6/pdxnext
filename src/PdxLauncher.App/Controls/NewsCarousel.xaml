<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PdxLauncher.App.Controls">

    <!--
        官方公告槽位的轮播控件（对齐 Paradox Launcher 2026.14 的 .newsSlot）。
        单卡时不渲染箭头与进度点；多卡时 2 秒自动切换，悬停显示左右箭头，底部显示进度段。
        尺寸由使用方传入（主页 main = 451x230、secondary = 246x230），控件只负责内容与状态。
    -->
    <Style TargetType="local:NewsCarousel">
        <Setter Property="Width" Value="451" />
        <Setter Property="Height" Value="230" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:NewsCarousel">
                    <Grid x:Name="Root"
                          Background="Transparent"
                          PointerEntered="OnRootPointerEntered"
                          PointerExited="OnRootPointerExited"
                          PointerMoved="OnRootPointerMoved">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button
                            x:Name="CardButton"
                            Grid.Row="0"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Click="OnCardClick">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                            </Button.Resources>
                            <Border
                                Background="{ThemeResource PdxCardGlassBrush}"
                                BorderBrush="#66000000"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Image
                                        x:Name="CardImage"
                                        Stretch="UniformToFill"
                                        Visibility="Collapsed" />
                                    <Border
                                        x:Name="TitleScrim"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Offset="0" Color="#00000000" />
                                                <GradientStop Offset="1" Color="#80000000" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock
                                        x:Name="CardTitle"
                                        Margin="28,0,28,24"
                                        VerticalAlignment="Bottom"
                                        FontSize="24"
                                        Foreground="White"
                                        MaxLines="3"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    <Border
                                        x:Name="HoverVeil"
                                        Background="#80131724"
                                        CornerRadius="4"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                    <Border
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button
                            x:Name="PreviousButton"
                            Grid.Row="0"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Rotation="180"
                            Visibility="Collapsed"
                            Click="OnPreviousClick">
                            <FontIcon Glyph="&#xE76C;" FontSize="16" />
                        </Button>
                        <Button
                            x:Name="NextButton"
                            Grid.Row="0"
                            Margin="0,0,12,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Visibility="Collapsed"
                            Click="OnNextClick">
                            <FontIcon Glyph="&#xE76C;" FontSize="16" />
                        </Button>

                        <StackPanel
                            x:Name="DotsPanel"
                            Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="4"
                            Margin="0,8,0,0"
                            Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
