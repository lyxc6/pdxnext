<UserControl
    x:Class="PdxLauncher.App.Controls.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource PdxCardBackgroundBrush}"
            BorderBrush="{ThemeResource PdxCardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            MinHeight="56"
            Padding="16,12">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind Header, Mode=OneWay}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind DescriptionVisibility, Mode=OneWay}" />
            </StackPanel>

            <ContentPresenter Grid.Column="1"
                              Content="{x:Bind ActionContent, Mode=OneWay}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right" />
        </Grid>
    </Border>
</UserControl>
