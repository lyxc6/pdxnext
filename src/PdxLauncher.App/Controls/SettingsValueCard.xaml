<UserControl
    x:Class="PdxLauncher.App.Controls.SettingsValueCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PdxLauncher.App.Controls">

    <controls:SettingsCard Header="{x:Bind Header, Mode=OneWay}"
                           Description="{x:Bind Description, Mode=OneWay}">
        <controls:SettingsCard.ActionContent>
            <TextBlock AutomationProperties.AutomationId="{x:Bind ValueAutomationId, Mode=OneWay}"
                       AutomationProperties.Name="{x:Bind ValueAutomationName, Mode=OneWay}"
                       Text="{x:Bind Value, Mode=OneWay}"
                       MaxWidth="{x:Bind MaxValueWidth, Mode=OneWay}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{x:Bind ToolTipText, Mode=OneWay}" />
        </controls:SettingsCard.ActionContent>
    </controls:SettingsCard>
</UserControl>
