<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PdxLauncher.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PdxLauncher.App.Controls">

    <!--
        外壳使用 WinUI 3 标准结构：系统标题栏 + NavigationView(Left) + Frame。
        不模仿官方 Paradox 启动器的悬浮左栏/自绘顶栏，主题、高对比度、缩放全部交给系统。

        整窗背景（方案 B）：最底下三层是「模糊铺底 / 背景图 / 遮罩」，横跨标题栏与内容两行；
        标题栏、导航栏、页面都浮在它们上面。因此下面的 NavigationView 必须透明、
        各页面也不能再画不透明底色（主页 Transparent，其余页用 PdxPageVeilBrush 纱）。
        背景图与模糊铺底都用 ImageBrush 画（Image 元素控制不了 UniformToFill 的裁剪锚点，
        而 ImageBrush 的 Stretch + AlignmentX/Y 正好复刻官方 CSS 的 background-size + background-position）。
    -->
    <Grid x:Name="RootGrid" Background="{ThemeResource PdxWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 整窗背景层：RowSpan=2 覆盖标题栏条与内容区，不参与命中测试，拖拽/点击照常落到上层。 -->
        <Grid
            x:Name="ShellBackgroundLayer"
            Grid.RowSpan="2"
            IsHitTestVisible="False">

            <!--
                模糊铺底：只在「完整（模糊底）」档显示。用的是同一张背景图的 96 像素宽解码结果，
                拉满整窗后天然柔化，用来填满主图两侧/上下的空白，避免露纯色硬边。
            -->
            <Rectangle
                x:Name="ShellBackgroundBlurRect"
                AutomationProperties.AutomationId="recShellBackgroundBlur"
                Opacity="0.85"
                Visibility="Collapsed">
                <Rectangle.Fill>
                    <ImageBrush
                        x:Name="ShellBackgroundBlurBrush"
                        AlignmentX="Center"
                        AlignmentY="Center"
                        Stretch="UniformToFill" />
                </Rectangle.Fill>
            </Rectangle>

            <!-- 主图：Stretch 与对齐由设置里的「背景显示方式」决定（见 ApplyBackgroundDisplayModeAsync）。 -->
            <Rectangle
                x:Name="ShellBackgroundRect"
                AutomationProperties.AutomationId="imgShellBackground">
                <Rectangle.Fill>
                    <ImageBrush
                        x:Name="ShellBackgroundBrush"
                        AlignmentX="Left"
                        AlignmentY="Center"
                        Stretch="UniformToFill" />
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!--
            遮罩：整窗渐变压暗背景图保证前景对比度；没有背景图时隐藏，窗口退回纯色底。
            顶部另加一条渐隐的标题栏压暗带，让标题/窗口按钮在任何亮色主题图上都读得清。
        -->
        <Grid
            x:Name="ShellScrim"
            Grid.RowSpan="2"
            AutomationProperties.AutomationId="grdShellScrim"
            Background="{ThemeResource PdxWindowScrimBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                AutomationProperties.AutomationId="grdShellTopScrim"
                Height="96"
                VerticalAlignment="Top"
                Background="{ThemeResource PdxTopScrimBrush}"
                IsHitTestVisible="False" />
        </Grid>

        <!--
            窗口置顶入口放在 TitleBar 的 RightHeader 槽位（模板第 9 列，紧挨系统最小化/最大化/关闭按钮）。
            右内边距列由 TitleBar 自己按 AppWindowTitleBar.RightInset 计算，DPI / 最大化 / RTL / 主题
            全部由框架自适应，这里不写任何像素级补偿。
            WinUI 3 没有 Window.Topmost，走 Windows App SDK 官方的 OverlappedPresenter.IsAlwaysOnTop
            （见 Services/AlwaysOnTopService.cs）。默认关；状态持久化到 settings.json。Ctrl+Shift+T 是等价快捷键。
        -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="{x:Bind L.AppName, Mode=OneWay}"
            AutomationProperties.AutomationId="barAppTitle">
            <!--
                RightHeader 一旦非空，TitleBar 就会切到 ExpandedHeight 视觉状态（默认 48 逻辑像素）。
                把该资源覆盖回 32，标题栏与系统 Standard 按钮等高，视觉改动最小。
            -->
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarExpandedHeight">32</x:Double>
                <!--
                    RightHeader 与系统按钮之间框架固定留 48 逻辑像素的拖动握把（TitleBarMinDragRegionWidth）。
                    标题文字与 Content 区本身仍然可拖动窗口，所以这里收敛到 8，让图钉真正贴着三个系统按钮。
                -->
                <x:Double x:Key="TitleBarMinDragRegionWidth">8</x:Double>
            </TitleBar.Resources>
            <TitleBar.RightHeader>
                <ToggleButton
                    x:Name="AlwaysOnTopButton"
                    Width="{ThemeResource TitleBarPaneToggleButtonWidth}"
                    Height="28"
                    Margin="2"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    AutomationProperties.AutomationId="btnAlwaysOnTop"
                    AutomationProperties.Name="{x:Bind L.ShellAlwaysOnTopEnable, Mode=OneWay}"
                    Click="OnAlwaysOnTopClick"
                    ToolTipService.ToolTip="{x:Bind L.ShellAlwaysOnTopEnableTooltip, Mode=OneWay}">
                    <!--
                        选中态：默认模板会铺 AccentFillColorDefault 一整块亮色，在深色标题栏里像一块白砖；
                        这里把指针态与选中态都换成中性 SubtleFill 淡底，让「已置顶」只体现为淡底 + 高亮图钉。
                    -->
                    <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SubtleFillColorSecondary}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SubtleFillColorTertiary}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                    </ToggleButton.Resources>
                    <FontIcon FontSize="16" Glyph="&#xE718;" />
                    <ToggleButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="T" Modifiers="Control,Shift" />
                    </ToggleButton.KeyboardAccelerators>
                </ToggleButton>
            </TitleBar.RightHeader>
            <!--
                翻译在途提示：翻译是几秒级的慢操作，标题栏全局可见、切页也不中断，
                所以把 ProgressRing + 文字放在这里，而不是每个页面各放一份。
                显隐由 MainWindow.xaml.cs 控制（150ms 显示去抖 / 400ms 隐藏去抖），
                计数来自 TranslationCoordinator.Activity，切页不会漏掉在途批次。
            -->
            <TitleBar.Content>
                <StackPanel
                    x:Name="TranslationIndicator"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <ProgressRing
                        x:Name="ringTranslating"
                        Width="14"
                        Height="14"
                        IsActive="False"
                        AutomationProperties.AutomationId="ringTranslating" />
                    <TextBlock
                        Text="{x:Bind L.ShellTranslating, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        AutomationProperties.AutomationId="txtTranslating"
                        AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="MainNavigation"
            Grid.Row="1"
            AutomationProperties.AutomationId="navMain"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            ItemInvoked="OnNavigationItemInvoked"
            OpenPaneLength="216"
            PaneDisplayMode="Left">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    AutomationProperties.AutomationId="navHome"
                    Content="{x:Bind L.ShellNavHome, Mode=OneWay}"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavPlaySets"
                    AutomationProperties.AutomationId="navPlaySets"
                    Content="{x:Bind L.ShellNavPlaySets, Mode=OneWay}"
                    Tag="playsets">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavModLibrary"
                    AutomationProperties.AutomationId="navModLibrary"
                    Content="{x:Bind L.ShellNavModLibrary, Mode=OneWay}"
                    Tag="modlibrary">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AllApps" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavModStudio"
                    AutomationProperties.AutomationId="navModStudio"
                    Content="{x:Bind L.ShellNavModStudio, Mode=OneWay}"
                    Tag="modstudio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavWorkshop"
                    AutomationProperties.AutomationId="navWorkshop"
                    Content="{x:Bind L.ShellNavWorkshop, Mode=OneWay}"
                    Tag="workshop">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Globe" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavDlc"
                    AutomationProperties.AutomationId="navDlc"
                    Content="DLC"
                    Tag="dlc">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Shop" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.AutomationId="navLibrary"
                    Content="{x:Bind L.ShellNavLibrary, Mode=OneWay}"
                    Tag="library">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    AutomationProperties.AutomationId="navAccount"
                    Content="{x:Bind L.ShellNavAccount, Mode=OneWay}"
                    Tag="account">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.AutomationId="navSettings"
                    Content="{x:Bind L.ShellNavSettings, Mode=OneWay}"
                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!--
                仅启动 / 未适配的游戏下，内容管理三项（播放集 / Mod 库 / DLC）直接隐藏：
                这类游戏的内容由游戏本体管理，留着置灰的入口只会让人以为坏了，
                左栏底部那行解释文字也一并去掉（窄列里折行很难看）。
            -->

            <NavigationView.Content>
                <Frame x:Name="ContentFrame" AutomationProperties.AutomationId="frameContent" />
            </NavigationView.Content>
        </NavigationView>

        <!--
            全局确认浮层：跨页面覆盖（RowSpan=2 连标题栏一起盖住），
            所有「确认 / 取消」对话框都走它，好让「取消」在左、「确认」在右。
        -->
        <controls:ConfirmOverlay
            x:Name="ConfirmOverlayLayer"
            Grid.RowSpan="2" />
    </Grid>
</Window>
