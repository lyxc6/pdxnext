<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PdxLauncher.Core</RootNamespace>
    <AssemblyName>PdxLauncher.Core</AssemblyName>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    本地翻译引擎依赖：
    BergamotTranslatorSharp 提供 Firefox 同款 NMT 的托管封装 + bergamot.dll；
    LLamaSharp 提供进程内 GGUF 推理（Index-Translate-2B），原生库在 Backend.Cpu 包里。
    两个包都已在离线 NuGet 缓存中，NuGet.config 是全离线源，不会去联网。
  -->
  <!--
    自检工程要钉住原生结果结构体的封送尺寸（Marshal.SizeOf == 416 / 9760，见
    SteamWorkshopHostOperation.OwnEnumerateResultSize / OwnDetailResultSize），
    那两个结构体是 internal，所以只对这个测试程序集开放。
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="PdxLauncher.Checks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BergamotTranslatorSharp" Version="0.7.0" />
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
  </ItemGroup>

  <!--
    补丁素材（DLC 解锁 loader + cream_api.ini 模板）内嵌进 PdxLauncher.Core.dll，
    发布时整个目录拷走即可用，不依赖外部文件。LogicalName 必须与
    Patch/PatchAssets.cs 里的常量、tools/manual-build.py 的 -resource: 参数一致。
  -->
  <ItemGroup>
    <EmbeddedResource Include="Patch\Assets\steam_api.dll">
      <LogicalName>PdxLauncher.Patch.steam_api.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Patch\Assets\steam_api64.dll">
      <LogicalName>PdxLauncher.Patch.steam_api64.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Patch\Assets\cream_api.ini">
      <LogicalName>PdxLauncher.Patch.cream_api.ini</LogicalName>
    </EmbeddedResource>
    <!-- 按游戏分节的 DLC 源清单：运行时渲染成 ini 的单一 [dlc] 段。 -->
    <EmbeddedResource Include="Patch\Assets\dlc-catalog.json">
      <LogicalName>PdxLauncher.Patch.dlc-catalog.json</LogicalName>
    </EmbeddedResource>
    <!-- 已知原版 steam_api 的哈希 + buildid 登记表：打补丁前做版本校验。 -->
    <EmbeddedResource Include="Patch\Assets\known-versions.json">
      <LogicalName>PdxLauncher.Patch.known-versions.json</LogicalName>
    </EmbeddedResource>
    <!-- 新建 mod 的默认封面；LogicalName 必须与 ModStudio/ModCoverAssets.cs 里的常量一致。 -->
    <EmbeddedResource Include="ModStudio\Assets\default-cover.png">
      <LogicalName>PdxLauncher.ModStudio.default-cover.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
