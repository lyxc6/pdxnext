# 构建产物
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# 发布 / 打包产物
dist/
publish/

# 本地临时目录、手工备份与 UI 测试产物
.scratch/
.tmp/
.backup/
backup*/
ui-test-artifacts/
artifacts/

# 运行时数据（默认在 exe 目录下的 data/，通常已被 bin/ 覆盖，这里再兜底）
data/
**/data/logs/
**/data/theme-cache/
**/data/news-cache/
**/data/mod-cache/

# 探针文件、GPU 日志、测试输出
.probe-*
.probe-root/
NVIDIA Corporation/
*.log
*.trx
*.coverage
TestResults/

# 工具缓存
__pycache__/
*.pyc

# Valve 的可再发行组件与本地 Steamworks SDK：本启动器不随包分发它们的二进制。
# 用户自己下载的 sdk/ 与运行期生成的 steam_appid.txt 都不进仓。
sdk/
steam_api64.dll
steam_appid.txt

# 编辑器（.vscode 只放行任务面板与工程设置，其余本机配置照旧忽略）
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

# agent 工作区（含链接 worktree，动辄数百 MB；不能靠 .agents/worktrees/.gitignore 挡，
# 那是本机产物、不会进仓）
.agents/

# 临时核对目录与备份文件
*.tmpverify/
*.tmp
*.orig
*.rej
