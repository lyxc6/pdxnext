<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PdxLauncher.Checks</RootNamespace>
    <AssemblyName>PdxLauncher.Checks</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PdxLauncher.Core\PdxLauncher.Core.csproj" />
    <ProjectReference Include="..\..\src\PdxLauncher.Imaging\PdxLauncher.Imaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      链接 App 层的 PlaySetEditor 源码进来做自检。该文件通篇只用 Core 的类型
      （IPlaySetRepository / ILoadFileWriter / IAppLogger / GameInstallation / DlcCatalog 全在 Core），
      不引用任何 XAML/UI 类型，因此在 net10.0 的检查工程里可原样编译。
      用「链接源码」而不是「引用 PdxLauncher.App」：App 是 WinExe + windows TFM，检查工程引用不了。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\PlaySetEditor.cs" Link="Linked\PlaySetEditor.cs" />
    <!--
      位次输入的解析（含「超过总数＝置底」的钳位）也在 App/Services，只依赖 System.Globalization，
      同样可以原样链接进来。之所以要把解析抽成独立类而不是留在 ModsViewModel 里：
      视图模型在 App（WinExe + windows TFM），检查工程引用不到，逻辑就测不到。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\PositionInput.cs" Link="Linked\PositionInput.cs" />
    <!--
      播放集存储格式路由：官方若把某个 sqlite 游戏迁到 JSON 存储（launcher-v2.sqlite 消失），这里的兜底
      决定播放集页是「还能读出来」还是「静默空白」。它只依赖 Core 的 IPlaySetRepository / IFileSystem /
      IAppLogger 与各仓储的路径常量，因此可以原样链接进来，由 PlaySetGuardChecks 用临时目录钉住各落点。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\PlaySetRepositoryRouter.cs" Link="Linked\PlaySetRepositoryRouter.cs" />
    <!--
      工坊详情的正文清洗（BBCode/HTML/Markdown 剥离、片段拼接、时间格式化）同样只依赖 System.*，
      可以原样链接进来。它决定详情子页上长描述长什么样：漏剥一个标记，界面上就直接露出来，
      所以口径要由 WorkshopTextChecks 钉住。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\WorkshopText.cs" Link="Linked\WorkshopText.cs" />
    <Compile Include="..\..\src\PdxLauncher.App\Services\WorkshopGalleryLayout.cs" Link="Linked\WorkshopGalleryLayout.cs" />
    <!--
      工坊图片落地规则（封面/截图的文件名、以及「同一张图只存一份」的复用判定）同样不碰 UI 类型，
      只用 Core 的 IFileSystem / IAssetDownloader / WorkshopInfoCache，可以原样链接进来。
      它决定磁盘上会不会多出同一张图的第二份，只能靠 WorkshopImageCacheChecks 钉住。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\WorkshopImageCache.cs" Link="Linked\WorkshopImageCache.cs" />
    <!--
      封面目录配额（100 MB 上限、按最后写入时间删最旧）。只依赖 IFileSystem / IAppLogger / IClock，
      可以原样链接进来；WorkshopImageCache 现在依赖它，所以必须一起链接。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\CoverDiskQuota.cs" Link="Linked\CoverDiskQuota.cs" />
    <!--
      会话状态机（登录 / 续期 / 登出 / 落盘时机）本身不碰任何 UI 类型，
      只用 Core 的 IAppLogger / PdxSessionStore / IClock / PdxAccountClient，
      所以可以原样链接进来。它的「不勾保持登录就不落盘」和「登出清内存」是文案承诺，
      漏了不会崩、只会让用户以为登录状态记不住，必须由 AccountChecks 钉住。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\AccountService.cs" Link="Linked\AccountService.cs" />
    <!--
      登录表单的可编辑/可提交判定。它存在的唯一理由就是修「邮箱框自己禁用自己」的死锁，
      而这个死锁在真机上表现为「点了登录没反应」，编译器与人工点测都容易漏，
      所以判定逻辑必须留在能被自检链接的纯 C# 里。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\AccountFormState.cs" Link="Linked\AccountFormState.cs" />
    <!--
      错误码归类。曾经漏判过一次：客户端发 pdx-login-unauthorized，归类只认 pdx-unauthorized，
      于是「密码错」被当成未知错误，界面把原始码直接显示给用户看。
      这种错不会崩，只在真机上表现为「登录坏了」，所以口径要能被 AccountChecks 钉住。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\AccountErrorText.cs" Link="Linked\AccountErrorText.cs" />
    <!--
      账号页身份卡的取值规则（首字母 / 名字 / 显示名是否就是邮箱）。它只依赖 System.*，
      可以原样链接进来。规则错了不会崩，只会在真机上表现为「头像上是个 1」「状态行把同一个
      邮箱写两遍」「已登录却写着未登录」，编译器看不见，所以必须由 AccountDisplayTextChecks 钉住。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\AccountDisplayText.cs" Link="Linked\AccountDisplayText.cs" />
    <!--
      翻译在途计数器（标题栏「正在翻译…」的唯一数据源）。它只依赖 System.Threading，不碰 UI 类型，
      可以原样链接进来。计数漏减，界面会永远显示「正在翻译」；重复减，提示会提前消失——
      两种都不会崩，只在真机上表现为「提示一直转」或「看不见提示」，所以由 TranslationActivityChecks 钉住。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\TranslationActivityMonitor.cs" Link="Linked\TranslationActivityMonitor.cs" />
    <!--
      自动排序服务（扫描 mod 实际文件足迹 → 分层分类 → 冲突图 → Kahn 排序 → 预览）。
      只用 Core 的 IFileSystem / IAppLogger / GameInstallation / Core.Mods.Sorting，
      不碰任何 UI 类型，可以原样链接进来，由 PlaySetAutoSortServiceChecks
      用临时目录 + 临时 launcher-v2.sqlite 钉住边映射与降级口径。
    -->
    <Compile Include="..\\..\\src\\PdxLauncher.App\\Services\\PlaySetAutoSortService.cs" Link="Linked\\PlaySetAutoSortService.cs" />
    <!--
      自动排序预览产物（足迹/边/冲突/结果/重排行）是纯不可变 record，
      随服务一起链接，供预览对话框与自检共用同一套字段口径。
    -->
    <Compile Include="..\\..\\src\\PdxLauncher.App\\Services\\AutoSortPreview.cs" Link="Linked\\AutoSortPreview.cs" />
    <!--
      自动排序差异模型（预览结果 → 「谁移到哪 + 理由」的排版行）。纯不可变 record + 纯映射，
      只依赖 Core 的 record 类型，不碰 UI，可以原样链接进来。行序、Moved 标记或理由映射错了
      不会崩，只在预览对话框里给出错误的排序理由，编译器看不见，所以由 AutoSortDiffChecks 钉住。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\AutoSortDiff.cs" Link="Linked\AutoSortDiff.cs" />
    <!--
      图片按显示尺寸解码：目标宽度换算（纯算术）与文件头宽度解析（只碰 System.Buffers / System.IO）。
      两块都不引用 UI 类型，可以原样链接进来。它们错了不会崩，只会在真机上表现为「图糊了」
      或「内存没降下来」，编译器看不见，所以由 ImageDecodeSizeChecks 钉住口径。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\ImageDecodeSize.cs" Link="Linked\ImageDecodeSize.cs" />
    <Compile Include="..\..\src\PdxLauncher.App\Services\ImagePixelSize.cs" Link="Linked\ImagePixelSize.cs" />

    <!--
      页面状态快照：只有 record 与静态字段，不碰 UI 类型，可以直接链接。
      它错了的表现是「回到页面筛选/滚动丢了」，编译器和真机都不容易发现，所以由 PageStateChecks 钉住字段与默认值。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\ModLibraryState.cs" Link="Linked\ModLibraryState.cs" />
    <Compile Include="..\..\src\PdxLauncher.App\Services\ModStudioDraft.cs" Link="Linked\ModStudioDraft.cs" />
    <Compile Include="..\..\src\PdxLauncher.App\Services\ModStudioState.cs" Link="Linked\ModStudioState.cs" />
    <Compile Include="..\..\src\PdxLauncher.App\Services\PageStateStore.cs" Link="Linked\PageStateStore.cs" />
    <!--
      Debug 内存埋点：只依赖 Core 的 IAppLogger，缓存计数由调用点通过委托传入，
      不碰 WinUI / AppServices，因此可以原样链接进来。它错了不会崩，只会让基线文档的读数不可信，
      所以描述格式（MB 一位小数、缓存计数拼法）与「Capture 永不抛」由 MemoryDiagnosticsChecks 钉住。
    -->
    <Compile Include="..\..\src\PdxLauncher.App\Services\MemoryDiagnostics.cs" Link="Linked\MemoryDiagnostics.cs" />
  </ItemGroup>
</Project>
